#!/bin/bash
# ccsplit: a drop-in C compiler for the AOT pipelines. `ccsplit [flags] -c UNIT.c -o OUT.o` where UNIT.c is a unit generated by qjsaot
# (and large) is cut into parts by unit-build.py, compiled in parallel with a content-keyed object cache, and joined into OUT.o with `ld -r`;
# any other invocation (the engine, hand-written C, linking, -flto, -fsyntax-only) goes straight to the real compiler. Same flags either way.
#   CCSPLIT_CC     real compiler (default clang)      CCSPLIT_OFF=1   always pass through
#   CCSPLIT_JOBS   parallel parts (default min(nproc, available GB / 2.5))    CCSPLIT_CACHE   object cache (default $TMPDIR-free: <repo>/.local/cache/ccsplit)
#   CCSPLIT_MIN    smallest unit split, lines (default 4000)
real=${CCSPLIT_CC:-clang}
# Memory safety: every compile started through this script runs in the user slice qjsbuild.slice, whose memory limit
# (systemctl --user set-property qjsbuild.slice MemoryMax=...) is shared by all builds on the machine, and is the kernel's
# first choice under memory pressure. A build that outgrows the limit fails; the sessions that started it survive.
# CCSPLIT_NOSLICE=1 turns the slice off.
if [ -z "$CCSPLIT_IN_SLICE" ] && [ -z "$CCSPLIT_NOSLICE" ] && command -v systemd-run >/dev/null 2>&1 &&
   systemctl --user show qjsbuild.slice -p MemoryMax 2>/dev/null | grep -qv infinity; then
  export CCSPLIT_IN_SLICE=1
  exec systemd-run --user --scope --quiet --collect --slice=qjsbuild.slice -- "$0" "$@"
fi
echo 1000 > /proc/self/oom_score_adj 2>/dev/null
here=$(cd "$(dirname "$0")" && pwd)
[ -n "$CCSPLIT_OFF" ] && exec $real "$@"
src= out= flags=() c=0 pass=0
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  a=${args[i]}
  case $a in
    -c) c=1 ;;
    -o) out=${args[++i]} ;;
    -fprofile-instr-generate*) if [ -n "${CCSPLIT_PGO:-}" ]; then flags+=("$a"); else pass=1; flags+=("$a"); fi ;; # CCSPLIT_PGO=1: an instrumented unit is split like any other, so its function names match the profile-guided build's
    -flto|-flto=*|-fsyntax-only|-E|-S|-fprofile-use*) pass=1; flags+=("$a") ;;
    *.c) src=$a ;;
    *) flags+=("$a") ;;
  esac
done
# The regexp matchers of a unit (UNIT-rx.c, written by qjsaot beside UNIT.c) are a second source compiled with the same flags and joined to the
# unit's object: the unit is built as it always is (CCSPLIT_NO_RX=1 for the nested call) and `ld -r` puts the two together.
if [ $c = 1 ] && [ -n "$src" ] && [ -n "$out" ] && [ -z "${CCSPLIT_NO_RX:-}" ] && [ -f "${src%.c}-rx.c" ] && head -1 "$src" | grep -q "Generated by qjsaot"; then
  rxo="$out.rx.o"
  $real "${flags[@]}" -I"$(dirname "$src")" -c "${src%.c}-rx.c" -o "$rxo" || exit 1
  nargs=(); for ((i = 0; i < ${#args[@]}; i++)); do if [ "${args[i]}" = "-o" ]; then nargs+=(-o "$out.unit.o"); i=$((i + 1)); else nargs+=("${args[i]}"); fi; done
  CCSPLIT_NO_RX=1 CCSPLIT_IN_SLICE=1 "$0" "${nargs[@]}" || exit 1
  ld -r -o "$out" "$out.unit.o" "$rxo" || exit 1
  rm -f "$out.unit.o" "$rxo"
  exit 0
fi
if [ $pass = 1 ] || [ $c = 0 ] || [ -z "$src" ] || [ -z "$out" ] || [ ! -f "$src" ] || ! head -1 "$src" | grep -q "Generated by qjsaot" || [ "$(wc -l < "$src")" -lt "${CCSPLIT_MIN:-4000}" ]; then
  exec $real "$@"
fi
cache=${CCSPLIT_CACHE:-$here/../../.local/cache/ccsplit}
# CCSPLIT_WORKDIR=<name>: the parts go in a fixed directory (so the file names a profile-guided build records match between two builds).
if [ -n "${CCSPLIT_WORKDIR:-}" ]; then rm -rf "$CCSPLIT_WORKDIR"; mkdir -p "$CCSPLIT_WORKDIR" && work=$CCSPLIT_WORKDIR || exec $real "$@"
else work=$(mktemp -d "${out}.split.XXXXXX") || exec $real "$@"; fi
trap 'rm -rf "$work"' EXIT
mkdir -p "$cache"
# One clang on a large part can take close to 2 GB, so the default job count is bounded by available memory as well as by cores.
jobs=${CCSPLIT_JOBS:-}
if [ -z "$jobs" ]; then
  jobs=$(nproc)
  mem=$(awk '/MemAvailable/ {print int($2 / 2500000)}' /proc/meminfo 2>/dev/null)
  [ -n "$mem" ] && [ "$mem" -lt "$jobs" ] && jobs=$mem
  # The build slice's memory limit bounds it too (about 3 GB per part on the largest units, e.g. deltablue).
  slice=$(systemctl --user show qjsbuild.slice -p MemoryMax --value 2>/dev/null)
  case "$slice" in ''|*[!0-9]*) ;; *) smax=$((slice / 3000000000)); [ "$smax" -lt "$jobs" ] && jobs=$smax ;; esac
  [ "$jobs" -lt 1 ] && jobs=1
fi
# Tiered optimisation: CCSPLIT_REPORT=<generator report> CCSPLIT_COLD="-O1" compiles the parts that hold no function with a profile share of at
# least CCSPLIT_HOT_MIN percent (default 0.5) with the cold flag instead of the -O level given on the command line.
tier=()
if [ -n "$CCSPLIT_REPORT" ] && [ -n "$CCSPLIT_COLD" ] && [ -f "$CCSPLIT_REPORT" ]; then
  coldflags=(); for f in "${flags[@]}"; do case $f in -O?|-Os|-Oz) ;; *) coldflags+=("$f") ;; esac; done
  tier=(--hot-cc "$real ${flags[*]} -I$(dirname "$src")" --report "$CCSPLIT_REPORT" --hot-min "${CCSPLIT_HOT_MIN:-0.5}")
  cccold="$real ${coldflags[*]} $CCSPLIT_COLD -I$(dirname "$src")"
else
  cccold="$real ${flags[*]} -I$(dirname "$src")"
fi
python3 "$here/unit-build.py" "$src" --out "$work" --cc "$cccold" "${tier[@]}" --jobs "$jobs" --cache "$cache" > "$work/split.log" 2>&1 || { cat "$work/split.log" >&2; exit 1; }
ld -r -o "$out" $(cat "$work/objs.txt") || exit 1
