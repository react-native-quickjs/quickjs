# AOT Layer A template -> interpreter handler manifest.
#
# Each line: <templated ROP> <handler label in engine/quickjs-ng/quickjs.c>
# tools/aot/template-sync.sh extracts the handler body text and records its
# hash in template-sync.hashes. A change to a handler fails the check so the
# template that mirrors it is re-reviewed (plan P4 §6.4).
get_local        L_ROP_get_local
get_local_s0     L_ROP_get_local_s0
get_local_s1     L_ROP_get_local_s1
get_local_s2     L_ROP_get_local_s2
get_local_s3     L_ROP_get_local_s3
add              L_ROP_add
sub              L_ROP_sub
mul              L_ROP_mul
get_field        L_ROP_get_field
get_field_own    L_ROP_get_field
