{
  "name": "@react-native-quickjs/text-encoding",
  "version": "1.0.0",
  "description": "Native TextEncoder and TextDecoder for react-native-quickjs",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "build": "cmake -S ../.. -B ../../build -DCMAKE_BUILD_TYPE=Debug && cmake --build ../../build --target text_encoding_tests -j8",
    "test": "npm run build && ctest --test-dir ../../build -R text_encoding --output-on-failure",
    "bench:build": "cmake -S ../.. -B ../../build-rel -DCMAKE_BUILD_TYPE=Release && cmake --build ../../build-rel --target text_encoding_bench -j8",
    "bench": "npm run bench:build && ../../build-rel/modules/text-encoding/text_encoding_bench"
  },
  "files": [
    "src",
    "cpp",
    "ios",
    "android",
    "CMakeLists.txt",
    "*.podspec",
    "!**/build",
    "!**/.cxx"
  ],
  "keywords": [
    "react-native",
    "quickjs",
    "jsi",
    "text-encoding"
  ],
  "author": "Ammar Ahmed",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "@react-native-quickjs/quickjs": "*"
  },
  "reactNativeQuickJSModule": {
    "install": "textEncoding_install",
    "header": "cpp/TextEncodingModule.h"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-native-quickjs/quickjs.git",
    "directory": "modules/text-encoding"
  }
}
