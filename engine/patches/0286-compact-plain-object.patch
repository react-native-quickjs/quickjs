Subject: Lay out a plain object's inline properties over its unused union

What this does
  A JS_CLASS_OBJECT object never uses JSObject's 24-byte class union. Such an
  object is now allocated only up to that union, and its inline property slots
  start where the union would be. Every other class keeps the full layout.
  Creation and the free path no longer write the union of a plain object,
  since its block may end there, and JS_GetAnyOpaque() returns NULL for one.

Why we need it
  A plain object with four inline properties took a 144-byte block; it now
  takes 120, and its first property sits 48 bytes into the body, in the same
  cache line as its shape. On the fixed-work Octane rows this removes 15% of
  the simulated L1 data misses on deltablue, 12% on earley-boyer, 9% on
  raytrace and 7% on splay.

What it adds
  js_object_body_size() - the body size of an object of a given class.

Needs a bytecode version bump
  No.

diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -8655,6 +8655,12 @@
 }
 
 #define JS_OBJ_INLINE_PROPS 4
+
+static inline size_t js_object_body_size(JSClassID class_id)
+{
+    return class_id == JS_CLASS_OBJECT ? offsetof(JSObject, u)
+                                       : sizeof(JSObject);
+}
 #define JS_ARRAY_INLINE_MAX 16
 /* Upper bound for the per-constructor learned inline capacity: how many own
    properties a learned object keeps inline before it grows a separate
@@ -8719,7 +8725,7 @@
                 req_cap = JS_OBJ_LEARNED_INLINE_MAX;
             inline_cap = req_cap;
         }
-        p = js_malloc(ctx, sizeof(JSObject) +
+        p = js_malloc(ctx, js_object_body_size(class_id) +
                            inline_cap * sizeof(JSProperty) +
                            extra_values * sizeof(JSValue));
         if (unlikely(!p))
@@ -8740,10 +8746,11 @@
     p->gv_watched = 0;
     p->is_prototype = 0;
     p->first_weak_ref = NULL;
-    p->u.opaque = NULL;
+    if (class_id != JS_CLASS_OBJECT)
+        p->u.opaque = NULL;
     p->shape = sh;
     if (p->prop_inline_cap != 0)
-        p->prop = (JSProperty *)(p + 1);
+        p->prop = (JSProperty *)((uint8_t *)p + js_object_body_size(class_id));
     else
         p->prop = js_malloc(ctx, sizeof(JSProperty) * sh->prop_size);
     if (unlikely(!p->prop)) {
@@ -9821,10 +9828,12 @@
         (*finalizer)(rt, JS_MKPTR(JS_TAG_OBJECT, p));
 
     /* fail safe */
+    if (p->class_id != JS_CLASS_OBJECT) {
+        p->u.opaque = NULL;
+        p->u.func.var_refs = NULL;
+        p->u.func.home_object = NULL;
+    }
     p->class_id = 0;
-    p->u.opaque = NULL;
-    p->u.func.var_refs = NULL;
-    p->u.func.home_object = NULL;
 
     remove_gc_object(&p->header);
     if (rt->gc_phase == JS_GC_PHASE_REMOVE_CYCLES && JS_REF_COUNT(p) != 0) {
@@ -16051,6 +16060,8 @@
     }
     p = JS_VALUE_GET_OBJ(obj);
     *class_id = p->class_id;
+    if (p->class_id == JS_CLASS_OBJECT)
+        return NULL;
     return p->u.opaque;
 }
 
