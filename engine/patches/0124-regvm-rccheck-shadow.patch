+
+static void regvm_rcc_fail(JSRegRun *f, JSRegRCCRec *r, const char *what, int reg,
+                           long want, long got)
+{
+    long off = f->rcc_ip ? (long)(f->rcc_ip - f->b->regvm_code) : -1;
+    (void)r;
+    fprintf(stderr, "##RCCHECK## %s reg=%d want=%ld got=%ld off=%ld\n",
+            what, reg, want, got, off);
+    fflush(stderr);
+    abort();
+}
+
+static void regvm_rcc_check(JSRegRun *f, const uint8_t *ip)
+{
+    JSRegRCC *rcc = f->rcc;
+    JSRegRCCRec *r;
+    long off;
+    int lo, hi, idx = -1, i;
+
+    if (!rcc || !rcc->recs)
+        return;
+    off = (long)(ip - f->b->regvm_code);
+    lo = 0;
+    hi = rcc->n_recs - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) >> 1;
+        if ((long)rcc->recs[mid].off == off) { idx = mid; break; }
+        if ((long)rcc->recs[mid].off < off) lo = mid + 1;
+        else hi = mid - 1;
+    }
+    if (idx < 0)
+        return;                 /* a stub, or bytecode with no side table */
+    r = &rcc->recs[idx];
+    f->rcc_ip = ip;             /* the failing instruction, for regvm_rcc_fail */
+    if (!f->rcc_shadow) {
+        f->rcc_shadow = js_malloc(f->ctx,
+                                  (size_t)rcc->reg_count * sizeof(int32_t));
+        if (!f->rcc_shadow) { f->rcc = NULL; return; }
+        for (i = 0; i < rcc->reg_count; i++)
+            f->rcc_shadow[i] = -1;
+    }
+    /* Apply the previous instruction's store: the shadow must reflect the state
+       before this instruction, which is exactly the state after the last one. */
+    if (f->rcc_prev >= 0) {
+        JSRegRCCRec *pv = &rcc->recs[f->rcc_prev];
+        if (pv->dst_reg >= 0)
+            f->rcc_shadow[pv->dst_reg] = pv->dst_vid;
+        if (pv->dst2_reg >= 0)
+            f->rcc_shadow[pv->dst2_reg] = pv->dst2_vid;
+    }
+    /*
+     * A suspend re-dispatches its own instruction on resume: the await/yield
+     * reads and clears its operand on the first pass, and the resume delivers
+     * the result into the destination. The same index twice therefore means the
+     * frame was resumed, so the operands the first pass consumed are gone; forget
+     * them and keep the destination the previous-store step just learned.
+     */
+    if (idx == f->rcc_prev) {
+        for (i = 0; i < r->n_src; i++) {
+            int reg = r->src[i].reg;
+            if (reg >= 0 && reg < rcc->reg_count && reg != r->dst_reg &&
+                reg != r->dst2_reg)
+                f->rcc_shadow[reg] = -1;
+        }
+        return;
+    }
+    for (i = 0; i < r->n_src; i++) {
+        int reg = r->src[i].reg;
+        if (reg < 0 || reg >= rcc->reg_count)
+            continue;
+        /*
+         * A coalesced phi is the one value a read may find under a different id:
+         * the allocator gave the phi and its incoming value the same register and
+         * dropped the edge copy, so the register still holds the incoming value's
+         * id when the phi is read. The content is the phi's by construction.
+         */
+        if (r->src[i].phi)
+            continue;
+        if (f->rcc_shadow[reg] == -1) {
+            /* A generator or async resume restores the register file without
+               running its definitions, so the shadow has no history for the
+               register; the encoder already proved the read defined. Learn the
+               id on the first read. */
+            f->rcc_shadow[reg] = r->src[i].vid;
+            continue;
+        }
+        if (f->rcc_shadow[reg] != r->src[i].vid)
+            regvm_rcc_fail(f, r, "read", reg, r->src[i].vid,
+                           f->rcc_shadow[reg]);
+    }
+    if (r->plain && r->dst_reg >= 0 && JS_VALUE_HAS_REF_COUNT(f->fr[r->dst_reg]))
+        regvm_rcc_fail(f, r, "plain", r->dst_reg, 0, 1);
+    if (r->plain && r->dst2_reg >= 0 &&
+        JS_VALUE_HAS_REF_COUNT(f->fr[r->dst2_reg]))
+        regvm_rcc_fail(f, r, "plain", r->dst2_reg, 0, 1);
+    if (r->rel >= 0) {
+        const uint8_t *rs = rcc->rels + (size_t)r->rel * rcc->rel_bytes;
+        for (i = 0; i < rcc->rel_bytes; i++) {
+            if (!rs[i] && JS_VALUE_HAS_REF_COUNT(f->fr[i]))
+                regvm_rcc_fail(f, r, "return", i, 0, 1);
+        }
+    }
+    f->rcc_prev = idx;
+    f->rcc_ip = ip;
+}
