+#ifdef QJS_REGVM_RCCHECK
+/*
+ * Section 6.2, the value-id shadow checker.
+ *
+ * The section 6.1 analysis proves which registers may hold a count and where a
+ * plain store is safe; this is the runtime belt to that analysis' braces. The
+ * encoder emits one record per instruction -- its code offset, the value id its
+ * destination takes, the value ids its register operands must still hold, its
+ * plain-store claim and its return release set. The frame keeps one shadow
+ * value id per register. At each dispatch the previous instruction's store is
+ * applied to the shadow and the current instruction's reads are checked against
+ * it, so a register that holds the wrong value, a plain store onto a counted
+ * value, or a count outside a return's release set aborts with a report.
+ */
+typedef struct JSRegRCCOp {
+    int32_t reg;
+    int32_t vid;
+    uint8_t phi;            /* a coalesced phi: no instruction defines it */
+} JSRegRCCOp;
+
+typedef struct JSRegRCCRec {
+    uint32_t off;           /* code offset of the opcode byte */
+    int32_t dst_reg;        /* -1 when the instruction has no register result */
+    int32_t dst_vid;
+    int32_t dst2_reg;       /* the second result of a yield/with ref form, or -1 */
+    int32_t dst2_vid;
+    int32_t rel;            /* release-set index, -1 when not a return/throw */
+    uint8_t plain;          /* section 6.1: the destination was NONE */
+    uint8_t n_src;
+    JSRegRCCOp src[4];
+} JSRegRCCRec;
+
+struct JSRegRCC {
+    int n_recs;
+    JSRegRCCRec *recs;      /* sorted by `off` (IR order) */
+    int n_rels;
+    int rel_bytes;          /* registers covered by each release set */
+    uint8_t *rels;          /* n_rels * rel_bytes */
+    int reg_count;          /* frame registers (the shadow's size) */
+};
+
