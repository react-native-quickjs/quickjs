+/* The back-edge reconcile: reached from a backward branch when the zero-count
+   table has outgrown its limit. A tail call so the branch handlers stay
+   frameless; the register file does not move, so re-entering at `ip` (the
+   branch target) is safe. */
+/* The back-edge interrupt poll: run the handler (and the deferred-RC
+   safepoint inside it) and re-enter at the branch target. A tail call. */
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_interrupt_slow(REGVM_ARGS)
+{
+    if (__js_poll_interrupts(ctx) < 0)
+        T_FAIL();
+    __attribute__((musttail)) return regvm_t_dispatch(ip, fr, f, ctx);
+}
