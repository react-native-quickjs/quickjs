+/* At every backward branch: decrement `interrupt_counter` and poll at zero
+   (which also runs the deferred-RC safepoint), so a call-free loop stays
+   interruptible. The DRC check stays separate because its limit bounds the
+   parked set between polls. Both slow paths are tail calls. */
+#define REGVM_DRC_BACKEDGE(ctx_, off_)                                       \
+    do { if (unlikely((off_) <= 0)) {                                         \
+        if (unlikely(--(ctx_)->interrupt_counter <= 0)) {                    \
+            __attribute__((musttail))                                        \
+                return regvm_t_interrupt_slow(ip + (off_), fr, f, ctx_);     \
+        }                                                                    \
+        if (unlikely((ctx_)->rt->zct_len + (ctx_)->rt->zct_nobj >            \
+                      (ctx_)->rt->zct_limit)) {                              \
+            return regvm_t_safepoint_slow(ip + (off_), fr, f, ctx_);         \
+        }                                                                    \
+    } } while (0)
 #else
