From: Ammar Ahmed <ammarahmed6506@gmail.com>
Date: Wed, 9 Sep 2026 08:28:18 +0500
Subject: [PATCH] harden regexp bytecode validation


diff --git a/libregexp.c b/libregexp.c
index 5963f21..82069b8 100644
--- a/libregexp.c
+++ b/libregexp.c
@@ -714,6 +714,222 @@ static int re_append_first_set_metadata(REParseState *s, int re_flags)
     return dbuf_error(&s->byte_code) ? -1 : 1;
