Subject: Inline the intrinsic typed-array length getter in OP_get_length

What this does
  Answers a typed array's intrinsic `length` in the handler instead of leaving
  the interpreter for the generic property path.

Why we need it
  The generic path re-checks the receiver and the property after the handler has
  already resolved both, for a value that only depends on the element count.

What it adds
  The arm requires an integer or float view whose `length` is still the
  prototype accessor, so an own `length` shadowing it keeps the slow path, as do
  read-only views, detached buffers and every other class. The value returned is
  the element count, matching the accessor the arm replaces. No opcode is added or
  retired and BC_VERSION is unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -20122,6 +20122,17 @@
     }
 }
 
+/* Inline the intrinsic %TypedArray%.prototype.length getter in OP_get_length. */
+static JSValue js_typed_array_get_length(JSContext *ctx, JSValueConst this_val);
+
+static inline bool js_ta_length_getter(JSObject *getter)
+{
+    return getter != NULL &&
+        getter->class_id == JS_CLASS_C_FUNCTION &&
+        getter->u.cfunc.cproto == JS_CFUNC_getter &&
+        getter->u.cfunc.c_function.getter == js_typed_array_get_length;
+}
+
 static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
                                JSValueConst this_obj, JSValueConst new_target,
                                int argc, JSValueConst *argv, int flags)
@@ -20396,12 +20407,29 @@
                         prs = find_own_property(&pr, p, atom);
                         if (prs) {
                             /* found */
-                            if (unlikely(prs->flags & JS_PROP_TMASK))
+                            if (unlikely(prs->flags & JS_PROP_TMASK)) {
+                                if ((prs->flags & JS_PROP_TMASK) == JS_PROP_GETSET &&
+                                    js_ta_length_getter(pr->u.getset.getter) &&
+                                    is_typed_array(JS_VALUE_GET_OBJ(sp[-1])->class_id)) {
+                                    val = js_int32(JS_VALUE_GET_OBJ(sp[-1])->u.array.count);
+                                    break;
+                                }
                                 goto get_length_slow_path;
+                            }
                             val = js_dup(pr->u.value);
                             break;
                         }
                         if (unlikely(p->is_exotic)) {
+                            /* For `length` a typed array's exotic [[Get]] is a
+                               no-op, so the ordinary walk may continue. */
+                            if (is_typed_array(p->class_id)) {
+                                p = p->shape->proto;
+                                if (!p) {
+                                    val = JS_UNDEFINED;
+                                    break;
+                                }
+                                continue;
+                            }
                             obj = JS_MKPTR(JS_TAG_OBJECT, p);
                             goto get_length_slow_path;
                         }
