+/* Net control-stack effect of one register instruction. Counting per stack
+   bytecode would count a try's `OP_catch` push but not the unmarked `OP_drop`
+   that pops it, so sequential try/catch statements would sum. The lowering
+   emits `ROP_sentinel_drop` for exactly those drops, so in the IR a push and
+   its pop balance. */
+static int regvm_ctl_delta_rop(uint16_t rop)
+{
+    switch (rop) {
+    case ROP_catch_enter:
+    case ROP_finally_enter:
+    case ROP_iter_start:
+    case ROP_for_await_of_start:
+        return 1;
+    case ROP_finally_leave:
+    case ROP_nip_catch:
+    case ROP_iter_close:
+    case ROP_sentinel_drop:
+        return -1;
+    default:
+        return 0;
+    }
+}
+
+/* Size the frame's control stack from the emitted IR: the largest net depth
+   over any path, by a block dataflow so a diamond cannot double-count and a
+   loop cannot accumulate. `blk_of_insn[i]` comes from `src_pc`, since fusion
+   islands are appended with their block's pc. An exception only pops, so the
+   normal paths bound the peak. */
+static int regvm_ctl_bound(JSContext *ctx, const JSRegIR *ir, const uint8_t *bc,
+                           int bc_len, int n_blocks, const int *bstart,
+                           const int *succ, int *ctl_out)
+{
+    int *din = NULL, *dout = NULL, *ddelta = NULL;
+    int maxctl = 0, it, i, pos, rc = -1;
+
+    din = js_malloc(ctx, (size_t)(n_blocks > 0 ? n_blocks : 1) * sizeof(int));
+    dout = js_malloc(ctx, (size_t)(n_blocks > 0 ? n_blocks : 1) * sizeof(int));
+    ddelta = js_malloc(ctx, (size_t)(bc_len + 1) * sizeof(int));
+    if (!din || !dout || !ddelta)
+        goto out;
+    /* Per-bytecode-pc control effect, summed over the IR instructions sharing a
+       pc (a shaper's copies, a fusion island). */
+    for (i = 0; i <= bc_len; i++)
+        ddelta[i] = 0;
+    for (i = 0; i < ir->n_insns; i++) {
+        int pc = ir->insns[i].src_pc;
+        if (pc >= 0 && pc <= bc_len)
+            ddelta[pc] += regvm_ctl_delta_rop(ir->insns[i].rop);
+    }
+    for (i = 0; i < n_blocks; i++) {
+        din[i] = -1;
+        dout[i] = 0;
+    }
+    din[0] = 0;
+    for (it = 0; it < REGVM_MAX_ITERS; it++) {
+        int changed = 0;
+        for (i = 0; i < n_blocks; i++) {
+            int d, k, term;
+            if (din[i] < 0)
+                continue;
+            d = din[i];
+            for (pos = bstart[i]; pos < bstart[i + 1];
+                 pos += short_opcode_info(bc[pos]).size) {
+                d += ddelta[pos];
+                if (d > maxctl)
+                    maxctl = d;
+                if (d < 0)
+                    d = 0;
+            }
+            term = bstart[i];
+            for (pos = bstart[i]; pos < bstart[i + 1];
+                 pos += short_opcode_info(bc[pos]).size)
+                term = pos;
+            if (dout[i] != d) {
+                dout[i] = d;
+                changed = 1;
+            }
+            for (k = 0; k < 2; k++) {
+                int s = succ[i * 2 + k];
+                int dd = d;
+                /* The unwinder has already popped the `catch`'s entry when it
+                   enters the handler, so the handler starts one below the
+                   fall-through. */
+                if (k == 0 && bc[term] == OP_catch)
+                    dd = d - 1;
+                if (dd < 0)
+                    dd = 0;
+                if (s >= 0 && dd > din[s]) {
+                    din[s] = dd;
+                    changed = 1;
+                }
+            }
+        }
+        if (!changed)
+            break;
+    }
+    *ctl_out = maxctl;
+    rc = 0;
+ out:
+    js_free(ctx, din);
+    js_free(ctx, dout);
+    js_free(ctx, ddelta);
+    return rc;
+}
