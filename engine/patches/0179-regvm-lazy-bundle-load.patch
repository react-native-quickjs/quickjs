Subject: Makes lazy bundle loading work

What this does
  Makes lazy bundle loading work.

Why we need it
  Every `JS_READ_OBJ_LAZY` read of a register bundle -- the path a React Native app ships -- failed: `bc_intern_atom` read an atom record from the caller's buffer but bounded it by the lazy source's copy ("read after the end of the buffer"), because the register program's atoms are mapped during the eager read, unlike the stack VM's; and `regvm_validate_code` bounded atom operands by the live atom count instead of the table size, so lazily interned atoms in reused slots were rejected ("register atom out of range").

What it adds
  Both pointers taken from the lazy source; atom bound is `rt->atom_size`.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -70283,9 +70283,12 @@ static int bc_intern_atom(BCReaderState *s, uint32_t idx)
     JSAtom atom;
     uint8_t type;
 
-    s->ptr = s->buf_start + s->atom_offset[idx];
-    if (s->lazy_src)
+    if (s->lazy_src) {
+        s->ptr = s->lazy_src->buf + s->atom_offset[idx];
         s->buf_end = s->lazy_src->buf + s->lazy_src->buf_len;
+    } else {
+        s->ptr = s->buf_start + s->atom_offset[idx];
+    }
     s->ptr_last = NULL;
 
     if (bc_get_u8(s, &type))
@@ -70664,7 +70667,9 @@ static int regvm_validate_code(JSContext *ctx, const JSFunctionBytecode *b)
     const uint8_t *code = b->regvm_code;
     int len = b->regvm_len;
     int wide = 1;                       /* register operands are two bytes */
-    uint32_t atom_count = ctx->rt->atom_count;
+    /* atom indices range over the whole table, free slots included, so the
+       bound is its size, not the number of live atoms */
+    uint32_t atom_count = ctx->rt->atom_size;
     uint8_t *is_start = NULL;
     int *targets = NULL;
     int p, i, n_targets = 0, rc = -1;
