Subject: Shrink the variable-area release walk

What this does
  Shrink the variable-area release walk.

Why we need it
  A promoted local lives in a register and a dead local is never written, yet the DRC walk checked and freed every slot on every call.

What it adds
  Records `regvm_var_count` - the highest *unpromoted* slot plus one - from the promotion map (`slot_ok`/`ok_index`) the register compiler already builds, so a captured local (never promoted) is always covered where an operand scan of the parent's own code would miss it; stored in a spare byte next to `regvm_call_ready`; used as the DRC release walk's bound instead of `var_count`. The fill still writes every slot (a slot above the bound read by any path must see `undefined`); a blob function or one with more than 255 slots keeps `var_count`.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index b18a67b..9a597a0 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -1465,6 +1465,11 @@ typedef struct JSFunctionBytecode {
        `regvm_call_ready` is `regvm_record_eligible`'s conjunction as one byte;
        `regvm_frame_need` is the borrow-case (arg_slots == 0) arena size. */
     uint8_t regvm_call_ready;
+    /* How many variable (var_buf) slots the frame fills and releases: the
+       highest unpromoted slot plus one. A captured local is never promoted, so
+       it is always covered. Blob functions (the promotion map is compile-time
+       only) and functions with more than 255 slots use `var_count`. */
+    uint8_t regvm_var_count;
     uint32_t regvm_frame_need;
 #endif
 #if QJS_AOT_PROFILE
@@ -28470,11 +28475,28 @@ static __attribute__((always_inline)) inline void regvm_record_fill(
      * The callee can still write the window: a function excluded from slot
      * promotion writes its parameters with `put_arg`. The window holds the
      * caller's temporaries, so a window register must never also be a
-     * variable's home.
+       variable's
+     * home.
      *
      * `local_buf`/`local_count` start at var_buf when the arguments are
-     * borrowed, so the release walk frees only what the frame owns.
+       borrowed,
+     * so the release walk frees only what the frame owns.
      */
+    /*
+     * The variable area only needs the slots the register code still names:
+     * `regvm_var_count`, from the promotion map. Under DRC the release walk
+       covers
+     * the variable area alone, so the fill and the walk stop there; without DRC
+     * the walk runs through the registers too and the bound stays `var_count`.
+       A
+     * function with more than 255 slots keeps `var_count` (the field is one
+       byte).
+     */
+    int vcount = cb->var_count;
+#if QJS_DRC
+    if (cb->var_count <= 255)
+        vcount = cb->regvm_var_count;
+#endif
     if (regvm_args_borrowable(cb, na)) {
         rec->arg_buf = (JSValue *)oargv;
         rec->arg_owned = 0;
@@ -28482,7 +28504,7 @@ static __attribute__((always_inline)) inline void regvm_record_fill(
 #if QJS_DRC
         /* Registers do not own, so the release walk covers only the variable
            area (and owned argument copies). */
-        rec->local_count = cb->var_count;
+        rec->local_count = vcount;
 #else
         rec->local_count = cb->var_count + cb->regvm_reg_count + REGVM_HS - 1;
 #endif
@@ -28494,7 +28516,7 @@ static __attribute__((always_inline)) inline void regvm_record_fill(
         rec->arg_owned = 1;
         rec->local_buf = lay->arg_buf;
 #if QJS_DRC
-        rec->local_count = slots + cb->var_count;
+        rec->local_count = slots + vcount;
 #else
         rec->local_count = slots + cb->var_count + cb->regvm_reg_count
             + REGVM_HS - 1;
@@ -28528,7 +28550,7 @@ static __attribute__((always_inline)) inline void regvm_record_fill(
     /* Bounds read into locals: stores through `lay->` may alias `cb`, so fields
        would be reloaded every iteration. */
     {
-        int var_count = cb->var_count;
+        int var_count = cb->var_count; /* the fill stays full */
         int var_ref_count = cb->var_ref_count;
         int nregs = cb->regvm_reg_count + REGVM_HS;
 
@@ -28619,8 +28641,14 @@ static __attribute__((always_inline)) inline void regvm_record_fill_tail(
     rec->arg_buf = lay->arg_buf;
     rec->arg_owned = 1;
     rec->local_buf = lay->arg_buf;
+    /* Same variable-area bound as `regvm_record_fill`. */
+    int vcount = cb->var_count;
+#if QJS_DRC
+    if (cb->var_count <= 255)
+        vcount = cb->regvm_var_count;
+#endif
 #if QJS_DRC
-    rec->local_count = slots + cb->var_count;
+    rec->local_count = slots + vcount;
 #else
     rec->local_count = slots + cb->var_count + cb->regvm_reg_count
         + REGVM_HS - 1;
@@ -28651,7 +28679,7 @@ static __attribute__((always_inline)) inline void regvm_record_fill_tail(
     sf->arg_buf = rec->arg_buf;
 #endif
     {
-        int var_count = cb->var_count;
+        int var_count = cb->var_count; /* the fill stays full */
         int var_ref_count = cb->var_ref_count;
         int nregs = cb->regvm_reg_count + REGVM_HS;
 
@@ -39793,6 +39821,7 @@ typedef struct JSFunctionDef {
     uint8_t *regvm_code;
     int regvm_len;
     int regvm_reg_count;
+    int regvm_var_count;   /* unpromoted variable slots' highest index + 1 */
     int regvm_ctl_count;
     int regvm_pic_count;
     uint8_t regvm_compiled; /* the backend lowered this function */
@@ -64573,6 +64602,24 @@ static __exception int js_regvm_build_cfg(JSContext *ctx, JSFunctionDef *fd,
         }
     }
 
+    /* The frame's variable slots that are not promoted. A captured local is
+       never promoted (`js_u3_slot_private`), so it is counted here even though
+       only the capturing child names it. `ns_ok == 0` means promotion is off
+       for the whole function, so the bound is `var_count`. */
+    {
+        int vc = fd->var_count, hi = -1, k;
+        if (slot_ok && ok_index && ns_ok > 0) {
+            for (k = 0; k < fd->var_count; k++)
+                if (!(slot_ok[k] && ok_index[k] >= 0))
+                    hi = k;
+            if (hi + 1 < vc)
+                vc = hi + 1;
+        }
+        if (vc < 0)
+            vc = 0;
+        fd->regvm_var_count = vc;
+    }
+
     /* Dense value numbering: instruction results first, in pc order over
        reachable code, then phis, so liveness and the allocator index
        deterministically. */
@@ -67419,6 +67466,8 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
         b->regvm_code = (void *)((uint8_t*)b + regvm_offset);
         b->regvm_len = fd->regvm_len;
         b->regvm_reg_count = fd->regvm_reg_count;
+        b->regvm_var_count = fd->regvm_var_count > 255
+            ? 255 : (uint8_t)fd->regvm_var_count;
         b->regvm_ctl_count = fd->regvm_ctl_count;
         b->regvm_pic_count = fd->regvm_pic_count;
         b->regvm_rcc = fd->regvm_rcc;
@@ -71312,6 +71361,9 @@ regvm_wire_decode(BCReaderState *s, JSFunctionBytecode *b,
     }
     b->args_captured = args_captured ? 1 : 0;
     b->argv_safe = argv_safe ? 1 : 0;
+    /* The promotion map is compile-time only, so a blob function keeps
+       `var_count`, clamped to the one-byte field. */
+    b->regvm_var_count = b->var_count > 255 ? 255 : (uint8_t)b->var_count;
 #if QJS_REGVM_THREAD
     b->regvm_all_threaded = all_threaded;
 #endif
