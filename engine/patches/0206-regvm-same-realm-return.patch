@@ -24631,6 +24631,9 @@ static JSValueConst regvm_cur_func(JSRuntime *rt)
 #define REGVM_FLAG_TRIVIAL_RET (1 << 8)
 /* The frame is a light frame (no JSStackFrame, no record tail). */
 #define REGVM_FLAG_LIGHT (1 << 9)
+/* The callee's realm is the caller's, so a return can keep `ctx` instead of
+   loading `c->b->realm`. */
+#define REGVM_FLAG_SAME_REALM (1 << 10)
 
 #if QJS_REGVM_INLOOP_CALL || QJS_REGVM_RECORD
