                     JSValue cst = JS_AtomToValue(ctx, idx);
                     if (JS_IsException(cst))
                         goto exception;
+                    if (sub == REG_BIN_ADD) {
+                        int _ar = regvm_accum_append(ctx, b, regs, rf->arg_buf,
+                                                     rf->argc, d, a, cst);
+                        if (_ar > 0) {
+                            JS_FreeValue(ctx, cst);
+                            REGVM_NEXT();
