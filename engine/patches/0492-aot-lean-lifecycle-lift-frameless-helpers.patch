+    if (JS_VALUE_GET_TAG(ctor->prop[cb->ctor_proto_slot].u.value) != JS_TAG_OBJECT ||
+        sh->proto != JS_VALUE_GET_OBJ(ctor->prop[cb->ctor_proto_slot].u.value))
