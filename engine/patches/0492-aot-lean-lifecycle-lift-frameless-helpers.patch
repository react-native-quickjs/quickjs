+    JSShape *sh;
+    JSValue pv, obj;
+    JSObject *p;
+    uint32_t nf = fm[0], i;
+
+    js_dbg_note[5]++;
+    if (unlikely(ctor->class_id != JS_CLASS_BYTECODE_FUNCTION))
+        return JS_UNINITIALIZED;
