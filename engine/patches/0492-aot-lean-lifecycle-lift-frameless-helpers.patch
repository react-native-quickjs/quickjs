+    if (JS_IsException(ret)) {
+        JS_FreeValue(ctx, self);
+        return ret;
+    }
+    if (JS_VALUE_GET_TAG(ret) == JS_TAG_OBJECT) {
+        JS_FreeValue(ctx, self);
+        return ret;
+    }
+    JS_FreeValue(ctx, ret);
+    qjs_aot_fused_learn(ctx, ctor, self, fm);
+    return self;
+}
