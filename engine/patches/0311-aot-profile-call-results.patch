+/* Record a returned value against the call site that ends at `rip`. Find only:
+   a return into a frame whose resume address is not a profiled call site
+   (a getter, a callback) records nothing. */
+static void js_aot_prof_call_result(JSFunctionBytecode *b, uint8_t *rip,
+                                    JSValue v)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+    JSAotProfCall *c = NULL;
+    uint32_t pc;
+    uint16_t bit;
+    int i;
+
+    if (!pf || !rip)
+        return;
+    pc = (uint32_t)(rip - b->regvm_code);
+    for (i = 0; i < pf->ncalls; i++)
+        if (pf->calls[i].pc == pc) {
+            c = &pf->calls[i];
+            break;
+        }
+    if (!c)
+        return;
+    bit = aot_tag_class(v);
+    c->res_count++;
+    c->res_types |= bit;
+    if (bit == AOT_TYPE_INT || bit == AOT_TYPE_FLOAT) {
+        double d = bit == AOT_TYPE_INT ? (double)JS_VALUE_GET_INT(v)
+                                       : JS_VALUE_GET_FLOAT64(v);
+
+        if (bit == AOT_TYPE_FLOAT) {
+            if (d != trunc(d))
+                c->res_frac = 1;
+            if (d == 0.0 && 1.0 / d < 0.0)
+                c->res_negzero = 1;
+        }
+        if (!c->res_has_num) {
+            c->res_min = c->res_max = d;
+            c->res_has_num = 1;
+        } else {
+            if (d < c->res_min)
+                c->res_min = d;
+            if (d > c->res_max)
+                c->res_max = d;
+        }
+    }
+}
