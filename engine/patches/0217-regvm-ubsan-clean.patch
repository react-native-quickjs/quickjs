Subject: Remove the remaining null-offset UB in the light-frame and dynbuf paths

What this does
  Remove the remaining null-offset UB in the light-frame and dynbuf paths.

Why we need it
  With the first null test fixed, a variable-less light frame forms `var_buf + 0` in the unwind and nested-return walks, and `unicode_normalize` is handed `(DynBufReallocFunc *)js_realloc`/`js_realloc_rt` casts whose function types do not match.

What it adds
  `regvm_rec_of_sf` returns NULL when the arena is absent; the release walks skip the addition when `vc == 0`; the casts become real wrappers (`js_dbuf_realloc`, `js_dbuf_realloc_rt`) with the right prototype.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index acb9d70..e3c3065 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -3110,6 +3110,13 @@ static void *js_dbuf_realloc(void *ctx, void *ptr, size_t size)
     return js_realloc(ctx, ptr, size);
 }
 
+/* The runtime-keyed twin of the above: casting `js_realloc_rt` to
+   `DynBufReallocFunc` is a function-pointer type mismatch (UBSan). */
+static void *js_dbuf_realloc_rt(void *rt, void *ptr, size_t size)
+{
+    return js_realloc_rt(rt, ptr, size);
+}
+
 static inline void js_dbuf_init(JSContext *ctx, DynBuf *s)
 {
     dbuf_init2(s, ctx, js_dbuf_realloc);
@@ -24708,6 +24715,9 @@ static JSRegRun *regvm_rec_of_sf(JSRuntime *rt, JSStackFrame *sf)
     const uint8_t *lo = rt->regvm_frames;
     size_t top = rt->regvm_frames_top;
 
+    /* no arena yet: nothing is a record */
+    if (lo == NULL)
+        return NULL;
     /* the newest frames are in the current chunk; older ones in its prev chain */
     while (p < lo || p >= lo + top) {
         if (!c || !(c = c->prev))
@@ -26630,7 +26640,7 @@ regvm_t_return_light_nested(REGVM_ARGS)
     if (b->var_count <= 255)
         vc = b->regvm_var_count;
 #endif
-    end = f->var_buf + vc;
+    end = vc > 0 ? f->var_buf + vc : f->var_buf;
     for (p = f->var_buf; p < end; p++)
         if (REGVM_HAS_COUNT(*p))
             JS_FreeValueRT(ctx->rt, *p);
@@ -29277,7 +29287,7 @@ static uint8_t *REGVM_CC regvm_t_unwind_loop(REGVM_ARGS)
         if (b->var_count <= 255)
             vc = b->regvm_var_count;
 #endif
-        end = f->var_buf + vc;
+        end = vc > 0 ? f->var_buf + vc : f->var_buf;
         for (p = f->var_buf; p < end; p++)
             if (REGVM_HAS_COUNT(*p))
                 JS_FreeValueRT(ctx->rt, *p);
@@ -82526,7 +82536,7 @@ static JSValue js_string_localeCompare(JSContext *ctx, JSValueConst this_val,
 
     // TODO(bnoordhuis) skip normalization when input is latin1
     an = unicode_normalize(&ts, as, an, UNICODE_NFC, ctx,
-                           (DynBufReallocFunc *)js_realloc);
+                           js_dbuf_realloc);
     if (an == -1)
         goto exception;
     js_free(ctx, as);
@@ -82534,7 +82544,7 @@ static JSValue js_string_localeCompare(JSContext *ctx, JSValueConst this_val,
 
     // TODO(bnoordhuis) skip normalization when input is latin1
     bn = unicode_normalize(&ts, bs, bn, UNICODE_NFC, ctx,
-                           (DynBufReallocFunc *)js_realloc);
+                           js_dbuf_realloc);
     if (bn == -1)
         goto exception;
     js_free(ctx, bs);
@@ -82714,7 +82724,7 @@ static JSValue js_string_normalize(JSContext *ctx, JSValueConst this_val,
     }
 
     out_len = unicode_normalize(&out_buf, buf, buf_len, n_type,
-                                ctx->rt, (DynBufReallocFunc *)js_realloc_rt);
+                                ctx->rt, js_dbuf_realloc_rt);
     js_free(ctx, buf);
     if (out_len < 0)
         return JS_EXCEPTION;
