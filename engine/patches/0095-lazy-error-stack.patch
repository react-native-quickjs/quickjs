 /* if filename != NULL, an additional level is added with the filename
    and line number information (used for parse error). */
+/* Deferred Error stack frames: the walk stays eager, the FORMATTING is what is
+   deferred to the first .stack read. A frame retains only a name JSString, a
+   filename JSAtom and two ints -- no object and no bytecode -- so nothing here
+   can take part in a reference cycle and the class needs no mark function. The
+   name is captured eagerly because `f.name` is writable and the trace must show
+   the name as it was when the Error was constructed. */
+typedef struct JSErrorStackFrame {
+    JSValue func_name;   /* JS_TAG_STRING, or JS_NULL => "<anonymous>" */
+    JSAtom filename;     /* JS_ATOM_NULL => "<null>" */
+    int line_num;        /* -1 => omit ":line:col" */
+    int col_num;
+    uint8_t kind;        /* 0 = located, 1 = "(missing)", 2 = "(native)" */
+} JSErrorStackFrame;
+
+typedef struct JSErrorStackData {
+    uint32_t count;
+    JSErrorStackFrame frames[];
+} JSErrorStackData;
+
+static void js_error_stack_finalizer(JSRuntime *rt, JSValueConst val)
+{
+    JSErrorStackData *esd = JS_GetOpaque(val, JS_CLASS_ERROR_STACK);
+    uint32_t i;
+
+    if (esd) {
+        for (i = 0; i < esd->count; i++) {
+            JS_FreeValueRT(rt, esd->frames[i].func_name);
+            JS_FreeAtomRT(rt, esd->frames[i].filename);
+        }
+        js_free_rt(rt, esd);
+    }
+}
+
+static const JSClassShortDef js_error_stack_class_def[] = {
+    { JS_ATOM_Error, js_error_stack_finalizer, NULL }, /* JS_CLASS_ERROR_STACK */
+};
+
+/* Like get_func_name(), but returns a strong reference to the name JSString
+   instead of a converted C string. Same acceptance rule: an own, normal
+   (non-accessor) data property named "name" whose value is a string. */
+static JSValue get_func_name_value(JSContext *ctx, JSValueConst func)
+{
+    JSProperty *pr;
+    JSShapeProperty *prs;
+    JSValue val;
+
+    if (JS_VALUE_GET_TAG(func) != JS_TAG_OBJECT)
+        return JS_NULL;
+    prs = find_own_property(&pr, JS_VALUE_GET_OBJ(func), JS_ATOM_name);
+    if (!prs)
+        return JS_NULL;
+    if ((prs->flags & JS_PROP_TMASK) != JS_PROP_NORMAL)
+        return JS_NULL;
+    val = pr->u.value;
+    if (JS_VALUE_GET_TAG(val) != JS_TAG_STRING)
+        return JS_NULL;
+    return js_dup(val);
+}
+
+/* Formats captured frames into the exact byte sequence the eager path produced.
+   Consumes nothing; returns JS_NULL where the eager path also yielded NULL on a
+   dbuf error. */
+static JSValue js_error_stack_format(JSContext *ctx, JSErrorStackData *esd)
+{
+    DynBuf dbuf;
+    JSValue ret;
+    uint32_t i;
+
+    js_dbuf_init(ctx, &dbuf);
+    for (i = 0; i < esd->count; i++) {
+        JSErrorStackFrame *f = &esd->frames[i];
+        const char *str1;
+        const char *name_str = NULL;
+
+        if (JS_IsString(f->func_name))
+            name_str = JS_ToCString(ctx, f->func_name);
+        if (!name_str || name_str[0] == '\0')
+            str1 = "<anonymous>";
+        else
+            str1 = name_str;
+        dbuf_printf(&dbuf, "    at %s", str1);
+        JS_FreeCString(ctx, name_str);
+
+        if (f->kind == 0) {
+            const char *atom_str;
+
+            atom_str = f->filename != JS_ATOM_NULL
+                     ? JS_AtomToCString(ctx, f->filename) : NULL;
+            dbuf_printf(&dbuf, " (%s", atom_str ? atom_str : "<null>");
+            JS_FreeCString(ctx, atom_str);
+            if (f->line_num != -1)
+                dbuf_printf(&dbuf, ":%d:%d", f->line_num, f->col_num);
+            dbuf_putc(&dbuf, ')');
+        } else if (f->kind == 1) {
+            dbuf_printf(&dbuf, " (missing)");
+        } else {
+            dbuf_printf(&dbuf, " (native)");
+        }
+        dbuf_putc(&dbuf, '\n');
+    }
+    if (dbuf_error(&dbuf))
+        ret = JS_NULL;
+    else
+        ret = JS_NewStringLen(ctx, (char *)dbuf.buf, dbuf.size);
+    dbuf_free(&dbuf);
+    return ret;
+}
