Subject: Deferred RC: mark parked objects for the register validator

What this does
  Deferred RC: mark parked objects for the register validator.

Why we need it
  `js_drc_zero` parked a zero-count object on `gc_zero_ref_count_list` without setting the `in_zct` marker that a parked string/BigInt did set, `JS_DRC_UNIQUELY_OWNED` reads the same marker to refuse in-place mutation of a parked, resurrected value.

What it adds
  Sets `JS_GC_IN_ZCT(p)` when an object is parked in `js_drc_zero` and clears it when the object is resurrected in `js_drc_reconcile_locked`.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index 9a597a0..9ad4ede 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -854,7 +854,16 @@ static void js_drc_validate_range(void *opaque, JSValue *regs, uint32_t nregs)
         JSValue v = regs[i];
         if (!JS_VALUE_HAS_REF_COUNT(v))
             continue;
+        /* Registers borrow under deferred RC, so a counted value at count zero
+           is legitimate if it is parked on the zero-count table. Only a value
+           that is counted, at zero and not parked is garbage. With owning
+           registers the stricter test applies. */
+#if QJS_DRC
+        if (JS_REF_COUNT(JS_VALUE_GET_PTR(v)) < 1 &&
+            !JS_GC_IN_ZCT(JS_VALUE_GET_PTR(v))) {
+#else
         if (JS_REF_COUNT(JS_VALUE_GET_PTR(v)) < 1) {
+#endif
             fprintf(stderr,
                     "drc-validate: register %p[%u] holds a counted value at "
                     "ref_count %u\n",
@@ -9679,6 +9688,10 @@ static void js_drc_zero(JSRuntime *rt, JSValue v)
             JSGCObjectHeader *p = JS_VALUE_GET_PTR(v);
             list_del(&p->link);
             list_add(&p->link, &rt->gc_zero_ref_count_list);
+            /* Parked objects carry the same marker as parked strings, so a
+               borrowing register that still names one is not taken for dangling
+               (see js_drc_validate_range). */
+            JS_GC_IN_ZCT(p) = 1;
             rt->zct_nobj++;
         }
         break;
@@ -9752,6 +9765,7 @@ static void js_drc_reconcile_locked(JSRuntime *rt)
         p = list_entry(el, JSGCObjectHeader, link);
         if (JS_REF_COUNT(p) > 0) {
             list_del(&p->link);
+            JS_GC_IN_ZCT(p) = 0;   /* resurrected: no longer parked */
             if (JS_GC_NOTRACE(p))
                 list_add_tail(&p->link, &rt->gc_notrace_list);
             else
