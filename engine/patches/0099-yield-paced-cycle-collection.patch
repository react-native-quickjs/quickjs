+/* Yield-aware collection pacing. A collection is unproductive when it
+   reclaimed less than 1/JS_GC_BARREN_FRACTION of the heap or less than
+   JS_GC_MIN_WORTH bytes. Consecutive unproductive collections double the
+   growth step, up to JS_GC_PACE_MAX_PCT of the live heap; a productive one
+   resets the streak. A cap of 0 keeps the unmodified rule. */
+#define JS_GC_BARREN_FRACTION     64
+#define JS_GC_MIN_WORTH           (256 * 1024)
+#define JS_GC_PACE_MAX_PCT        400
+#define JS_GC_PACE_STREAK_DEFAULT 8
