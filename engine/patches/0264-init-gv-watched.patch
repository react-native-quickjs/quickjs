Subject: Initialize an object's global-watch flag when it is created

What this does
  A new object's `gv_watched` bit is now cleared with its other flag bits.
  Only the global object and the global variable object set it. The register
  VM's global read sites also allocate their function's cache table before
  looking for a filled cell, so a function whose only sites are global reads
  keeps the light call path even when its first reads miss.

Why we need it
  The bit was never initialized, so an object placed in a reused allocator
  block could inherit a set bit from the block's previous occupant. Every
  property added to such an object then invalidated every global cell cache
  and every global read site in the runtime. On Octane raytrace that was more
  than 100,000 invalidations in a short run, and the global caches almost
  never hit.

Needs a bytecode version bump
  No.

diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -8714,6 +8714,7 @@
     p->is_uncatchable_error = 0;
     p->tmp_mark = 0;
     p->is_HTMLDDA = 0;
+    p->gv_watched = 0;
     p->is_prototype = 0;
     p->first_weak_ref = NULL;
     p->u.opaque = NULL;
@@ -15568,12 +15569,6 @@
     JSProperty *slot;
     JSRegPIC *pic, *e;
 
-    if (gvc[0].atom == atom && gvc[0].gen == gen)
-        slot = gvc[0].slot;
-    else if (gvc[1].atom == atom && gvc[1].gen == gen)
-        slot = gvc[1].slot;
-    else
-        return;
     if ((unsigned)site >= b->regvm_pic_count)
         return;
     pic = *ppic;
@@ -15583,6 +15578,12 @@
             return;
         *ppic = pic;
     }
+    if (gvc[0].atom == atom && gvc[0].gen == gen)
+        slot = gvc[0].slot;
+    else if (gvc[1].atom == atom && gvc[1].gen == gen)
+        slot = gvc[1].slot;
+    else
+        return;
     e = &pic[site];
     if (e->kind != REG_PIC_GLOBAL && e->kind != REG_PIC_EMPTY)
         return;
