Subject: Break the closure self-cycle at frame teardown

What this does
  Walks the frame's var_refs during teardown and releases a detached var_ref
  whose only holder is the var_refs array of the bytecode function it points at,
  with both counts at 1. That pair is a two-node cycle reference counting cannot
  reach, so it otherwise survives until a full-heap trial deletion.

What it adds
  js_closcyc_frame(), called from the existing frame teardown after the locals
  have been released and while the frame still owns its var_ref list. The order
  is required: close_var_refs() detaches a var_ref through a js_dup of the value,
  so until the locals are gone the function's count is 2 and the test cannot
  match. The call sits behind the existing sf->var_ref_count != 0 branch, so a
  frame that captures nothing never reaches it and the work is bounded by the
  frame's var_ref count rather than by decrement traffic.

  A pair the rule does not recognise is still collected by the cycle collector.
  Only a false positive would be unsafe, so every condition in the test is a
  necessary one and it may be as conservative as it likes.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -21574,6 +21574,46 @@
         JS_FreeValue(ctx, ret);
     }
     return JS_COLD_HANDLER_OK(sp);
+}
+
+static no_inline __attribute__((cold)) void
+js_closcyc_frame(JSRuntime *rt, JSStackFrame *sf)
+{
+    int i;
+
+    for (i = 0; i < sf->var_ref_count; i++) {
+        JSVarRef *vr = sf->var_refs[i];
+        JSFunctionBytecode *b;
+        JSVarRef **vrs;
+        JSObject *o;
+        int j, n, owns;
+
+        if (!vr || !vr->is_detached || JS_REF_COUNT(vr) != 1)
+            continue;
+        if (JS_VALUE_GET_TAG(vr->value) != JS_TAG_OBJECT)
+            continue;
+        o = JS_VALUE_GET_OBJ(vr->value);
+        if (o->class_id != JS_CLASS_BYTECODE_FUNCTION || JS_REF_COUNT(o) != 1)
+            continue;
+        b = o->u.func.function_bytecode;
+        vrs = o->u.func.var_refs;
+        if (!b || !vrs)
+            continue;
+        n = b->closure_var_count;
+        owns = 0;
+        for (j = 0; j < n; j++)
+            if (vrs[j] == vr) { owns = 1; break; }
+        if (!owns)
+            continue;
+
+        sf->var_refs[i] = NULL;
+        {
+            JSValue t = vr->value;
+            vr->value = JS_UNDEFINED;
+            vr->pvalue = &vr->value;
+            JS_FreeValueRT(rt, t);
+        }
+    }
 }
 
 static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
@@ -25138,6 +25178,8 @@
         for(pval = local_buf; pval < sp; pval++) {
             JS_FreeValue(ctx, *pval);
         }
+        if (unlikely(sf->var_ref_count != 0))
+            js_closcyc_frame(rt, sf);
     }
     rt->current_stack_frame = sf->prev_frame;
     return ret_val;
