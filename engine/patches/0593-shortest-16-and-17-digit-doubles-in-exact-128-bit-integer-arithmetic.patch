+#ifdef __SIZEOF_INT128__
+/* For a = |d| = m * 2^q, normal, non-integral, below 2^53: the decimal with exactly nd significant digits (R, k fraction digits)
+   that lies in a's rounding interval and is nearest to a (ties to even R), all in exact 128-bit integers. Returns 1 and sets
+   *pr / *pk when there is one, 0 when there is none, -1 when the scale is out of this routine's range (the caller falls back).
+   In units of 2^(q-2): a is V = 4m, the interval is [V - lo, V + 2] (lo = 1 at a power of two, where the gap below is half the gap
+   above, else 2), closed when m is even (round-half-even maps the ends to a), open otherwise. With T = V * 10^k and S = 2 - q,
+   floor(a * 10^k) = T >> S and the remainder T mod 2^S is the distance below a * 10^k in the same units, so a candidate R is in
+   the interval when its distance is at most lo * 10^k (below) or 2 * 10^k (above). */
+static int dtoa_exact_nd(uint64_t m, int q, int nd, uint64_t *pr, int *pk)
+{
+    static const uint64_t p10[20] = {
+        1ULL, 10ULL, 100ULL, 1000ULL, 10000ULL, 100000ULL, 1000000ULL, 10000000ULL, 100000000ULL, 1000000000ULL,
+        10000000000ULL, 100000000000ULL, 1000000000000ULL, 10000000000000ULL, 100000000000000ULL,
+        1000000000000000ULL, 10000000000000000ULL, 100000000000000000ULL, 1000000000000000000ULL,
+        10000000000000000000ULL,
+    };
+    typedef unsigned __int128 u128;
+    int S = 2 - q, k, tries;
+    u128 V = (u128)m << 2, T, pk10, rem, one, below_ok, above_ok;
+    uint64_t rf, lo;
+    bool closed = (m & 1) == 0;
+
+    if (S < 3 || S > 120)
+        return -1;
+    lo = (m == ((uint64_t)1 << 52)) ? 1 : 2;
+    /* k for nd digits from the integer part's length, then corrected by the exact floor */
+    {
+        uint64_t ip = (uint64_t)(V >> S);
+        int e10 = -1;
+        if (ip != 0) {
+            while (e10 + 1 < 20 && ip >= p10[e10 + 1])
+                e10++;
+        } else {
+            /* a < 1: e10 = -(number of leading fraction zeros + 1), found below by correction from a start of -1 */
+        }
+        k = nd - 1 - e10;
+    }
+    for (tries = 0; tries < 40; tries++) {
+        if (k < 0 || k > 21)
+            return -1;
+        pk10 = k <= 19 ? (u128)p10[k] : (u128)p10[19] * p10[k - 19];
+        T = V * pk10;
+        if ((T >> S) >> 64)
+            return -1;
+        rf = (uint64_t)(T >> S);
+        if (rf < p10[nd - 1]) {
+            k++;
+            continue;
+        }
+        if (rf >= p10[nd]) {
+            k--;
+            continue;
+        }
+        break;
+    }
+    if (tries == 40)
+        return -1;
+    one = (u128)1 << S;
+    rem = T & (one - 1);
+    /* rf: distance rem below; rf + 1: distance one - rem above (only when rem != 0) */
+    below_ok = closed ? rem <= (u128)lo * pk10 : rem < (u128)lo * pk10;
+    above_ok = rem != 0 && (closed ? one - rem <= (u128)2 * pk10 : one - rem < (u128)2 * pk10);
+    if (below_ok && above_ok) {
+        if (rem < one - rem)
+            above_ok = 0;
+        else if (rem > one - rem)
+            below_ok = 0;
+        else if (rf & 1)
+            below_ok = 0;
+        else
+            above_ok = 0;
+    }
+    if (below_ok) {
+        *pr = rf;
+    } else if (above_ok) {
+        if (rf + 1 >= p10[nd])
+            return -1; /* a carry to nd + 1 digits: a shorter form exists, leave it to the general routine */
+        *pr = rf + 1;
+    } else {
+        return 0;
+    }
+    *pk = k;
+    return 1;
+}
+#endif
