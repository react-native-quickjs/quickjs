+int qjs_aot_strproto_slot(JSContext *ctx, uint32_t atom, const void **shape,
+                          const void **prs_out, uint32_t *off)
+{
+    JSValue pv = ctx->class_proto[JS_CLASS_STRING];
+    JSObject *p;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+
+    if (JS_VALUE_GET_TAG(pv) != JS_TAG_OBJECT)
+        return 0;
+    /* a string's own `length` and its index properties come before the prototype's */
+    if (atom == JS_ATOM_length || __JS_AtomIsTaggedInt((JSAtom)atom))
+        return 0;
+    p = JS_VALUE_GET_OBJ(pv);
+    prs = find_own_property(&pr, p, (JSAtom)atom);
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_NORMAL)
+        return 0;
+    *shape = p->shape;
+    *prs_out = prs;
+    *off = (uint32_t)((uint8_t *)pr - (uint8_t *)p->prop);
+    return 1;
+}
+
 /* A store of a number into an element of a typed array that is in range: 1 when done.
    An integer goes to any element type (converted as the engine's own fast path does),
    a double only to the float types; anything else is the caller's slow path. */
