 /* Bind a function to its generated entry. The table is sorted by digest;
    `code_crc` catches a stale unit (QJS_AOT_VERIFY). Called once, when the
    bytecode is final. */
+/* Look a property up as an own data slot of `obj`, for the polymorphic cache.
+   Returns 1 and the byte offset when it is one, 0 otherwise. A write also
+   needs the slot to be writable and the object not to be a prototype. It never
+   runs JavaScript, so a compiled body may call it without a safepoint. */
+#if QJS_AOT || QJS_AOT_GEN
+static void regvm_shape_hashify(JSRuntime *rt, JSShape *sh);
+
+static int js_aot_poly_lookup(JSObject *obj, JSAtom atom, int write, uint32_t *off)
+{
+    JSShape *sh = obj->shape;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    prs = find_own_property(&pr, obj, atom);
+    if (prs == NULL)
+        return 0;
+    /* A getter/setter, a closure variable or an auto-init property stores
+       something that is not a JSValue in the same slot; reading it as one
+       would produce a value the engine never made. */
+    if (prs->flags & JS_PROP_TMASK)
+        return 0;
+    if (write) {
+        if (!(prs->flags & JS_PROP_WRITABLE))
+            return 0;
+        if (obj->is_prototype)
+            return 0;
+    }
+    (void)sh;
+    *off = (uint32_t)((const unsigned char *)&pr->u.value - (const unsigned char *)obj->prop);
+    return 1;
+}
+
+/* Fill one site's polymorphic cache with `obj`'s shape and the property's
+   offset. Round-robin: a full set replaces the entry whose fill stamp is oldest.
+   Returns 1 with *off on success, 0 when the property is not own data (or not
+   writable, for a write) and the caller must exit. Runs no JavaScript. */
+int qjs_aot_poly_fill(
+    JSContext *ctx, JSRegRun *f, int site, JSValue obj, JSAtom atom, int write,
+    uint32_t *off)
+{
+    JSFunctionBytecode *b = f->b;
+    JSAotPolyEntry *e;
+    JSShape *sh;
+    int k, slot = -1;
+    uint32_t off2;
+    if (b == NULL || site < 0 || JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return 0;
+    if (!js_aot_poly_lookup(JS_VALUE_GET_OBJ(obj), atom, write, &off2))
+        return 0;
+    if (b->aot_poly == NULL || (uint32_t)site >= b->aot_poly_sites) {
+        /* Binding sized the cache for every site; a site beyond it means the
+           unit and the engine disagree, so refuse rather than allocate here
+           (this call must not reach a safepoint). */
+        return 0;
+    }
+    e = b->aot_poly + (size_t)site * AOT_POLY_WAYS;
+    sh = JS_VALUE_GET_OBJ(obj)->shape;
+    /* The entries hold weak shape pointers, so every hit is revalidated by the
+       caller's shape compare against a live object; nothing is released. */
+    for (k = 0; k < AOT_POLY_WAYS; k++) {
+        if (e[k].shape == sh) {
+            e[k].off = off2;
+            e[k].kind = (uint16_t)(write ? AOT_POLY_WRITE : AOT_POLY_READ);
+            *off = off2;
+            return 1;
+        }
+        /* Prefer an empty way; among full ones, the oldest fill stamp. */
+        if (slot < 0)
+            slot = k;
+        else if (e[slot].shape != NULL && e[k].shape == NULL)
+            slot = k;
+        else if (e[slot].shape != NULL && e[k].shape != NULL &&
+                 e[k].fill < e[slot].fill)
+            slot = k;
+    }
+    /* Only a hashed shape may be cached, and it is cached with a reference: a
+       hashed shape with a reference is copy-on-write, so it cannot be mutated
+       under the offset cached beside it. An unhashed shape can be mutated in
+       place, which moves the slot that offset names -- that was the DeltaBlue
+       miscompile. It is refused rather than hashed here, because hashing can
+       resize the runtime's shape table, i.e. allocate, and this call is made
+       from compiled code where an allocation is a safepoint mid-instruction.
+       The caller exits, the interpreter runs the read, and the shape is hashed
+       by the engine's own paths before the next attempt. */
+    if (!sh->is_hashed)
+        return 0;
+    e[slot].shape = js_dup_shape(sh);
+    e[slot].off = off2;
+    e[slot].kind = (uint16_t)(write ? AOT_POLY_WRITE : AOT_POLY_READ);
+    e[slot].fill = (uint16_t)(e[slot].fill + 1);
+    *off = off2;
+    return 1;
+}
+#endif /* QJS_AOT || QJS_AOT_GEN */
+
 static void js_aot_bind(JSFunctionBytecode *b)
 {
     uint8_t digest[16];
