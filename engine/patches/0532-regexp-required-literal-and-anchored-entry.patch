+                int lo = at - e->r.prefix_max - 1;
+                if (lo > start_index)
+                    start_index = lo;
+            }
+        }
+    }
+    return lre_exec(capture, d->bytecode, str8(str), start_index,
+                    str->len, str->is_wide_char, ctx);
+}
