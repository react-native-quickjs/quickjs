+#define FMT(f)
+#define DEF(id, size, n_pop, n_push, f) REG_LOWERING_ ## id,
+#define def(id, size, n_pop, n_push, f)
+#include "quickjs-opcode.h"
+#undef def
+#undef DEF
+#undef FMT
+};
