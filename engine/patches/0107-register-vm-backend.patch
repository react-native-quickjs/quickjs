+#define REG_LOWERING_perm5              REG_LOWER_ELIDED
+#define REG_LOWERING_swap               REG_LOWER_ELIDED
+#define REG_LOWERING_swap2              REG_LOWER_ELIDED
+#define REG_LOWERING_rot3l              REG_LOWER_ELIDED
