+ * callee will overwrite. The set is not invented -- it is what JS_CallInternal
+ * hands across its own handoff, plus the callee's return destination, which a C
+ * call did not need because it returned a value. `JSRegAsmState` carries most of
+ * the same set for the assembly driver, which is the evidence that it is right.
+ */
+typedef struct JSRegFrame {
+    struct JSRegFrame *prev;
+    uint8_t      *rpc;          /* caller's resume ip, pointing AT the next opcode */
+    JSValue      *fr;           /* caller's register file */
+    JSValue      *local_buf;    /* caller's frame base: what the release walks */
+    JSValue      *sp;
+    uint8_t      *pc;
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSContext    *ctx;
+    JSObject     *p;
+    JSVarRef    **var_refs;
+    JSValue      *arg_buf, *var_buf;
+    JSValueConst  func_obj, this_obj, new_target;
+    JSValue      *argv;
+    int           argc;
+    int           flags;
+    JSRegCtl     *ctl;
+    int           nctl;
+    uint8_t      *resume_marker;
