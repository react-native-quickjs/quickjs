+   pointed at, because it must not move while a cell or a backtrace holds it. */
+typedef struct JSRegFrameLayout {
+    JSRegFrame   *hdr;
+    JSStackFrame *sf;
+    JSValue      *arg_buf, *var_buf, *regs;
+    JSVarRef    **var_refs;
