+/*
+ * --- P3: nested register frames -------------------------------------------
+ *
+ * A call to a register-compiled JS function is a push, a dispatch, and (on
+ * return) a pop, all inside one activation of js_regvm_execute. Nothing about
+ * the callee's execution changes: it runs the same dispatch loop, the same
+ * handlers, the same threaded chain. What changes is that the frame it runs in
+ * is a block of the runtime's register stack instead of a C frame, and that
+ * returning does not leave the function.
+ *
+ * The arena. Never relocated while a frame is live. That is load-bearing: a
+ * JSVarRef holds a raw pointer into a frame's argument or variable area, and
+ * free_var_ref writes back through a raw pointer to the frame, so a frame that
+ * moves under a live cell corrupts it. regvm_arena_push grows only when the
+ * arena is empty and returns NULL otherwise; the caller then takes the existing
+ * JS_CallInternal path, which is not a special case but the path that is there
+ * today. An exhausted arena degrades to today's behaviour rather than failing.
+ */
+#define REGVM_ARENA_MIN (64 * 1024)
+
+static uint8_t *regvm_arena_push(JSRuntime *rt, size_t need)
+{
+    size_t top, ntop;
+
+    need = (need + 15) & ~(size_t)15;
+    top = (rt->regvm_frames_top + 15) & ~(size_t)15;
+    ntop = top + need;
+
+    if (unlikely(ntop > rt->regvm_frames_size)) {
+        size_t cap;
+        uint8_t *nb;
+
+        if (rt->regvm_frames_top != 0)
+            return NULL;            /* live frames: do not move them */
+        if (unlikely(ntop > (size_t)1 << 22))
+            return NULL;            /* a 4 MB stack is already very deep */
+        cap = rt->regvm_frames_size ? rt->regvm_frames_size : REGVM_ARENA_MIN;
+        while (cap < ntop)
+            cap *= 2;
+        nb = js_realloc_rt(rt, rt->regvm_frames, cap);
+        if (!nb)
+            return NULL;
+        rt->regvm_frames = nb;
+        rt->regvm_frames_size = cap;
+    }
+    rt->regvm_frames_top = ntop;
+    return rt->regvm_frames + top;
+}
