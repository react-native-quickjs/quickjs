+    REG_BIN_MUL = 0, REG_BIN_DIV, REG_BIN_MOD, REG_BIN_ADD, REG_BIN_SUB,
+    REG_BIN_SHL, REG_BIN_SAR, REG_BIN_SHR, REG_BIN_AND, REG_BIN_XOR,
+    REG_BIN_OR, REG_BIN_POW,
