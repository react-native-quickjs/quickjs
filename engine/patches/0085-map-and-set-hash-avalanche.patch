Subject: Avalanche the Map and Set key hashes

What this does
  Mixes the key hash used by Map and Set so that keys differing in their high
  bits do not select the same bucket.

Why we need it
  A hash whose high bits are not spread leaves the bucket determined by a few
  low bits, so the container degrades toward a linear scan for keys that share
  them.

What it adds
  A finalisation step spreads each bit of the incoming hash across the whole word
  before the bucket is selected. Insertion, lookup and deletion all run the same
  function, so they stay consistent, and keys that compare equal still hash equal.
  No opcode is added or retired and BC_VERSION is unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -61490,7 +61490,19 @@ static JSValueConst map_normalize_key_const(JSContext *ctx, JSValueConst key)
     return safe_const(map_normalize_key(ctx, unsafe_unconst(key)));
 }
 
-/* XXX: better hash ? */
+/* splitmix64 finalizer. Bucket selection is `h & (size-1)`, so every input
+   bit must reach the low bits: small integers as doubles and aligned heap
+   pointers are dominated by trailing zeros. */
+static inline uint64_t map_hash_mix64(uint64_t x)
+{
+    x ^= x >> 30;
+    x *= UINT64_C(0xbf58476d1ce4e5b9);
+    x ^= x >> 27;
+    x *= UINT64_C(0x94d049bb133111eb);
+    x ^= x >> 31;
+    return x;
+}
+
 static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
 {
     uint32_t tag = JS_VALUE_GET_NORM_TAG(key);
@@ -61511,7 +61523,7 @@ static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
         break;
     case JS_TAG_OBJECT:
     case JS_TAG_SYMBOL:
-        h = (uintptr_t)JS_VALUE_GET_PTR(key) * 3163;
+        h = (uint32_t)map_hash_mix64((uint64_t)(uintptr_t)JS_VALUE_GET_PTR(key));
         break;
     case JS_TAG_INT:
         d = JS_VALUE_GET_INT(key);
@@ -61530,7 +61542,10 @@ static uint32_t map_hash_key(JSContext *ctx, JSValueConst key)
             d = NAN;
     hash_float64:
         u.d = d;
-        h = (u.u32[0] ^ u.u32[1]) * 3163;
+        /* Numeric keys hash with the tag forced to FLOAT64, so 1, 1.0 and 1n
+           hash alike (SameValueZero). map_normalize_key() has already turned -0
+           into 0. */
+        h = (uint32_t)map_hash_mix64(u.u64);
         tag = JS_TAG_FLOAT64;
         break;
     default:
