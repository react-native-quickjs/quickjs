+#if QJS_PACKED_ARRAYS
+/* Copies the run [src_off, src_off+len) of the packed array src into the empty packed array p, in
+   the source's own kind. Returns 1 copied, 0 when the destination is not an empty packed array of
+   that kind, -1 out of memory. */
+static int js_arr_packed_copy_run(JSContext *ctx, JSObject *p, JSObject *src,
+                                  uint32_t src_off, uint32_t len)
+{
+    size_t esz;
+
+    if (JS_ARR_GENERIC(p) || JS_ARR_GENERIC(src) || src->holey ||
+        src_off + (uint64_t)len > src->u.array.count || p->u.array.count != 0)
+        return 0;
+    if (len == 0)
+        return 1;
+    p->arr_kind = src->arr_kind;
+    esz = js_arr_elem_size(p);
+    if (len > p->u.array.u1.size && js_arr_packed_reserve(ctx, p, len) < 0)
+        return -1;
+    memcpy(p->u.array.u.values_raw, (char *)src->u.array.u.values_raw + (size_t)src_off * esz,
+           (size_t)len * esz);
+    p->u.array.count = len;
+    return 1;
+}
+
+/* Copies count elements of the packed array obj, from index start, into the result array arr that
+   ArraySpeciesCreate made for slice/splice. Returns 1 copied, 0 when this is not the plain-Array
+   case (the caller's generic loop runs), -1 out of memory.
+
+   Only the default species qualifies: then arr is a fresh Array of this realm whose length already
+   equals count and whose elements the generic loop would fill in order with obj's elements, so the
+   copy stores exactly them. A subclass, an own constructor or a replaced @@species takes the generic
+   route with its observable gets. */
+static int js_array_packed_slice_copy(JSContext *ctx, JSValueConst obj, JSValueConst arr,
+                                      int64_t start, int64_t count)
+{
+    JSObject *sp, *ap;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT || JS_VALUE_GET_TAG(arr) != JS_TAG_OBJECT)
+        return 0;
+    sp = JS_VALUE_GET_OBJ(obj);
+    if (sp->class_id != JS_CLASS_ARRAY || !sp->fast_array || sp->holey || JS_ARR_GENERIC(sp))
+        return 0;
+    if (start < 0 || count < 0 || start + count > (int64_t)sp->u.array.count)
+        return 0;
+    if (!js_array_species_is_default(ctx, obj))     /* also pins obj to a plain Array */
+        return 0;
+    ap = JS_VALUE_GET_OBJ(arr);
+    if (ap->class_id != JS_CLASS_ARRAY || !ap->fast_array || ap->holey ||
+        ap->u.array.count != 0 || !ap->extensible ||
+        JS_VALUE_GET_TAG(ap->prop[0].u.value) != JS_TAG_INT ||
+        JS_VALUE_GET_INT(ap->prop[0].u.value) != count)
+        return 0;
+    return js_arr_packed_copy_run(ctx, ap, sp, (uint32_t)start, (uint32_t)count);
+}
+
+/* Fills [start, end) of a packed array with `val`. Returns 1 filled, 0 when the range cannot stay
+   packed (a non-number, or holes before start: the caller takes the generic route), -1 out of
+   memory. The storage never moves unless the value widens the kind, which happens first. */
+static int js_arr_packed_fill(JSContext *ctx, JSObject *p, JSValueConst val,
+                              uint32_t start, uint32_t end)
+{
+    uint32_t i;
+    int32_t i32;
+    double d;
+
+    if (start > p->u.array.count || start > end)
+        return 0;                       /* indices count..start-1 would stay holes */
+    if (js_arr_packed_num_int(val, &i32)) {
+        /* fits the int32 kind, and an int32 fits the float64 kind */
+    } else if (js_arr_packed_num_double(val, &d)) {
+        if (p->arr_kind == JS_ARR_KIND_INT32 && js_arr_packed_widen(ctx, p) < 0)
+            return -1;
+    } else {
+        return 0;                       /* not a number: the caller unpacks */
+    }
+    for (i = start; i < end; i++) {
+        if (p->arr_kind == JS_ARR_KIND_INT32)
+            ((int32_t *)p->u.array.u.values_raw)[i] = i32;
+        else
+            ((double *)p->u.array.u.values_raw)[i] = js_arr_packed_num_int(val, &i32) ?
+                (double)i32 : d;
+    }
+    return 1;
+}
+
+/* Moves and replaces a run of a packed array in place: elements [start + del, count) move to
+   start + ins, then `ins` values are stored at start. Returns 1 done, 0 when a value does not fit
+   the kind (nothing touched), -1 out of memory. */
+static int js_arr_packed_splice(JSContext *ctx, JSObject *p, uint32_t start,
+                                uint32_t del, uint32_t ins, JSValueConst *items)
+{
+    uint32_t i, count = p->u.array.count, new_count;
+    size_t esz = js_arr_elem_size(p);
+    int32_t i32;
+    double d;
+    bool widen = false;
+
+    if (start + (uint64_t)del > count)
+        return 0;
+    new_count = count + ins - del;
+    if (new_count > (uint32_t)INT32_MAX)
+        return 0;
+    for (i = 0; i < ins; i++) {
+        if (js_arr_packed_num_int(items[i], &i32))
+            continue;
+        if (!js_arr_packed_num_double(items[i], &d))
+            return 0;
+        widen = true;
+    }
+    if (widen && p->arr_kind == JS_ARR_KIND_INT32 && js_arr_packed_widen(ctx, p) < 0)
+        return -1;
+    esz = js_arr_elem_size(p);
+    if (new_count > p->u.array.u1.size && js_arr_packed_reserve(ctx, p, new_count) < 0)
+        return -1;
+    if (count > start + del) {
+        memmove((char *)p->u.array.u.values_raw + (size_t)(start + ins) * esz,
+                (char *)p->u.array.u.values_raw + (size_t)(start + del) * esz,
+                (size_t)(count - (start + del)) * esz);
+    }
+    for (i = 0; i < ins; i++) {
+        if (!js_arr_packed_store_nomem(p, start + i, items[i]))
+            abort();                    /* every value fits the kind by the checks above */
+    }
+    p->u.array.count = new_count;
+    return 1;
+}
+
+/* unshift on a packed array: the elements move up by argc and the arguments are stored at 0.
+   Returns 1 done, 0 when a value does not fit the kind (nothing touched), -1 out of memory. */
+static int js_arr_packed_unshift(JSContext *ctx, JSObject *p, int argc,
+                                 JSValueConst *argv)
+{
+    uint32_t i, count = p->u.array.count, new_count = count + argc;
+    size_t esz;
+    int32_t i32;
+    double d;
+    bool widen = false;
+
+    if (new_count < count || new_count > (uint32_t)INT32_MAX)
+        return 0;
+    for (i = 0; i < (uint32_t)argc; i++) {
+        if (js_arr_packed_num_int(argv[i], &i32))
+            continue;
+        if (!js_arr_packed_num_double(argv[i], &d))
+            return 0;
+        widen = true;
+    }
+    if (widen && p->arr_kind == JS_ARR_KIND_INT32 && js_arr_packed_widen(ctx, p) < 0)
+        return -1;
+    esz = js_arr_elem_size(p);
+    if (new_count > p->u.array.u1.size && js_arr_packed_reserve(ctx, p, new_count) < 0)
+        return -1;
+    if (count > 0) {
+        memmove((char *)p->u.array.u.values_raw + (size_t)argc * esz,
+                p->u.array.u.values_raw, (size_t)count * esz);
+    }
+    for (i = 0; i < (uint32_t)argc; i++) {
+        if (!js_arr_packed_store_nomem(p, i, argv[i]))
+            abort();
+    }
+    p->u.array.count = new_count;
+    return 1;
+}
+
+/* Whether Symbol.isConcatSpreadable is untouched along p's whole prototype chain, so reading it can
+   answer only undefined and the spread decision for p is the plain `Array.isArray(p)` one. A Proxy or
+   any other exotic object in the chain is refused: its own traps can answer the read. */
+static bool js_concat_spread_is_default(JSContext *ctx, JSObject *p)
+{
+    JSProperty *pr;
+
+    for (;;) {
+        if (p->class_id == JS_CLASS_PROXY ||
+            ctx->rt->class_array[p->class_id].exotic != NULL)
+            return false;
+        if (find_own_property(&pr, p, JS_ATOM_Symbol_isConcatSpreadable) != NULL)
+            return false;
+        p = p->shape->proto;
+        if (p == NULL)
+            return true;
+    }
+}
+
+/* The widest packed kind and the element count of a concat of `obj` with argv[0..argc), when that
+   concat can be built as one packed array: obj and every argument are plain packed arrays of this
+   realm (default species) and none of them observes Symbol.isConcatSpreadable. False otherwise. */
+static bool js_concat_packed_extent(JSContext *ctx, JSValueConst obj, int argc,
+                                 JSValueConst *argv, int *kindp, int64_t *totalp)
+{
+    JSObject *p, *ap;
+    int kind = 0;
+    int64_t total = 0;
+    int i;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(obj);
+    if (p->class_id != JS_CLASS_ARRAY || !p->fast_array || JS_ARR_GENERIC(p) || p->holey)
+        return false;
+    if (!js_array_species_is_default(ctx, obj) || !js_concat_spread_is_default(ctx, p))
+        return false;
+    kind = p->arr_kind;
+    total = p->u.array.count;
+    for (i = 0; i < argc; i++) {
+        if (JS_VALUE_GET_TAG(argv[i]) != JS_TAG_OBJECT)
+            return false;
+        ap = JS_VALUE_GET_OBJ(argv[i]);
+        if (ap->class_id != JS_CLASS_ARRAY || !ap->fast_array || JS_ARR_GENERIC(ap) || ap->holey)
+            return false;
+        if (!js_concat_spread_is_default(ctx, ap))
+            return false;
+        if (ap->arr_kind > kind)
+            kind = ap->arr_kind;
+        total += ap->u.array.count;
+        if (total > INT32_MAX)
+            return false;
+    }
+    *kindp = kind;
+    *totalp = total;
+    return true;
+}
+
+/* Copies the whole of the packed array src into dst (packed), at *posp, converting an int32
+   element when dst is the float64 kind. */
+static int js_arr_packed_copy_into(JSContext *ctx, JSObject *dst, JSObject *src, uint32_t *posp)
+{
+    uint32_t i, n = *posp, len = src->u.array.count;
+    size_t esz = js_arr_elem_size(dst);
+
+    if (len == 0)
+        return 0;
+    if (dst->arr_kind == src->arr_kind) {
+        memcpy((char *)dst->u.array.u.values_raw + (size_t)n * esz,
+               src->u.array.u.values_raw, (size_t)len * esz);
+    } else {
+        const int32_t *sb = (const int32_t *)src->u.array.u.values_raw;
+        double *db = (double *)dst->u.array.u.values_raw;
+        assert(dst->arr_kind == JS_ARR_KIND_FLOAT64 && src->arr_kind == JS_ARR_KIND_INT32);
+        for (i = 0; i < len; i++)
+            db[n + i] = (double)sb[i];
+    }
+    *posp = n + len;
+    return 0;
+}
+
+/* The first (last) index at or after (at or before) `from` of a packed array's number equal to
+   `target`, or -1. `zero` selects SameValueZero (NaN matches NaN) instead of strict equality; -0 matches
+   +0 in both. A target that is not a number matches nothing: an array of numbers holds no other value. */
+static int64_t js_arr_packed_find(const JSObject *p, JSValueConst target, int64_t from, bool backward, bool zero)
+{
+    double t;
+    int64_t i, n = p->u.array.count;
+    if (!js_arr_packed_num_double(target, &t))
+        return -1;
+    if (p->arr_kind == JS_ARR_KIND_INT32) {
+        const int32_t *a = (const int32_t *)p->u.array.u.values_raw;
+        if (isnan(t))
+            return -1;
+        if (backward) {
+            for (i = from; i >= 0; i--)
+                if (i < n && (double)a[i] == t)
+                    return i;
+        } else {
+            for (i = from; i < n; i++)
+                if ((double)a[i] == t)
+                    return i;
+        }
+        return -1;
+    } else {
+        const double *a = (const double *)p->u.array.u.values_raw;
+        bool tn = isnan(t);
+        if (tn && !zero)
+            return -1;
+        if (backward) {
+            for (i = from; i >= 0; i--)
+                if (i < n && (tn ? isnan(a[i]) : a[i] == t))
+                    return i;
+        } else {
+            for (i = from; i < n; i++)
+                if (tn ? isnan(a[i]) : a[i] == t)
+                    return i;
+        }
+        return -1;
+    }
+}
