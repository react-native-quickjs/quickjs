+static int regvm_perm_of(int op, int out)
+{
+    static const int8_t dup[]      = { 0, 0 };
+    static const int8_t dup1[]     = { 0, 0, 1 };
+    static const int8_t dup2[]     = { 0, 1, 0, 1 };
+    static const int8_t dup3[]     = { 0, 1, 2, 0, 1, 2 };
+    static const int8_t insert2[]  = { 1, 0, 1 };
+    static const int8_t insert3[]  = { 2, 0, 1, 2 };
+    static const int8_t insert4[]  = { 3, 0, 1, 2, 3 };
+    static const int8_t perm3[]    = { 1, 0, 2 };
+    static const int8_t perm4[]    = { 2, 0, 1, 3 };
+    static const int8_t perm5[]    = { 3, 0, 1, 2, 4 };
+    static const int8_t rot3l[]    = { 1, 2, 0 };
+    static const int8_t rot3r[]    = { 2, 0, 1 };
+    static const int8_t rot4l[]    = { 1, 2, 3, 0 };
+    static const int8_t rot5l[]    = { 1, 2, 3, 4, 0 };
+    static const int8_t swap[]     = { 1, 0 };
+    static const int8_t swap2[]    = { 2, 3, 0, 1 };
