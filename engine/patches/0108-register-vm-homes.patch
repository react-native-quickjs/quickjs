+    case OP_dup1: map = dup1; n = countof(dup1); break;
+    case OP_dup2: map = dup2; n = countof(dup2); break;
+    case OP_dup3: map = dup3; n = countof(dup3); break;
+    case OP_insert2: map = insert2; n = countof(insert2); break;
+    case OP_insert3: map = insert3; n = countof(insert3); break;
+    case OP_insert4: map = insert4; n = countof(insert4); break;
+    case OP_perm3: map = perm3; n = countof(perm3); break;
+    case OP_perm4: map = perm4; n = countof(perm4); break;
+    case OP_perm5: map = perm5; n = countof(perm5); break;
+    case OP_rot3l: map = rot3l; n = countof(rot3l); break;
+    case OP_rot3r: map = rot3r; n = countof(rot3r); break;
+    case OP_rot4l: map = rot4l; n = countof(rot4l); break;
+    case OP_rot5l: map = rot5l; n = countof(rot5l); break;
