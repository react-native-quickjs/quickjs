Subject: Register bundles: no stack bytecode in memory

What this does
  Register bundles: no stack bytecode in memory.

Why we need it
  After the register code has its own line table and `argv_safe` scan, nothing in a non-AOT register build reads the stack bytecode after lowering; keeping it doubled the per-function code memory.

What it adds
  `js_create_function` no longer allocates/copies `byte_code_buf` under `QJS_REGVM && !QJS_AOT`; `argv_safe` comes from `regvm_scan_argv_safe` (the AOT/stack builds are untouched).

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index ebf975b..e98b401 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -67235,7 +67235,13 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
     closure_var_offset = function_size;
     function_size += fd->closure_var_count * sizeof(*fd->closure_var);
     byte_code_offset = function_size;
+#if QJS_REGVM && !QJS_AOT
+    /* A register build keeps no stack bytecode after lowering; the slot stays
+       in the struct, empty. args_captured/argv_safe come from the register
+       program below. */
+#else
     function_size += fd->byte_code.size;
+#endif
 #if QJS_REGVM
     regvm_offset = function_size;
     function_size += fd->regvm_len;
@@ -67296,12 +67302,21 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
     b->ic_count = fd->ic_count;
     b->ic_entries = JS_IC_ENTRIES;
 
+#if QJS_REGVM && !QJS_AOT
+    /* No stack bytecode: byte_code_buf stays NULL and byte_code_len 0; the
+       register program below is the only code this function has. */
+    b->byte_code_buf = NULL;
+    b->byte_code_len = 0;
+    js_free(ctx, fd->byte_code.buf);
+    fd->byte_code.buf = NULL;
+#else
     b->byte_code_buf = (void *)((uint8_t*)b + byte_code_offset);
     b->byte_code_len = fd->byte_code.size;
     memcpy(b->byte_code_buf, fd->byte_code.buf, fd->byte_code.size);
     js_scan_argv_safe(b);
     js_free(ctx, fd->byte_code.buf);
     fd->byte_code.buf = NULL;
+#endif
 
 #if QJS_REGVM
     if (fd->regvm_compiled) {
@@ -67324,14 +67339,21 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
         js_free(ctx, fd->regvm_code);
         fd->regvm_code = NULL;
         fd->regvm_len = 0;
-#if !defined(NDEBUG)
-        /* The register scan must agree with the stack scan js_scan_argv_safe
-           just ran on args_captured, the condition regvm_args_borrowable uses;
-           a debug build asserts it. argv_safe is not compared: the register
-           lowering drops dead argument stores, so it may be more permissive. */
-        assert(regvm_scan_argv_safe(b->regvm_code, b->regvm_len) ==
-               (b->args_captured == 0));
+        {
+            bool rs = regvm_scan_argv_safe(b->regvm_code, b->regvm_len);
+#if !defined(NDEBUG) && (QJS_AOT)
+            /* The stack scan js_scan_argv_safe ran must agree on
+               args_captured (only the AOT path has stack bytecode). */
+            assert(rs == (b->args_captured == 0));
+#endif
+#if QJS_REGVM && !QJS_AOT
+            /* No stack bytecode, so the register scan is the only source of
+               argv_safe. */
+            b->argv_safe = rs;
+#else
+            (void)rs;
 #endif
+        }
     }
 #endif
 
