+#define QJS_NAN_BOXING64 0
+#endif
+
+#if QJS_NAN_BOXING64 && JS_NAN_BOXING
+#error "JS_NAN_BOXING and QJS_NAN_BOXING64 are mutually exclusive"
+#endif
