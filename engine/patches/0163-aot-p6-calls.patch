+
+    if (!b->regvm_src_pc || b->regvm_len <= 0) {
+        snprintf(out, n, "?:?");
+        return;
+    }
+    j = regvm_off;
+    if (j >= b->regvm_len)
+        j = b->regvm_len - 1;
+    while (j >= 0 && b->regvm_src_pc[j] < 0)
+        j--;
+    if (j < 0) {
+        snprintf(out, n, "?:?");
+        return;
+    }
+    src_pc = b->regvm_src_pc[j];
+    line = find_line_num(NULL, b, (uint32_t)src_pc, &col);
+    snprintf(out, n, "%d:%d", line, col);
