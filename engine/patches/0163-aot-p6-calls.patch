+                               sf, b, local_buf, arg_buf, var_buf, stack_buf, sp, pc,
+                               0, 0);
+    *out = ret_val;
+    return JS_IsException(ret_val) ? -1 : 1;
+}
+
+/*
+ * Try to take the specialised C-call path for `callee(this, argv[0..na-1])`.
+ * `cproto` is the C prototype the profile saw at the site (-1 = any). Returns
+ * 1 with *out set, 0 to fall back to the step engine, or -1 on an exception.
+ * The f_f / f_f_f paths call the *bound* function pointer, so the identity
+ * guard is what keeps them sound when the callee register changes.
+ */
+int qjs_aot_call_c(JSContext *ctx, int site, int cproto, int na, JSValue callee,
+                   JSValue this_obj, JSValue *argv, JSValue *out)
+{
+    JSRuntime *rt = ctx->rt;
+    JSAotSite *e;
+    JSObject *p;
+    int bound;
+
+    if (JS_VALUE_GET_TAG(callee) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(callee);
+    if (p->class_id != JS_CLASS_C_FUNCTION)
+        return 0;
+    if (!aot_site_ensure(rt, (uint32_t)site))
+        return 0;
+    e = &rt->aot_sites[site];
+#ifdef AOT_MUT_SKIP_CALLEE_GUARD
+    /* Gate mutant (plan 8.4): accept whatever C function arrives at the site,
+       so the bound pointer goes stale and the wrong function is called. */
+    bound = (e->kind == 2);
+#else
+    bound = (e->kind == 2 && JS_VALUE_GET_OBJ(e->expect) == p);
+#endif
+    if (!bound) {
+        if (cproto >= 0 && (int)p->u.cfunc.cproto != cproto)
+            return 0;
+        aot_site_store(rt, e, 2, callee, (void *)p->u.cfunc.c_function.generic,
+                       (int)p->u.cfunc.magic, (int)p->u.cfunc.cproto);
+    }
+
+    if (e->cproto == JS_CFUNC_f_f && na == 1) {
+        double d1;
+#ifndef AOT_MUT_WRONG_REALM
+        if (p->u.cfunc.realm != ctx)
+            return 0;
+#endif
+        if (JS_ToFloat64(ctx, &d1, argv[0]))
+            return -1;
+        if (js_poll_interrupts(ctx))
+            return -1;
+        *out = js_number(((double (*)(double))e->cfn)(d1));
+        return 1;
+    }
+    if (e->cproto == JS_CFUNC_f_f_f && na == 2) {
+        double d1, d2;
+#ifndef AOT_MUT_WRONG_REALM
+        if (p->u.cfunc.realm != ctx)
+            return 0;
+#endif
+        if (JS_ToFloat64(ctx, &d1, argv[0]) || JS_ToFloat64(ctx, &d2, argv[1]))
+            return -1;
+        if (js_poll_interrupts(ctx))
+            return -1;
+        *out = js_number(((double (*)(double, double))e->cfn)(d1, d2));
+        return 1;
+    }
+    if (e->cproto == JS_CFUNC_generic || e->cproto == JS_CFUNC_generic_magic) {
+        JSValue rv;
+#ifdef AOT_MUT_NO_ARG_PAD
+        /* Gate mutant (plan 8.4): call with the raw argc instead of padding to
+           the function's declared length. A host function that reads a formal
+           parameter it was not passed sees stale register data. */
+        if (e->cproto == JS_CFUNC_generic) {
+            rv = ((JSCFunction *)e->cfn)(ctx, this_obj, na, argv);
+        } else
+#endif
+        {
+            rv = js_call_c_function(ctx, callee, this_obj, na, argv, 0);
+        }
+        if (JS_IsException(rv))
+            return -1;
+        *out = rv;
+        return 1;
+    }
+    return 0;
+}
+
+/*
+ * R1 (plan 8.0): fold a prototype property read to a bind-time value. Only a
+ * read that the PIC resolved to a prototype is foldable, because the epoch
+ * bump on a data write to a prototype is what keeps the folded value live. A
+ * miss (own property, shape change, no PIC, or the lazy-JSON marker) returns
+ * 0 and the caller runs the ordinary template, which refills the PIC.
+ *
+ * The fold is keyed on the receiver shape it came from as well as the epoch.
+ * The register PIC is two-way and its primary way can swap (a polymorphic
+ * method site alternates between, say, A.prototype.m and B.prototype.m, whose
+ * holders have the SAME shape because both are one-property prototypes). The
+ * epoch does not change on such a read, so without the receiver-shape key a
+ * fold of A.prototype.m would be served for a B receiver once the primary way
+ * had swapped to B. `e->rshape` is only ever compared, never dereferenced, so
+ * a stale entry cannot be followed.
+ */
+int qjs_aot_proto_fold(JSContext *ctx, JSRegRun *f, const void *pic, int site,
+                       JSValue recv, int pic_site, JSValue *out)
+{
+    JSRuntime *rt = ctx->rt;
+    const JSRegPIC *pe = &((const JSRegPIC *)pic)[pic_site];
+    JSAotSite *e;
+    JSObject *p, *holder;
+    JSValue v;
+
+    if (pe->kind != REG_PIC_PROTO)
+        return 0;
+    if (JS_VALUE_GET_TAG(recv) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(recv);
+    if (pe->shape != p->shape)
+        return 0;
+    holder = p->shape->proto;
+    if (!holder || !f->b->regvm_pic_holder ||
+        holder->shape != f->b->regvm_pic_holder[pic_site])
+        return 0;
+    if (!aot_site_ensure(rt, (uint32_t)site))
+        return 0;
+    e = &rt->aot_sites[site];
+    /* The epoch saturates at JS_IC_EPOCH_MAX: once it is pinned there, further
+       prototype writes are invisible, so a cached fold can no longer be
+       validated and must not hit (mirrors the engine's transition-fill stop at
+       saturation). Below the cap, an unchanged epoch proves the slot's value is
+       still the one we folded. */
+    if (e->kind == 3 && e->rshape == pe->shape &&
+        e->epoch == rt->ic_watchpoint_epoch &&
+        rt->ic_watchpoint_epoch < JS_IC_EPOCH_MAX) {
+        *out = js_dup(e->expect);
+        return 1;
+    }
+    v = *(JSValue *)((char *)holder->prop + pe->slot_off);
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_LAZY_JSON)
+        return 0;
+    /* Borrowed cache, exactly like js_gv_cell_peek: the holder's property slot
+       owns the value; the receiver-shape + holder-shape + epoch guard above
+       revalidates it on every hit, so no reference is taken here and the entry
+       is not freed at teardown (kind 3). */
+    e->expect = v;
+    e->kind = 3;
+    e->cfn = NULL;
+    e->rshape = pe->shape;
+    e->magic = 0;
+    e->cproto = 0;
+    e->epoch = rt->ic_watchpoint_epoch;
+    *out = js_dup(v);
+    return 1;
+}
