+/* ------------------------------------------------------------------------ */
+/* The prototype watchpoint epoch and the per-runtime AOT call-site          */
+/* bindings. The unit embeds one descriptor per call site; the engine keeps  */
+/* the bound callee (and its C prototype) per runtime.                       */
+/* ------------------------------------------------------------------------ */
+
+uint32_t qjs_aot_epoch(JSContext *ctx)
+{
+    return ctx->rt->ic_watchpoint_epoch;
+}
+
+/* Borrowed bound value for a site, or JS_UNDEFINED when unbound. */
+JSValue qjs_aot_site_expect(JSContext *ctx, int site)
+{
+    JSRuntime *rt = ctx->rt;
+
+    if ((uint32_t)site < rt->aot_site_count)
+        return rt->aot_sites[site].expect;
+    return JS_UNDEFINED;
+}
+
+static int aot_site_ensure(JSRuntime *rt, uint32_t site)
+{
+    JSAotSite *ns;
+    uint32_t i, old = rt->aot_site_count;
+
+    if (site < old)
+        return 1;
+    ns = js_realloc_rt(rt, rt->aot_sites, (size_t)(site + 1) * sizeof(*ns));
+    if (!ns)
+        return 0;
+    rt->aot_sites = ns;
+    for (i = old; i <= site; i++) {
+        ns[i].expect = JS_UNDEFINED;
+        ns[i].kind = 0;
+        ns[i].cfn = NULL;
+        ns[i].rshape = NULL;
+        ns[i].magic = 0;
+        ns[i].cproto = 0;
+        ns[i].epoch = 0;
+        memset(ns[i].digest, 0, sizeof(ns[i].digest));
+    }
+    rt->aot_site_count = site + 1;
+    return 1;
+}
+
+static void aot_site_store(JSRuntime *rt, JSAotSite *e, int kind, JSValue v,
+                           void *cfn, int magic, int cproto)
+{
+    JSValue old = e->expect;
+
+    e->expect = JS_DupValueRT(rt, v);
+    e->kind = (uint8_t)kind;
+    e->cfn = cfn;
+    e->magic = (uint16_t)magic;
+    e->cproto = (uint8_t)cproto;
+    e->epoch = rt->ic_watchpoint_epoch;
+    JS_FreeValueRT(rt, old);
+}
+
+/* Direct compiled call: when the callee is compiled into this unit, build its
+   frame here with JS_CallInternal's no-copy-arguments layout and hand it to
+   the register interpreter. Only for a non-lazy JS_FUNC_NORMAL body with
+   uncaptured arguments and argc >= arg_count. Returns 1 with an owned *out, 0
+   to fall back to the step engine, -1 on exception. */
+int qjs_aot_call_b(JSContext *caller_ctx, int na, JSValue callee,
+                   JSValue this_obj, JSValue *argv, JSValue *out)
+{
+    JSRuntime *rt = caller_ctx->rt;
+    JSObject *p;
+    JSFunctionBytecode *b;
+    JSStackFrame sf_s, *sf = &sf_s;
+    JSValue *local_buf, *var_buf, *stack_buf, *arg_buf, *sp;
+    uint8_t *pc;
+    size_t alloca_size;
+    int i;
+    JSValue ret_val;
+
+    if (JS_VALUE_GET_TAG(callee) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(callee);
+    if (p->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return 0;
+    b = p->u.func.function_bytecode;
+    if (b->aot_fn == NULL || b->is_lazy || b->lazy_failed)
+        return 0;
+    if (b->func_kind != JS_FUNC_NORMAL)
+        return 0;
+    if (b->args_captured || na < b->arg_count)
+        return 0;
+    if (js_poll_interrupts(caller_ctx))
+        return -1;
+    alloca_size = sizeof(JSValue) * (b->var_count + b->regvm_reg_count + REGVM_HS) +
+        sizeof(JSVarRef *) * b->var_ref_count +
+        sizeof(JSRegCtl) * b->regvm_ctl_count;
+    if (js_check_stack_overflow(rt, alloca_size)) {
+        JS_ThrowStackOverflow(caller_ctx);
+        return -1;
+    }
+    sf->is_strict_mode = b->is_strict_mode;
+    sf->is_constructor = false;
+    arg_buf = argv;
+    sf->arg_count = na;
+    sf->cur_func = unsafe_unconst(callee);
+    local_buf = alloca(alloca_size);
+    var_buf = local_buf;
+    sf->var_buf = var_buf;
+    sf->arg_buf = arg_buf;
+    for (i = 0; i < b->var_count; i++)
+        var_buf[i] = JS_UNDEFINED;
+    stack_buf = var_buf + b->var_count;
+    sf->var_refs = (JSVarRef **)(stack_buf + b->regvm_reg_count + REGVM_HS);
+    sf->var_ref_count = b->var_ref_count;
+    for (i = 0; i < b->var_ref_count; i++)
+        sf->var_refs[i] = NULL;
+    sf->cur_gc_obj = NULL;
+    REGVM_SET_ROOT(sf, stack_buf, b->regvm_reg_count + REGVM_HS - 1);
+    sp = stack_buf;
+    pc = b->byte_code_buf;
+    sf->cur_pc = NULL;
+    sf->prev_frame = rt->current_stack_frame;
+    rt->current_stack_frame = sf;
+    ret_val = js_regvm_execute(caller_ctx, callee, this_obj, JS_UNDEFINED, na, argv,
+                               sf, b, local_buf, arg_buf, var_buf, stack_buf, sp, pc,
+                               0, 0);
+    *out = ret_val;
+    return JS_IsException(ret_val) ? -1 : 1;
+}
+
+/* The specialised C-call path for `callee(this, argv[0..na-1])`. `cproto` is
+   the C prototype the profile saw (-1 = any). Returns 1 with *out, 0 to fall
+   back, -1 on exception. The f_f / f_f_f paths call the bound pointer, so the
+   identity guard keeps them sound. */
+int qjs_aot_call_c(JSContext *ctx, int site, int cproto, int na, JSValue callee,
+                   JSValue this_obj, JSValue *argv, JSValue *out)
+{
+    JSRuntime *rt = ctx->rt;
+    JSAotSite *e;
+    JSObject *p;
+    int bound;
+
+    if (JS_VALUE_GET_TAG(callee) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(callee);
+    if (p->class_id != JS_CLASS_C_FUNCTION)
+        return 0;
+    if (!aot_site_ensure(rt, (uint32_t)site))
+        return 0;
+    e = &rt->aot_sites[site];
+#ifdef AOT_MUT_SKIP_CALLEE_GUARD
+    /* Gate mutant: accept any C function at the site, so the bound pointer goes
+       stale. */
+    bound = (e->kind == 2);
+#else
+    bound = (e->kind == 2 && JS_VALUE_GET_OBJ(e->expect) == p);
+#endif
+    if (!bound) {
+        if (cproto >= 0 && (int)p->u.cfunc.cproto != cproto)
+            return 0;
+        aot_site_store(rt, e, 2, callee, (void *)p->u.cfunc.c_function.generic,
+                       (int)p->u.cfunc.magic, (int)p->u.cfunc.cproto);
+    }
+
+    if (e->cproto == JS_CFUNC_f_f && na == 1) {
+        double d1;
+#ifndef AOT_MUT_WRONG_REALM
+        if (p->u.cfunc.realm != ctx)
+            return 0;
+#endif
+        if (JS_ToFloat64(ctx, &d1, argv[0]))
+            return -1;
+        if (js_poll_interrupts(ctx))
+            return -1;
+        *out = js_number(((double (*)(double))e->cfn)(d1));
+        return 1;
+    }
+    if (e->cproto == JS_CFUNC_f_f_f && na == 2) {
+        double d1, d2;
+#ifndef AOT_MUT_WRONG_REALM
+        if (p->u.cfunc.realm != ctx)
+            return 0;
+#endif
+        if (JS_ToFloat64(ctx, &d1, argv[0]) || JS_ToFloat64(ctx, &d2, argv[1]))
+            return -1;
+        if (js_poll_interrupts(ctx))
+            return -1;
+        *out = js_number(((double (*)(double, double))e->cfn)(d1, d2));
+        return 1;
+    }
+    if (e->cproto == JS_CFUNC_generic || e->cproto == JS_CFUNC_generic_magic) {
+        JSValue rv;
+#ifdef AOT_MUT_NO_ARG_PAD
+        /* Gate mutant: call with the raw argc instead of padding to the
+           declared length. */
+        if (e->cproto == JS_CFUNC_generic) {
+            rv = ((JSCFunction *)e->cfn)(ctx, this_obj, na, argv);
+        } else
+#endif
+        {
+            rv = js_call_c_function(ctx, callee, this_obj, na, argv, 0);
+        }
+        if (JS_IsException(rv))
+            return -1;
+        *out = rv;
+        return 1;
+    }
+    return 0;
+}
+
+/*
+ * Fold a prototype property read to a bind-time value. Only a read the PIC
+ * resolved to a prototype folds: the epoch bump on a prototype data write
+ * keeps the value valid. A miss returns 0 and the ordinary template refills
+ * the PIC.
+ *
+ * The fold is also keyed on the receiver shape: the PIC's primary way can swap
+ * between holders with the same shape (two one-property prototypes) without
+ * an epoch change. `e->rshape` is only compared, never dereferenced.
+ */
+int qjs_aot_proto_fold(JSContext *ctx, JSRegRun *f, const void *pic, int site,
+                       JSValue recv, int pic_site, JSValue *out)
+{
+    JSRuntime *rt = ctx->rt;
+    const JSRegPIC *pe = &((const JSRegPIC *)pic)[pic_site];
+    JSAotSite *e;
+    JSObject *p, *holder;
+    JSValue v;
+
+    if (pe->kind != REG_PIC_PROTO)
+        return 0;
+    if (JS_VALUE_GET_TAG(recv) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(recv);
+    if (pe->shape != p->shape)
+        return 0;
+    holder = p->shape->proto;
+    if (!holder || !f->b->regvm_pic_holder ||
+        holder->shape != f->b->regvm_pic_holder[pic_site])
+        return 0;
+    if (!aot_site_ensure(rt, (uint32_t)site))
+        return 0;
+    e = &rt->aot_sites[site];
+    /* The epoch saturates at JS_IC_EPOCH_MAX, after which writes are invisible,
+       so a fold can no longer hit. Below the cap an unchanged epoch proves the
+       value. */
+    if (e->kind == 3 && e->rshape == pe->shape &&
+        e->epoch == rt->ic_watchpoint_epoch &&
+        rt->ic_watchpoint_epoch < JS_IC_EPOCH_MAX) {
+        *out = js_dup(e->expect);
+        return 1;
+    }
+    v = *(JSValue *)((char *)holder->prop + pe->slot_off);
+    if (JS_VALUE_GET_TAG(v) == JS_TAG_LAZY_JSON)
+        return 0;
+    /* Borrowed, like js_gv_cell_peek: the holder's slot owns the value and the
+       guards revalidate it on every hit, so the entry takes no reference. */
+    e->expect = v;
+    e->kind = 3;
+    e->cfn = NULL;
+    e->rshape = pe->shape;
+    e->magic = 0;
+    e->cproto = 0;
+    e->epoch = rt->ic_watchpoint_epoch;
+    *out = js_dup(v);
+    return 1;
+}
 #endif /* QJS_AOT */
 
