+    pf->reg_n = b->regvm_reg_count > 0 ? b->regvm_reg_count : 0;
+    pf->nsites = b->regvm_pic_count;
+    if (pf->loop_n > 0) {
+        pf->loop_iters = js_mallocz_rt(rt, sizeof(uint32_t) * (size_t)pf->loop_n);
+        if (!pf->loop_iters)
+            goto fail;
+    }
+    if (pf->reg_n > 0) {
+        pf->reg_types = js_mallocz_rt(rt, sizeof(uint16_t) * (size_t)pf->reg_n);
+        if (!pf->reg_types)
