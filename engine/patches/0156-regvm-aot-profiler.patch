+    }
+    if (pf->nsites > 0) {
+        pf->sites = js_mallocz_rt(rt, sizeof(JSAotProfSite) * (size_t)pf->nsites);
+        if (!pf->sites)
+            goto fail;
+    }
+    b->aot_prof = pf;
+    return pf;
+fail:
+    js_free_rt(rt, pf->loop_iters);
+    js_free_rt(rt, pf->reg_types);
+    js_free_rt(rt, pf->sites);
+    js_free_rt(rt, pf);
+    return NULL;
+}
+
+static int js_aot_prof_enter(JSFunctionBytecode *b)
+{
+    JSAotProfFunc *pf = js_aot_prof_ensure(b->realm->rt, b);
+
+    if (!pf)
+        return 0;
+    pf->entries++;
+    return 1;
+}
+
+static void js_aot_prof_op(JSFunctionBytecode *b, uint8_t *rpc, uint8_t **pprev)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+
+    if (unlikely(!pf)) {
+        pf = js_aot_prof_ensure(b->realm->rt, b);
+        if (!pf) {
+            *pprev = rpc;
+            return;
+        }
+    }
+    pf->ops++;
+    if (*pprev && rpc < *pprev) {
+        int off = (int)(rpc - b->regvm_code);
+        if (off >= 0 && off < pf->loop_n)
+            pf->loop_iters[off]++;
+    }
+    *pprev = rpc;
+}
+
+static void js_aot_prof_pic(JSFunctionBytecode *b, int site, JSShape *shape)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+    JSAotProfSite *s;
+    uint8_t i;
+
+    if (!pf || site < 0 || site >= pf->nsites)
+        return;
+    s = &pf->sites[site];
+    s->count++;
+    for (i = 0; i < s->nshapes; i++) {
+        if (s->shapes[i] == shape) {
+            s->shape_hits[i]++;
+            return;
+        }
+    }
+    if (s->nshapes < 4) {
+        s->shapes[s->nshapes] = shape;
+        s->shape_hits[s->nshapes] = 1;
+        s->nshapes++;
+    }
+}
+
+static void js_aot_prof_reg(JSFunctionBytecode *b, int reg, JSValue v)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+    uint16_t bit;
+
+    if (reg < 0 || !pf || reg >= pf->reg_n)
+        return;
+    bit = aot_tag_class(v);
+    pf->reg_types[reg] |= bit;
+}
+
+static JSAotProfCall *aot_call_slot(JSRuntime *rt, JSAotProfFunc *pf, uint32_t pc)
+{
+    JSAotProfCall *c;
+    int i;
+
+    for (i = 0; i < pf->ncalls; i++)
+        if (pf->calls[i].pc == pc)
+            return &pf->calls[i];
+    if (pf->ncalls == pf->calls_cap) {
+        int nc = pf->calls_cap ? pf->calls_cap * 2 : 16;
+        JSAotProfCall *n = js_realloc_rt(rt, pf->calls, sizeof(JSAotProfCall) * (size_t)nc);
+        if (!n)
+            return NULL;
+        memset(n + pf->calls_cap, 0,
+               sizeof(JSAotProfCall) * (size_t)(nc - pf->calls_cap));
+        pf->calls = n;
+        pf->calls_cap = nc;
+    }
+    c = &pf->calls[pf->ncalls++];
+    memset(c, 0, sizeof(*c));
+    c->pc = pc;
+    c->argc_min = 255;
+    return c;
+}
+
+static void js_aot_prof_call(JSContext *ctx, JSFunctionBytecode *b, uint32_t pc,
+                             JSValue fn, int argc)
+{
+    JSRuntime *rt = ctx->rt;
+    JSAotProfFunc *pf = js_aot_prof_ensure(rt, b);
+    JSAotProfCall *c;
+    JSAotProfCallee *ce = NULL;
+    uint8_t kind = 3, digest[16] = { 0 };
+    void *cfn = NULL;
+    int16_t magic = 0;
+    uint8_t cproto = 0;
+    int i;
+
+    if (!pf)
+        return;
+    c = aot_call_slot(rt, pf, pc);
+    if (!c)
+        return;
+    c->count++;
+    if (argc < c->argc_min)
+        c->argc_min = (uint8_t)argc;
+    if (argc > c->argc_max)
+        c->argc_max = (uint8_t)argc;
+
+    if (JS_VALUE_GET_TAG(fn) == JS_TAG_OBJECT) {
+        JSObject *o = JS_VALUE_GET_OBJ(fn);
+        int cls = o->class_id;
+        if (cls == JS_CLASS_BYTECODE_FUNCTION ||
+            cls == JS_CLASS_GENERATOR_FUNCTION ||
+            cls == JS_CLASS_ASYNC_FUNCTION ||
+            cls == JS_CLASS_ASYNC_GENERATOR_FUNCTION) {
+            kind = 1;
+            js_aot_digest(o->u.func.function_bytecode, digest);
+        } else if (cls == JS_CLASS_C_FUNCTION) {
+            kind = 2;
+            cfn = (void *)o->u.cfunc.c_function.generic;
+            magic = o->u.cfunc.magic;
+            cproto = o->u.cfunc.cproto;
+        }
+    }
+    for (i = 0; i < c->ncallee; i++) {
+        JSAotProfCallee *cc = &c->callee[i];
+        if (cc->kind != kind)
+            continue;
+        if (kind == 1 && memcmp(cc->digest, digest, 16) != 0)
+            continue;
+        if (kind == 2 && cc->cfn != cfn)
+            continue;
+        ce = cc;
+        break;
+    }
+    if (!ce && c->ncallee < 4) {
+        ce = &c->callee[c->ncallee++];
+        memset(ce, 0, sizeof(*ce));
+        ce->kind = kind;
+        memcpy(ce->digest, digest, 16);
+        ce->cfn = cfn;
+        ce->magic = magic;
+        ce->cproto = cproto;
+    }
+    if (ce)
+        ce->hits++;
+}
+
+static void js_aot_prof_free(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+
+    if (!pf)
+        return;
+    js_free_rt(rt, pf->loop_iters);
+    js_free_rt(rt, pf->reg_types);
+    js_free_rt(rt, pf->sites);
+    js_free_rt(rt, pf->calls);
+    js_free_rt(rt, pf);
+    b->aot_prof = NULL;
+}
+
+static void aot_digest_hex(const uint8_t d[16], char out[33])
+{
+    static const char *hex = "0123456789abcdef";
+    int i;
+    for (i = 0; i < 16; i++) {
+        out[i * 2] = hex[d[i] >> 4];
+        out[i * 2 + 1] = hex[d[i] & 15];
+    }
+    out[32] = '\0';
+}
+
+static void aot_type_str(uint16_t bits, char *out, int n)
+{
+    static const struct { uint16_t bit; const char *name; } tab[] = {
+        { AOT_TYPE_FLOAT, "float" }, { AOT_TYPE_INT, "int" },
+        { AOT_TYPE_OBJECT, "object" }, { AOT_TYPE_STRING, "string" },
+        { AOT_TYPE_BOOL, "bool" }, { AOT_TYPE_UNDEF, "undef" },
+        { AOT_TYPE_BIGINT, "bigint" }, { AOT_TYPE_OTHER, "other" },
+    };
+    int i, off = 0;
+    out[0] = '\0';
+    for (i = 0; i < (int)(sizeof(tab) / sizeof(tab[0])); i++) {
+        if (bits & tab[i].bit)
+            off += snprintf(out + off, (size_t)(n - off), "%s%s",
+                            off ? "|" : "", tab[i].name);
+    }
+    if (!off)
+        snprintf(out, (size_t)n, "none");
+}
+
+#if !defined(_WIN32)
+static int aot_phdr_base(struct dl_phdr_info *info, size_t size, void *data)
+{
+    (void)size;
+    *(uintptr_t *)data = (uintptr_t)info->dlpi_addr;
+    return 1; /* first entry is the main executable */
+}
+#endif
+
+/* Name the C function at `p`. dladdr only sees dynamic symbols, so fall back
+   to the nearest preceding STT_FUNC in /proc/self/exe's .symtab. Profile
+   builds are linked -no-pie. */
+static const char *aot_sym_name(JSRuntime *rt, void *p, char *buf, int n)
+{
+#if !defined(_WIN32)
+    Dl_info di;
+    unsigned char *img;
+    Elf64_Ehdr *eh;
+    Elf64_Shdr *sh;
+    Elf64_Sym *sym = NULL, *best = NULL;
+    const char *str = NULL;
+    uintptr_t base = 0, off, bestv = 0;
+    FILE *fp;
+    long fsz;
+    size_t i, nsym = 0;
+    int have_best = 0;
+
+    if (!p)
+        return NULL;
+    if (dladdr(p, &di) && di.dli_sname) {
+        snprintf(buf, (size_t)n, "%s", di.dli_sname);
+        return buf;
+    }
+    dl_iterate_phdr(aot_phdr_base, &base);
+    fp = fopen("/proc/self/exe", "rb");
+    if (!fp)
+        return NULL;
+    if (fseek(fp, 0, SEEK_END) != 0 || (fsz = ftell(fp)) <= 0 ||
+        fseek(fp, 0, SEEK_SET) != 0) {
+        fclose(fp);
+        return NULL;
+    }
+    img = (unsigned char *)js_malloc_rt(rt, (size_t)fsz);
+    if (!img) {
+        fclose(fp);
+        return NULL;
+    }
+    if (fread(img, 1, (size_t)fsz, fp) != (size_t)fsz) {
+        fclose(fp);
+        js_free_rt(rt, img);
+        return NULL;
+    }
+    fclose(fp);
+    eh = (Elf64_Ehdr *)img;
+    if (memcmp(eh->e_ident, ELFMAG, SELFMAG) != 0 ||
+        eh->e_shoff == 0 || eh->e_shnum == 0 ||
+        eh->e_shoff + (uint64_t)eh->e_shnum * eh->e_shentsize > (uint64_t)fsz) {
+        js_free_rt(rt, img);
+        return NULL;
+    }
+    sh = (Elf64_Shdr *)(img + eh->e_shoff);
+    for (i = 0; i < eh->e_shnum; i++) {
+        if (sh[i].sh_type == SHT_SYMTAB && sh[i].sh_entsize &&
+            sh[i].sh_link < eh->e_shnum) {
+            sym = (Elf64_Sym *)(img + sh[i].sh_offset);
+            nsym = sh[i].sh_size / sh[i].sh_entsize;
+            str = (const char *)(img + sh[sh[i].sh_link].sh_offset);
+            break;
+        }
+    }
+    off = (uintptr_t)p - base;
+    if (sym && str) {
+        for (i = 0; i < nsym; i++) {
+            if (ELF64_ST_TYPE(sym[i].st_info) != STT_FUNC)
+                continue;
+            if (sym[i].st_value <= off && sym[i].st_value != 0 &&
+                (!have_best || sym[i].st_value > bestv)) {
+                best = &sym[i];
+                bestv = sym[i].st_value;
+                have_best = 1;
+            }
+        }
+    }
+    if (have_best && str + best->st_name < (const char *)img + fsz) {
+        snprintf(buf, (size_t)n, "%s", str + best->st_name);
+        js_free_rt(rt, img);
+        return buf;
+    }
+    js_free_rt(rt, img);
+#else
+    (void)rt; (void)p; (void)buf; (void)n;
+#endif
+    return NULL;
+}
+
+static void aot_dump_one(FILE *f, JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSAotProfFunc *pf = b->aot_prof;
+    uint8_t dg[16];
+    char dgt[33];
+    char name[256], file[256];
+    int i, j;
+
+    if (!pf || pf->ops == 0)
+        return;
+    js_aot_digest(b, dg);
+    aot_digest_hex(dg, dgt);
+    JS_AtomGetStrRT(rt, name, sizeof(name), b->func_name);
+    JS_AtomGetStrRT(rt, file, sizeof(file), b->filename);
+    fprintf(f, "F %s name=%s file=%s:%d ops=%llu entries=%u len=%d\n",
+            dgt, name, file, b->line_num,
+            (unsigned long long)pf->ops, pf->entries, b->regvm_len);
+    for (i = 0; i < pf->loop_n; i++)
+        if (pf->loop_iters[i])
+            fprintf(f, "L %s pc=%d iters=%u\n", dgt, i, pf->loop_iters[i]);
+    for (i = 0; i < pf->reg_n; i++) {
+        if (pf->reg_types[i]) {
+            char ts[128];
+            aot_type_str(pf->reg_types[i], ts, sizeof(ts));
+            fprintf(f, "R %s reg=%d types=%s\n", dgt, i, ts);
+        }
+    }
+    for (i = 0; i < pf->nsites; i++) {
+        JSAotProfSite *s = &pf->sites[i];
+        if (!s->count)
+            continue;
+        fprintf(f, "S %s site=%d count=%u shapes=%u", dgt, i, s->count, s->nshapes);
+        for (j = 0; j < s->nshapes; j++)
+            fprintf(f, " shape%d=%p hits=%u", j, (void *)s->shapes[j],
+                    s->shape_hits[j]);
+        fputc('\n', f);
+    }
+    for (i = 0; i < pf->ncalls; i++) {
+        JSAotProfCall *c = &pf->calls[i];
+        if (!c->count)
+            continue;
+        for (j = 0; j < c->ncallee; j++) {
+            JSAotProfCallee *ce = &c->callee[j];
+            fprintf(f, "C %s pc=%u count=%u argc=%u..%u ", dgt, c->pc, c->count,
+                    c->argc_min == 255 ? 0 : c->argc_min, c->argc_max);
+            if (ce->kind == 1) {
+                char cd[33];
+                aot_digest_hex(ce->digest, cd);
+                fprintf(f, "callee=bc:%s", cd);
+            } else if (ce->kind == 2) {
+                char sbuf[128];
+                const char *sn = aot_sym_name(rt, ce->cfn, sbuf, sizeof(sbuf));
+                fprintf(f, "callee=c:%s:fn=%p:magic=%d:cproto=%u",
+                        sn ? sn : "?", ce->cfn, ce->magic, ce->cproto);
+            } else {
+                fprintf(f, "callee=other");
+            }
+            fprintf(f, " hits=%u\n", ce->hits);
+        }
+    }
+}
+
+void js_aot_prof_dump(JSRuntime *rt)
+{
+    const char *out = getenv("QJS_AOT_PROFILE_OUT");
+    FILE *f = stderr;
+    struct list_head *el;
+
+    if (out && out[0]) {
+        f = fopen(out, "w");
+        if (!f)
+            f = stderr;
+    }
+    fprintf(f, "qjsprof 1 abi=%u\n", QJS_AOT_ABI);
+    list_for_each(el, &rt->gc_obj_list) {
+        JSGCObjectHeader *gp = list_entry(el, JSGCObjectHeader, link);
+        if (JS_GC_TYPE(gp) == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE)
+            aot_dump_one(f, rt, (JSFunctionBytecode *)gp);
+    }
+    list_for_each(el, &rt->gc_notrace_list) {
+        JSGCObjectHeader *gp = list_entry(el, JSGCObjectHeader, link);
+        if (JS_GC_TYPE(gp) == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE)
+            aot_dump_one(f, rt, (JSFunctionBytecode *)gp);
+    }
+    if (f != stderr)
+        fclose(f);
+}
+#endif /* QJS_AOT_PROFILE */
