+/* ------------------------------------------------------------------------ */
+/* AOT profiler implementation.                                              */
+/* ------------------------------------------------------------------------ */
+
+static void aot_hash_bytes(uint64_t *h0, uint64_t *h1, const void *p, size_t n)
+{
+    const uint8_t *q = p;
+    uint64_t a = *h0, b = *h1;
+    size_t i;
+    for (i = 0; i < n; i++) {
+        a ^= q[i];
+        a *= 0x100000001B3ULL;
+        b += (uint64_t)q[i] + 0x9E3779B97F4A7C15ULL + (b << 6) + (b >> 2);
+    }
+    *h0 = a;
+    *h1 = b;
+}
+
+static void aot_hash_u32(uint64_t *h0, uint64_t *h1, uint32_t v)
+{
+    aot_hash_bytes(h0, h1, &v, 4);
+}
+
+static void aot_hash_u64(uint64_t *h0, uint64_t *h1, uint64_t v)
+{
+    aot_hash_bytes(h0, h1, &v, 8);
+}
+
+static void aot_hash_str(uint64_t *h0, uint64_t *h1, const char *s)
+{
+    uint64_t n = s ? (uint64_t)strlen(s) : 0;
+    aot_hash_u64(h0, h1, n);
+    if (s)
+        aot_hash_bytes(h0, h1, s, (size_t)n);
+}
+
+/* Hash the register program with atom operands replaced by their strings, so
+   the digest is independent of interning order. */
+static void aot_digest_code(uint64_t *h0, uint64_t *h1, JSFunctionBytecode *b)
+{
+    const uint8_t *code = b->regvm_code;
+    int len = b->regvm_len, p = 0;
+    JSRuntime *rt = b->realm ? b->realm->rt : NULL;
+    char buf[256];
+
+    while (p < len) {
+        int op = code[p];
+        const char *fmt;
+        int q, m, kind = -1;
+
+        if (op <= 0 || op >= ROP_COUNT) {
+            aot_hash_u32(h0, h1, 0xdeadbeefu);
+            break;
+        }
+        fmt = regvm_rop_fmt[op];
+        if (!fmt) {
+            aot_hash_u32(h0, h1, 0xbeefdeadu);
+            break;
+        }
+        aot_hash_u32(h0, h1, (uint32_t)op);
+        q = p + 1;
+        for (m = 0; fmt[m]; m++) {
+            int need, v, nar = regvm_rop_narrow((uint16_t)op);
+
+            switch (fmt[m]) {
+            case 'r': need = nar ? 1 : 2; break;
+            case 'i': case 'b': need = 1; break;
+            case 'u': case 's': need = 2; break;
+            case 'I': case 'c': case 'a': need = 4; break;
+            case 't': need = nar ? 1 : 4; break;
+            default: need = 0; break;
+            }
+            if (need == 0 || q + need > len)
+                goto done;
+            if (need == 4)
+                v = (int)((uint32_t)code[q] | ((uint32_t)code[q + 1] << 8) |
+                          ((uint32_t)code[q + 2] << 16) | ((uint32_t)code[q + 3] << 24));
+            else if (need == 2)
+                v = code[q] | (code[q + 1] << 8);
+            else
+                v = code[q];
+            if (fmt[m] == 'r') {
+                aot_hash_u32(h0, h1, (uint32_t)((v >> 4) & 0xfff));
+            } else if (fmt[m] == 'a' ||
+                       ((op == ROP_load_const || op == ROP_binary_cpool) &&
+                        fmt[m] == 'c' && kind == REG_CONST_ATOM)) {
+                if (rt)
+                    JS_AtomGetStrRT(rt, buf, sizeof(buf), (JSAtom)v);
+                else
+                    buf[0] = '\0';
+                aot_hash_str(h0, h1, buf);
+            } else {
+                aot_hash_u32(h0, h1, (uint32_t)v);
+                if (fmt[m] == 'b')
+                    kind = v;
+            }
+            q += need;
+        }
+        p = q;
+    }
+done:
+    return;
+}
+
+static void js_aot_digest_depth(JSFunctionBytecode *b, uint8_t out[16], int depth)
+{
+    uint64_t h0 = 0x9E3779B97F4A7C15ULL, h1 = 0xC2B2AE3D27D4EB4FULL;
+    JSContext *ctx = b->realm;
+    uint32_t flags;
+    int i;
+
+    aot_hash_u32(&h0, &h1, QJS_AOT_ABI);
+    aot_hash_u32(&h0, &h1, b->regvm_len > 0 ? (uint32_t)b->regvm_len : 0);
+    if (b->regvm_code && b->regvm_len > 0)
+        aot_digest_code(&h0, &h1, b);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->regvm_reg_count);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->regvm_ctl_count);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->regvm_pic_count);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->arg_count);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->var_count);
+    aot_hash_u32(&h0, &h1, (uint32_t)b->defined_arg_count);
+
+    flags = (b->is_strict_mode ? 1u : 0) | (b->has_prototype ? 2u : 0) |
+            (b->need_home_object ? 4u : 0) | ((uint32_t)(b->func_kind & 3) << 3) |
+            (b->new_target_allowed ? 0x20u : 0) |
+            (b->super_call_allowed ? 0x40u : 0) |
+            (b->super_allowed ? 0x80u : 0) |
+            (b->arguments_allowed ? 0x100u : 0);
+    aot_hash_u32(&h0, &h1, flags);
+
+    aot_hash_u32(&h0, &h1, (uint32_t)b->cpool_count);
+    for (i = 0; i < b->cpool_count; i++) {
+        JSValue v = b->cpool[i];
+        int tag = JS_VALUE_GET_TAG(v);
+
+        aot_hash_u32(&h0, &h1, (uint32_t)tag);
+        switch (tag) {
+        case JS_TAG_INT:
+            aot_hash_u32(&h0, &h1, (uint32_t)JS_VALUE_GET_INT(v));
+            break;
+        case JS_TAG_FLOAT64: {
+            double d = JS_VALUE_GET_FLOAT64(v);
+            uint64_t bits;
+            memcpy(&bits, &d, 8);
+            aot_hash_u64(&h0, &h1, bits);
+            break;
+        }
+        case JS_TAG_STRING:
+        case JS_TAG_STRING_ROPE: {
+            size_t slen = 0;
+            const char *s = ctx ? JS_ToCStringLen(ctx, &slen, v) : NULL;
+            aot_hash_u64(&h0, &h1, (uint64_t)slen);
+            if (s) {
+                aot_hash_bytes(&h0, &h1, s, slen);
+                JS_FreeCString(ctx, s);
+            }
+            break;
+        }
+        case JS_TAG_OBJECT: {
+            JSObject *o = JS_VALUE_GET_OBJ(v);
+            int cls = o->class_id;
+            aot_hash_u32(&h0, &h1, (uint32_t)cls);
+            if (depth < 4 && o->u.func.function_bytecode &&
+                (cls == JS_CLASS_BYTECODE_FUNCTION ||
+                 cls == JS_CLASS_GENERATOR_FUNCTION ||
+                 cls == JS_CLASS_ASYNC_FUNCTION ||
+                 cls == JS_CLASS_ASYNC_GENERATOR_FUNCTION)) {
+                uint8_t sub[16];
+                js_aot_digest_depth(o->u.func.function_bytecode, sub, depth + 1);
+                aot_hash_bytes(&h0, &h1, sub, 16);
+            }
+            break;
+        }
+        default:
+            break;
+        }
+    }
+
+    aot_hash_u32(&h0, &h1, (uint32_t)b->closure_var_count);
+    for (i = 0; i < b->closure_var_count; i++) {
+        JSClosureVar *cv = &b->closure_var[i];
+        aot_hash_u32(&h0, &h1, (uint32_t)cv->var_idx);
+        aot_hash_u32(&h0, &h1, (uint32_t)cv->var_kind);
+        aot_hash_u32(&h0, &h1, (uint32_t)cv->closure_type);
+        aot_hash_u32(&h0, &h1, (cv->is_lexical ? 1u : 0) | (cv->is_const ? 2u : 0));
+    }
+
+    for (i = 0; i < 16; i++)
+        out[i] = (uint8_t)((i < 8 ? h0 : h1) >> ((i & 7) * 8));
+}
+
+static void js_aot_digest(JSFunctionBytecode *b, uint8_t out[16])
+{
+    js_aot_digest_depth(b, out, 0);
+}
+
+static uint16_t aot_tag_class(JSValue v)
+{
+    switch (JS_VALUE_GET_TAG(v)) {
+    case JS_TAG_FLOAT64:       return AOT_TYPE_FLOAT;
+    case JS_TAG_INT:           return AOT_TYPE_INT;
+    case JS_TAG_BOOL:          return AOT_TYPE_BOOL;
+    case JS_TAG_NULL:
+    case JS_TAG_UNDEFINED:
+    case JS_TAG_UNINITIALIZED: return AOT_TYPE_UNDEF;
+    case JS_TAG_OBJECT:        return AOT_TYPE_OBJECT;
+    case JS_TAG_STRING:
+    case JS_TAG_STRING_ROPE:   return AOT_TYPE_STRING;
+    case JS_TAG_BIG_INT:
+    case JS_TAG_SHORT_BIG_INT: return AOT_TYPE_BIGINT;
+    default:                   return AOT_TYPE_OTHER;
+    }
+}
+
