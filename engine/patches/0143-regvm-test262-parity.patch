+/*
+ * The realm a "this/binding not initialized" check throws in. The stack VM throws
+ * these with caller_ctx -- the derived-constructor check runs after the callee's
+ * context is popped -- so the cold arms match it: the calling record's realm in a
+ * chain, else the realm of whatever frame called this activation.
+ */
+static JSContext *regvm_caller_realm(JSRegRun *f, JSContext *ctx)
+{
+    JSStackFrame *pf;
+    JSObject *p;
+
+    if (f->caller)
+        return f->caller->b->realm;
+    pf = f->sf ? f->sf->prev_frame : NULL;
+    if (pf && JS_VALUE_GET_TAG(pf->cur_func) == JS_TAG_OBJECT) {
+        p = JS_VALUE_GET_OBJ(pf->cur_func);
+        if (p->class_id == JS_CLASS_BYTECODE_FUNCTION)
+            return p->u.func.function_bytecode->realm;
+        if (p->class_id == JS_CLASS_C_FUNCTION)
+            return p->u.cfunc.realm;
+    }
+    return ctx;
+}
