+/* The strict-equality case of a fused compare: equal tags compare payloads;
+   different tags are unequal except the int/double mix. -1 means "not
+   decidable here": strings and big ints compare by value. */
+static inline int regvm_strict_eq(int sub, JSValue a, JSValue b)
+{
+    int ta = JS_VALUE_GET_TAG(a), tb = JS_VALUE_GET_TAG(b);
+    int eq;
+
+    if (unlikely(ta != tb)) {
+        if (ta == JS_TAG_INT && tb == JS_TAG_FLOAT64)
+            eq = (double)JS_VALUE_GET_INT(a) == JS_VALUE_GET_FLOAT64(b);
+        else if (ta == JS_TAG_FLOAT64 && tb == JS_TAG_INT)
+            eq = JS_VALUE_GET_FLOAT64(a) == (double)JS_VALUE_GET_INT(b);
+        else
+            eq = 0;
+    } else {
+        switch (ta) {
+        case JS_TAG_INT:
+            eq = JS_VALUE_GET_INT(a) == JS_VALUE_GET_INT(b); break;
+        case JS_TAG_BOOL:
+            eq = JS_VALUE_GET_BOOL(a) == JS_VALUE_GET_BOOL(b); break;
+        case JS_TAG_FLOAT64:
+            eq = JS_VALUE_GET_FLOAT64(a) == JS_VALUE_GET_FLOAT64(b); break;
+        case JS_TAG_NULL:
+        case JS_TAG_UNDEFINED:
+            eq = 1; break;
+        case JS_TAG_OBJECT:
+            eq = JS_VALUE_GET_PTR(a) == JS_VALUE_GET_PTR(b); break;
+        default:
+            return -1;
+        }
+    }
+    if (sub == REG_BIN_STRICT_NEQ)
+        eq ^= 1;
+    else if (sub != REG_BIN_STRICT_EQ)
+        return -1;
+    return eq;
+}
+
+/* `==`/`!=` without coercion: same-type operands, the int/double mix,
+   `null`/`undefined` with each other, and an object against either. A string
+   or an object against a primitive coerces, so those return -1. */
+static inline int regvm_loose_eq(int sub, JSValue a, JSValue b)
+{
+    int ta = JS_VALUE_GET_TAG(a), tb = JS_VALUE_GET_TAG(b);
+    int eq;
+
+    if (unlikely(ta != tb)) {
+        if (ta == JS_TAG_INT && tb == JS_TAG_FLOAT64)
+            eq = (double)JS_VALUE_GET_INT(a) == JS_VALUE_GET_FLOAT64(b);
+        else if (ta == JS_TAG_FLOAT64 && tb == JS_TAG_INT)
+            eq = JS_VALUE_GET_FLOAT64(a) == (double)JS_VALUE_GET_INT(b);
+        else if ((ta == JS_TAG_NULL || ta == JS_TAG_UNDEFINED) &&
+                 (tb == JS_TAG_NULL || tb == JS_TAG_UNDEFINED))
+            eq = 1;             /* `null == undefined` */
+        else if (ta == JS_TAG_OBJECT &&
+                 (tb == JS_TAG_NULL || tb == JS_TAG_UNDEFINED))
+            eq = 0;             /* an object equals neither null nor undefined */
+        else if (tb == JS_TAG_OBJECT &&
+                 (ta == JS_TAG_NULL || ta == JS_TAG_UNDEFINED))
+            eq = 0;
+        else
+            return -1;
+    } else {
+        switch (ta) {
+        case JS_TAG_INT:
+            eq = JS_VALUE_GET_INT(a) == JS_VALUE_GET_INT(b); break;
+        case JS_TAG_BOOL:
+            eq = JS_VALUE_GET_BOOL(a) == JS_VALUE_GET_BOOL(b); break;
+        case JS_TAG_FLOAT64:
+            eq = JS_VALUE_GET_FLOAT64(a) == JS_VALUE_GET_FLOAT64(b); break;
+        case JS_TAG_NULL:
+        case JS_TAG_UNDEFINED:
+            eq = 1; break;
+        case JS_TAG_OBJECT:
+            eq = JS_VALUE_GET_PTR(a) == JS_VALUE_GET_PTR(b); break;
+        default:
+            return -1;
+        }
+    }
+    return (sub == REG_BIN_NEQ) ? !eq : eq;
+}
+
+/* The bitwise and shift operations of a fused compare. The branch only tests
+   the result for zero, which stays exact for `>>>`. -1 for any other
+   sub-operation. */
+static inline int regvm_int_bit_truthy(int sub, int32_t a, int32_t b)
+{
+    switch (sub) {
+    case REG_BIN_AND: return (a & b) != 0;
+    case REG_BIN_OR:  return (a | b) != 0;
+    case REG_BIN_XOR: return (a ^ b) != 0;
+    case REG_BIN_SHL: return ((uint32_t)a << (b & 31)) != 0;
+    case REG_BIN_SAR: return (a >> (b & 31)) != 0;
+    case REG_BIN_SHR: return ((uint32_t)a >> (b & 31)) != 0;
     default: return -1;
     }
 }
 
+/* `x instanceof C` for a plain class: @@hasInstance resolves to the builtin,
+   whose body is the ordinary prototype walk. -1 means "not decidable here". */
+static inline int regvm_instanceof_fast(JSContext *ctx, JSValue a, JSValue b)
+{
+    JSObject *p;
+
+    if (!JS_IsObject(b))
+        return -1;
+    p = JS_VALUE_GET_OBJ(b);
+    if ((p->class_id == JS_CLASS_BYTECODE_FUNCTION ||
+         p->class_id == JS_CLASS_C_FUNCTION) &&
+        p->shape->proto == JS_VALUE_GET_OBJ(ctx->function_proto) &&
+        !find_own_property1(p, JS_ATOM_Symbol_hasInstance))
+        return JS_OrdinaryIsInstanceOf(ctx, a, b);
+    return -1;
+}
