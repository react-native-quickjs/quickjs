+/*
+ * The bitwise and shift operations of a fused compare. The destination holds an
+ * int32 -- `>>>` can leave the int32 range, but its zero test cannot -- and the
+ * branch tests the result's truthiness, so only the zero test is needed. -1
+ * means "not a bitwise pair", which is every other sub-operation.
+ */
+static inline int regvm_int_bit_truthy(int sub, int32_t a, int32_t b)
+{
+    switch (sub) {
+    case REG_BIN_AND: return (a & b) != 0;
+    case REG_BIN_OR:  return (a | b) != 0;
+    case REG_BIN_XOR: return (a ^ b) != 0;
+    case REG_BIN_SHL: return ((uint32_t)a << (b & 31)) != 0;
+    case REG_BIN_SAR: return (a >> (b & 31)) != 0;
+    case REG_BIN_SHR: return ((uint32_t)a >> (b & 31)) != 0;
     default: return -1;
     }
