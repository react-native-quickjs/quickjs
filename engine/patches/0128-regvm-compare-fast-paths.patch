+/*
+ * The strict-equality case of a fused compare. `===` is a tag test before it is
+ * a value test: equal tags compare their payloads, and different tags are
+ * unequal except for the int/double mix, because Number spans both. This keeps
+ * the default-argument guards -- `if (m === undefined) m = 0`, which dominate
+ * box2d's compare-and-branch calls -- out of the generic comparison. -1 means
+ * "not decidable here": strings and big ints compare by value, not identity.
+ */
+static inline int regvm_strict_eq(int sub, JSValue a, JSValue b)
+{
+    int ta = JS_VALUE_GET_TAG(a), tb = JS_VALUE_GET_TAG(b);
+    int eq;
+
+    if (unlikely(ta != tb)) {
+        if (ta == JS_TAG_INT && tb == JS_TAG_FLOAT64)
+            eq = (double)JS_VALUE_GET_INT(a) == JS_VALUE_GET_FLOAT64(b);
+        else if (ta == JS_TAG_FLOAT64 && tb == JS_TAG_INT)
+            eq = JS_VALUE_GET_FLOAT64(a) == (double)JS_VALUE_GET_INT(b);
+        else
+            eq = 0;
+    } else {
+        switch (ta) {
+        case JS_TAG_INT:
+            eq = JS_VALUE_GET_INT(a) == JS_VALUE_GET_INT(b); break;
+        case JS_TAG_BOOL:
+            eq = JS_VALUE_GET_BOOL(a) == JS_VALUE_GET_BOOL(b); break;
+        case JS_TAG_FLOAT64:
+            eq = JS_VALUE_GET_FLOAT64(a) == JS_VALUE_GET_FLOAT64(b); break;
+        case JS_TAG_NULL:
+        case JS_TAG_UNDEFINED:
+            eq = 1; break;
+        case JS_TAG_OBJECT:
+            eq = JS_VALUE_GET_PTR(a) == JS_VALUE_GET_PTR(b); break;
+        default:
+            return -1;
+        }
+    }
+    if (sub == REG_BIN_STRICT_NEQ)
+        eq ^= 1;
+    else if (sub != REG_BIN_STRICT_EQ)
+        return -1;
+    return eq;
+}
