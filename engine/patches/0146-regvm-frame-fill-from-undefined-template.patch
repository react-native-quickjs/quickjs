Subject: Fills a frame's registers from a static `undefined` template

What this does
  Fills a frame's registers from a static `undefined` template.

Why we need it
  A callee frame must hand every register a valid, uncounted word before its program runs (a recycled word would be released twice), and the registers the liveness analysis names must read `undefined`; the frame paid a scalar store loop for that on every call, and a function read from a blob with no fill list paid a loop over every register.

What it adds
  A 256-entry static `undefined` template and one `memcpy` of `nregs`; frames larger than the template keep the old zero-then-list fill, and the common path is a `likely` branch so it is a single `memcpy` with a length the caller already computed.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -26342,6 +26342,13 @@ static int regvm_record_eligible(JSFunctionBytecode *cb)
  */
 /* always_inline: both callers are already framed, and a twelve-argument call
    would pass some arguments on the stack. */
+/* A static block of `undefined` words. Every register must hold a valid,
+   uncounted word before the frame runs; filling the frame from this template
+   is one memcpy. */
+#define REGVM_UNDEF_TMPL_N 256
+static const JSValue regvm_undef_tmpl[REGVM_UNDEF_TMPL_N] = {
+    [0 ... REGVM_UNDEF_TMPL_N - 1] = { { .int32 = 0 }, JS_TAG_UNDEFINED },
+};
 static __attribute__((always_inline)) inline void regvm_record_fill(
     JSRuntime *rt, const JSRegRecordLayout *lay, JSValueConst cf, JSObject *co,
     JSFunctionBytecode *cb, JSRegRun *caller, int ret_dst, uint8_t *ret_ip,
@@ -26462,7 +26469,9 @@ static __attribute__((always_inline)) inline void regvm_record_fill(
            window slot
          * a call does not write is read as an argument.
          */
-        if (!cb->regvm_fill) {
+        if (likely(nregs <= REGVM_UNDEF_TMPL_N)) {
+            memcpy(lay->regs, regvm_undef_tmpl, (size_t)nregs * sizeof(JSValue));
+        } else if (!cb->regvm_fill) {
             for (k = 0; k < nregs; k++)
                 lay->regs[k] = JS_UNDEFINED;
         } else {
