+/* Debug API: Get local variables in stack frames */
+typedef struct JSDebugLocalVar {
+    const char *name;
+    JSValue value;
+    bool is_arg;
+    bool is_closure;       /* true if captured from an enclosing scope */
+    int scope_level;
