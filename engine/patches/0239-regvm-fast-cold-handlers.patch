+ * Fast threaded handlers for seven opcodes that would otherwise dispatch
+ * through the cold trampoline. Each is the monolith/`regvm_exec_one` body with
+ * record field names; the ones that can allocate, throw or run user code keep
+ * their slow half out of line, exactly like `regvm_t_cold`. Off restores the
+ * old `regvm_t_cold` entry for all seven.
+ */
+#ifndef QJS_REGVM_FAST_COLD
+#define QJS_REGVM_FAST_COLD 1
+#endif
