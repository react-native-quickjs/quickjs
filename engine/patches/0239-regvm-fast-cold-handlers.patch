+/*
+ * QJS_REGVM_FAST_COLD: dedicated handlers for seven opcodes that were
+ * dispatched through `regvm_t_cold` -> `regvm_t_cold_slow` -> `regvm_exec_one`.
+ * That path costs a call into `regvm_exec_one` and its own dispatch on top of
+ * the opcode, ~69 instructions per dispatch. Each body below is the
+ * `regvm_exec_one` arm (already written against the record `f`) with its
+ * operands decoded from the opcode's fixed format. The three that can allocate,
+ * throw or run user code (`special_object`, `make_closure`, `set_name`) keep
+ * their body in a `noinline` `_slow` half and tail-call into it, so the handler
+ * that sits on the dispatch path stays frameless -- the gate checks this.
+ */
+
+/* "ruas": d, receiver slot, atom, PIC site. Same body as get_local_field_0
+   with the receiver read from the argument area instead of var_buf[0]. */
+static uint8_t *REGVM_CC regvm_t_get_arg_field(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    int slot = T_U16(3);
+    JSAtom atom = T_U32(5);
+    int site = T_U16(9);
+    JSValue recv = f->arg_buf[slot];
+    JSValue val;
+
+    if (regvm_own_read_hit(f->pic, f->b->regvm_pic_holder, recv, site, &val))
+        T_SET_NEXT_B(d, val, T_SZ_RUAS);
+    if (site == REG_IC_NONE)
+        val = JS_GetProperty(ctx, recv, atom);
+    else
+        val = regvm_get_field_ic(ctx, f->b, &f->pic, recv, atom, site);
+    if (JS_IsException(val))
+        T_FAIL();
+    T_SET_NEXT_P(d, val, T_SZ_RUAS);
+}
+
+static uint8_t *REGVM_CC regvm_t_put_arg_xfer(REGVM_ARGS)
+{
+    int slot = T_U16(1);
+    int s = T_REG(3);
+#if QJS_DRC
+    regvm_put_arg(ctx, f->arg_buf, f->arg_owned, slot, FR(s));
+    FR(s) = JS_UNDEFINED;
+#else
+    set_value(ctx, &f->arg_buf[slot], FR(s));
+    FR(s) = JS_UNDEFINED;
+#endif
+    T_NEXT(T_SZ_UR);
+}
+
+static uint8_t *REGVM_CC regvm_t_put_local_s1(REGVM_ARGS)
+{
+    int s = T_REG(1);
+    set_value(ctx, &f->var_buf[1], js_dup(FR(s)));
+    T_NEXT(T_SZ_R);
+}
+
+/* "burt": sub, local slot, register, target. branch_cmp_reg_reg with the left
+   operand in a frame slot. */
+/* "burt": sub, local slot, register, target. The `_s` family's int fast path
+   inline; everything else is the generic slow half (`regvm_cmp_take`). */
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_branch_cmp_loc_reg_slow(REGVM_ARGS)
+{
+    int sub = T_U8(1);
+    int lu = T_U16(2);
+    int rb = T_REG(4);
+    int32_t off = T_I32(6);
+    int take;
+
+    REGVM_CAPTURE_IP();
+    take = regvm_cmp_take(ctx, sub, f->var_buf[lu], FR(rb));
+    if (unlikely(take < 0))
+        T_FAIL();
+    T_NEXT(T_SZ_BURT + (take ? off : 0));
+}
+
+static uint8_t *REGVM_CC regvm_t_branch_cmp_loc_reg(REGVM_ARGS)
+{
+    int sub = T_U8(1);
+    int lu = T_U16(2);
+    int rb = T_REG(4);
+    int32_t off = T_I32(6);
+    JSValue a = f->var_buf[lu], b = FR(rb);
+    int r;
+
+    if (likely(JS_VALUE_IS_BOTH_INT(a, b) &&
+               !((r = regvm_int_cmp(sub & ~REG_CMP_INVERT,
+                                    JS_VALUE_GET_INT(a),
+                                    JS_VALUE_GET_INT(b))) < 0))) {
+        if (unlikely(r ^ ((sub & REG_CMP_INVERT) != 0))) {
+            REGVM_DRC_BACKEDGE(ctx, off);
+            T_NEXT(T_SZ_BURT + off);
+        }
+        T_NEXT(T_SZ_BURT);
+    }
+    __attribute__((musttail)) return regvm_t_branch_cmp_loc_reg_slow(REGVM_PASS);
+}
+
+/* "rb": d, kind. Can allocate or run user code (import meta), so the body is
+   out of line. */
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_special_object_slow(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    int kind = T_U8(3);
+    JSValue val;
+    /* The frame's function object, needed only by the home-object case. */
+    JSObject *p = JS_VALUE_GET_OBJ(f->sf->cur_func);
+    switch (kind) {
+    case OP_SPECIAL_OBJECT_ARGUMENTS:
+        val = js_build_arguments(ctx, f->argc, f->argv);
+        break;
+    case OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS:
+        val = js_build_mapped_arguments(ctx, f->argc, f->argv, f->sf,
+                                        min_int(f->argc, f->b->arg_count));
+        break;
+    case OP_SPECIAL_OBJECT_THIS_FUNC:
+        val = js_dup(f->sf->cur_func);
+        break;
+    case OP_SPECIAL_OBJECT_NEW_TARGET:
+        val = js_dup(f->new_target);
+        break;
+    case OP_SPECIAL_OBJECT_HOME_OBJECT:
+        val = p->u.func.home_object
+            ? js_dup(JS_MKPTR(JS_TAG_OBJECT, p->u.func.home_object))
+            : JS_UNDEFINED;
+        break;
+    case OP_SPECIAL_OBJECT_VAR_OBJECT:
+        val = JS_NewObjectProto(ctx, JS_NULL);
+        break;
+    case OP_SPECIAL_OBJECT_IMPORT_META:
+        val = js_import_meta(ctx);
+        break;
+    case OP_SPECIAL_OBJECT_NULL_PROTO:
+        val = JS_NewObjectProtoClass(ctx, JS_NULL, JS_CLASS_OBJECT);
+        break;
+    case OP_SPECIAL_OBJECT_ARG_COUNT:
+        val = js_int32(f->argc);
+        break;
+    default:
+        JS_ThrowInternalError(ctx, "register VM: bad special object %d", kind);
+        T_FAIL();
+    }
+    if (JS_IsException(val))
+        T_FAIL();
+    T_SET_NEXT_P(d, val, T_SZ_RB);
+}
+
+static uint8_t *REGVM_CC regvm_t_special_object(REGVM_ARGS)
+{
+    __attribute__((musttail)) return regvm_t_special_object_slow(REGVM_PASS);
+}
+
+/* "rc": d, cpool index of the function to close. */
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_make_closure_slow(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    uint32_t idx = T_U32(3);
+    JSValue cl = js_closure(ctx, js_dup(f->b->cpool[idx]), f->var_refs, f->sf);
+    if (JS_IsException(cl))
+        T_FAIL();
+    T_SET_NEXT_P(d, cl, T_SZ_RC);
+}
+
+static uint8_t *REGVM_CC regvm_t_make_closure(REGVM_ARGS)
+{
+    __attribute__((musttail)) return regvm_t_make_closure_slow(REGVM_PASS);
+}
+
+/* "ra": function in a register, name atom. */
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_set_name_slow(REGVM_ARGS)
+{
+    int r = T_REG(1);
+    JSAtom atom = T_U32(3);
+    if (JS_DefineObjectName(ctx, FR(r), atom, JS_PROP_CONFIGURABLE) < 0)
+        T_FAIL();
+    T_NEXT(T_SZ_RA);
+}
+
+static uint8_t *REGVM_CC regvm_t_set_name(REGVM_ARGS)
+{
+    __attribute__((musttail)) return regvm_t_set_name_slow(REGVM_PASS);
+}
