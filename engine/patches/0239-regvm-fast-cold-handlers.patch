+        unsafe[ROP_special_object] = 1;
+        unsafe[ROP_make_closure] = 1;
+        unsafe[ROP_set_name] = 1;
+        unsafe[ROP_get_arg_field] = 1;
+        unsafe[ROP_put_arg_xfer] = 1;
+        unsafe[ROP_put_local_s1] = 1;
+#endif
         ready = 1;
     }
     while (p < end) {
