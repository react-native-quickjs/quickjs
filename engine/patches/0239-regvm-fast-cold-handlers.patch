 static uint8_t *REGVM_CC regvm_t_put_element_xfer(REGVM_ARGS)
 {
     int o = T_REG(1);
@@ -58859,6 +59085,26 @@ static int regvm_code_light_safe(const uint8_t *code, int len)
         unsafe[ROP_construct] = 1;
