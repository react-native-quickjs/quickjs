@@ -29739,7 +29756,7 @@ static void regvm_hot_step(JSRegAsmState *st)
             /* rpc is at the opcode; the operand follows it */
             int d = (int)regvm_ld_u16(st->rpc + 1);
             st->rpc += 3;
-            if (JS_VALUE_HAS_REF_COUNT(st->regs[d]))
+            if (REGVM_HAS_COUNT(st->regs[d]))
