+/*
+ * Whether a value held in a register carries a reference the frame owns.
+ *
+ * The frame's registers hold two kinds of value and nothing else: an immediate
+ * (tag >= 0 -- int, bool, null, undefined, uninitialized, catch offset, exception,
+ * short BigInt, float64) or a counted pointer (tag < 0 -- object, string, string
+ * rope, BigInt, module, bytecode function). The one negative tag that is *not*
+ * counted is the internal lazy-JSON marker (JS_TAG_LAZY_JSON, -4), and no
+ * register ever holds one: every read that can produce a marker materializes it
+ * (js_lazy_materialize_slot) before the value reaches a register, and a marker
+ * is not a value user code can name. So the reference-count test collapses to a
+ * sign test, and the tag order it rests on is asserted here.
+ *
+ * This is the register-state classification of plan section 6.1 in its smallest
+ * form: NONE (an immediate, no count) versus OWN (a counted pointer).
+ * JS_VALUE_HAS_REF_COUNT stays the right test for a value read out of an object
+ * slot, which *can* be a lazy marker, so the object paths keep it.
+ */
+#if !JS_NAN_BOXING
+_Static_assert(JS_TAG_FIRST < 0 && JS_TAG_INT == 0,
+               "register value classification assumes negative tags are pointers and tags >= 0 are immediates");
+#define REGVM_HAS_COUNT(v) (JS_VALUE_GET_TAG(v) < 0)
+#else
+#define REGVM_HAS_COUNT(v) JS_VALUE_HAS_REF_COUNT(v)
+#endif
+
