Subject: Makes the register release test a single sign test, from the register-value classification

What this does
  Makes the register release test a single sign test, from the register-value classification.

Why we need it
  Every register store tested `JS_VALUE_HAS_REF_COUNT` on the value it overwrote - a two-term test (`tag != JS_TAG_LAZY_JSON && (unsigned)tag >= (unsigned)JS_TAG_FIRST`).

What it adds
  A register holds either an immediate or a counted pointer, and never the internal lazy-JSON marker, so `REGVM_HAS_COUNT(v)` is `JS_VALUE_GET_TAG(v) < 0` under the struct `JSValue`, with a `_Static_assert` pinning the tag order; applied to every register-store release site (`T_SET_NEXT`, `regvm_t_return_nested`, `regvm_t_move_xfer`, the monolith `SET_REG` and `REGVM_INLOOP_RETURN`, the ASM `regvm_hot_step`), while object-slot releases keep `JS_VALUE_HAS_REF_COUNT` because a slot *can* hold a marker.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -22493,6 +22493,23 @@ extern void regvm_asm_branch_nlt_s(void);
 extern void regvm_asm_add_imm_self_branch_s(void);
 #endif /* QJS_REGVM_ASM */
 
+/*
+ * Whether a value held in a register carries a reference the frame owns.
+ *
+ * A register holds an immediate (tag >= 0) or a counted pointer (tag < 0).
+ * The one uncounted negative tag, the lazy-JSON marker, never reaches a
+ * register: every read that can produce one materializes it first. So the
+ * test is a sign test. JS_VALUE_HAS_REF_COUNT stays the test for a value read
+ * from an object slot, which can be a marker.
+ */
+#if !JS_NAN_BOXING
+_Static_assert(JS_TAG_FIRST < 0 && JS_TAG_INT == 0,
+               "register value classification assumes negative tags are pointers and tags >= 0 are immediates");
+#define REGVM_HAS_COUNT(v) (JS_VALUE_GET_TAG(v) < 0)
+#else
+#define REGVM_HAS_COUNT(v) JS_VALUE_HAS_REF_COUNT(v)
+#endif
+
 #if QJS_REGVM_THREAD
 /*
  * --- the threaded interpreter -------------------------------------------
@@ -22718,7 +22735,7 @@ static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_free_slow(REGVM_ARGS)
 #define T_SET_NEXT(d, v, off) do { \
         JSValue _v = (v), _o = fr[d]; \
         fr[d] = _v; \
-        if (unlikely(JS_VALUE_HAS_REF_COUNT(_o)) && \
+        if (unlikely(REGVM_HAS_COUNT(_o)) && \
             unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(_o)) <= 0)) { \
             f->set_v = _o; \
             __attribute__((musttail)) \
@@ -23350,7 +23367,7 @@ static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_return_nested(REGVM_A
     old = c->fr[dst];
     c->fr[dst] = v;
     f = c;
-    if (unlikely(JS_VALUE_HAS_REF_COUNT(old)) &&
+    if (unlikely(REGVM_HAS_COUNT(old)) &&
         unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old)) <= 0)) {
         f->set_v = old;
         __attribute__((musttail)) return regvm_t_free_slow(rip, f->fr, f, ctx);
@@ -23877,7 +23894,7 @@ static uint8_t *REGVM_CC regvm_t_move_xfer(REGVM_ARGS)
 
         fr[d] = v;
         fr[s] = JS_UNDEFINED;
-        if (unlikely(JS_VALUE_HAS_REF_COUNT(old)) &&
+        if (unlikely(REGVM_HAS_COUNT(old)) &&
             unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old)) <= 0)) {
             f->set_v = old;
             __attribute__((musttail))
@@ -24880,7 +24897,7 @@ static JSValue js_regvm_execute(JSContext *caller_ctx, JSValueConst func_obj,
         /* Every register holds a primitive or an owned reference, and the
            allocator reuses a register once its value is dead, so a definition
            releases the value it overwrites. */
-#define SET_REG(d, v) do { JSValue _old_rv = regs[d]; if (JS_VALUE_HAS_REF_COUNT(_old_rv)) JS_FreeValue(ctx, _old_rv); regs[d] = (v); } while (0)
+#define SET_REG(d, v) do { JSValue _old_rv = regs[d]; if (REGVM_HAS_COUNT(_old_rv)) JS_FreeValue(ctx, _old_rv); regs[d] = (v); } while (0)
 
 #define REGVM_SLOT(k) (regs[b->regvm_reg_count + (k)])        /*
          * Leave the frame for the engine. The continuation is the register pc
@@ -25275,7 +25292,7 @@ static JSValue js_regvm_execute(JSContext *caller_ctx, JSValueConst func_obj,
         REGVM_RESTORE_CALLER(_rh); \
         _rold = *_rdst; \
         *_rdst = _rrv; \
-        if (JS_VALUE_HAS_REF_COUNT(_rold)) \
+        if (REGVM_HAS_COUNT(_rold)) \
             JS_FreeValue(ctx, _rold); \
         REGVM_NEXT(); \
