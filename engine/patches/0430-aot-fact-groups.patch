+    for (i = 0; i < g->nprops; i++) {
+        JS_FreeValueRT(rt, g->props[i].val);
+        JS_FreeAtomRT(rt, g->props[i].atom);
+    }
+    JS_FreeValueRT(rt, g->proto);
+    JS_FreeValueRT(rt, g->objv);
+    js_free_rt(rt, g->props);
+    js_free_rt(rt, g);
+    return NULL;
+}
