+        if (s.dyn) {
+            js_aot_fact_break_now(F, g);
+            continue;
+        }
+        for (j = 0; j < s.n; j++)
+            if (js_aot_fact_listed(g, s.atoms[j]) >= 0) {
+                js_aot_fact_break_now(F, g);
+                break;
+            }
+    }
