+#ifndef QJS_DRC_NO_EAGER_LARGE
+/* A parked value that retains at least this many bytes should force a
+   reconcile soon, rather than waiting for the count-based safepoint trigger. */
+#define JS_DRC_LARGE_VALUE_MIN (64 * 1024)
+
+/* True when parking 'v' would keep a large buffer alive: a long string or rope,
+   a large BigInt, or an object owning a large array buffer / typed array. */
+static bool js_drc_value_is_large(JSValue v)
+{
+    switch (JS_VALUE_GET_TAG(v)) {
+    case JS_TAG_STRING:
+        {
+            JSString *p = JS_VALUE_GET_STRING(v);
+            return (uint32_t)(p->len << p->is_wide_char) >= JS_DRC_LARGE_VALUE_MIN;
+        }
+    case JS_TAG_STRING_ROPE:
+        {
+            JSStringRope *r = JS_VALUE_GET_STRING_ROPE(v);
+            return r->len >= JS_DRC_LARGE_VALUE_MIN;
+        }
+    case JS_TAG_BIG_INT:
+        {
+            JSBigInt *p = JS_VALUE_GET_PTR(v);
+            return (uint64_t)p->len * sizeof(js_limb_t) >= JS_DRC_LARGE_VALUE_MIN;
+        }
+    case JS_TAG_OBJECT:
+        {
+            JSObject *p = JS_VALUE_GET_OBJ(v);
+            switch (p->class_id) {
+            case JS_CLASS_ARRAY_BUFFER:
+            case JS_CLASS_SHARED_ARRAY_BUFFER:
+                /* A failed allocation leaves the object with a NULL buffer. */
+                return p->u.array_buffer != NULL &&
+                       p->u.array_buffer->byte_length >= JS_DRC_LARGE_VALUE_MIN;
+            case JS_CLASS_UINT8C_ARRAY:
+            case JS_CLASS_INT8_ARRAY:
+            case JS_CLASS_UINT8_ARRAY:
+            case JS_CLASS_INT16_ARRAY:
+            case JS_CLASS_UINT16_ARRAY:
+            case JS_CLASS_INT32_ARRAY:
+            case JS_CLASS_UINT32_ARRAY:
+            case JS_CLASS_BIG_INT64_ARRAY:
+            case JS_CLASS_BIG_UINT64_ARRAY:
+            case JS_CLASS_FLOAT16_ARRAY:
+            case JS_CLASS_FLOAT32_ARRAY:
+            case JS_CLASS_FLOAT64_ARRAY:
+            case JS_CLASS_DATAVIEW:
+                {
+                    JSTypedArray *ta = p->u.array.u1.typed_array;
+                    return ta != NULL && ta->length >= JS_DRC_LARGE_VALUE_MIN;
+                }
+            default:
+                return false;
+            }
+        }
+    default:
+        return false;
+    }
+}
+#endif /* QJS_DRC_NO_EAGER_LARGE */
