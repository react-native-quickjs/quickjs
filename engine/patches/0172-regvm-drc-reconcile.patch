+/* Deferred free parks zero-refcount values until a safepoint reconciles them.
+   The safepoint trigger counts values, not the memory they retain, so a few
+   very large parked values (e.g. a multi-megabyte linearized string) can keep
+   the heap ratcheting up. When allocation crosses the reconcile mark, force a
+   reconcile at the next safepoint (never here: a handler may be holding values
+   mid-instruction). */
+static inline void js_drc_malloc_pressure(JSRuntime *rt)
+{
+#if QJS_DRC
+    if (unlikely(rt->drc_malloc_mark != 0 &&
+                 rt->malloc_state.malloc_size > rt->drc_malloc_mark &&
+                 (rt->zct_len != 0 || rt->zct_nobj != 0))) {
+        rt->zct_limit = 0;
+    }
+#else
+    (void)rt;
+#endif
+}
