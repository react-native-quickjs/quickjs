 /*
+ * X3b: fuse an adjacent `get_field` chain.
+ *
+ * When a `get_field`'s destination is exactly the receiver operand of the very
+ * next instruction, and that next instruction is a `get_field`/`get_field2`,
+ * the pair becomes one `ROP_get_field_chain`. The fused instruction writes both
+ * destinations, so the first result stays available to whatever reads it after
+ * the pair; the two reads happen in the same order and nothing observable
+ * occurs between them.
+ *
+ * Two things must not hold of the second instruction: it must not be a
+ * branch/catch/finally target, and it must not start a basic block. The other
+ * removing passes drop the *first* instruction and so are free to leave a
+ * target pointing at the survivor; this one drops the *second*, and a target
+ * that still named it would have to resolve to the instruction after the fused
+ * pair, skipping it. Targets are read out of the format's `t` operands (mapped
+ * through `pc_to_insn`, exactly as the encoder will map them), and a block start
+ * is recognized by its bytecode position being a leader.
+ *
+ * This runs after register allocation and the ownership analysis, so neither
+ * ever sees the fused opcode: the two destination values and the two receiver
+ * values already have registers, and the per-register own_init/own_undef sets
+ * are unaffected by merging two writes into one instruction.
+ */
+static void regvm_fuse_field_chain(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
+                                   int n_pcs, const int *bstart, int n_blocks)
+{
+    int n = ir->n_insns, i, k, out = 0;
+    unsigned char *drop = NULL, *is_target = NULL;
+    int *remap = NULL, *first = NULL;
+
+    if (n < 2)
+        return;
+    if (REGVM_KNOB("REGVM_NOCHAIN"))
+        return;
+    drop = js_mallocz(ctx, (size_t)n);
+    is_target = js_mallocz(ctx, (size_t)n);
+    remap = js_malloc(ctx, (size_t)n * sizeof(int));
+    first = js_malloc(ctx, (size_t)(n + 1) * sizeof(int));
+    if (!drop || !is_target || !remap || !first)
+        goto done;
+
+    for (i = 0; i < n; i++) {
+        const char *fmt = regvm_rop_fmt[ir->insns[i].rop];
+        for (k = 0; fmt && fmt[k]; k++) {
+            int32_t pc;
+            int ti;
+            if (fmt[k] != 't')
+                continue;
+            pc = ir->insns[i].ops[k];
+            ti = (pc >= 0 && pc < n_pcs) ? pc_to_insn[pc] : -1;
+            if (ti >= 0 && ti < n)
+                is_target[ti] = 1;
+        }
+    }
+
+    for (i = 0; i + 1 < n; i++) {
+        JSRegInsn *a = &ir->insns[i], *b = &ir->insns[i + 1];
+
+        if (drop[i] || drop[i + 1])
+            continue;
+        if (a->rop != ROP_get_field || a->n_ops != 4)
+            continue;
+        if (b->rop != ROP_get_field && b->rop != ROP_get_field2)
+            continue;
+        if (b->n_ops != 4)
+            continue;
+        if (b->ops[1] != a->ops[0])
+            continue;                       /* receiver is not the first result */
+        if (b->ops[0] == a->ops[0])
+            continue;                       /* would write one destination twice */
+        if (is_target[i + 1])
+            continue;
+        {
+            int bstart_hit = 0;
+            for (k = 0; k < n_blocks; k++)
+                if (bstart[k] == b->src_pc) {
+                    bstart_hit = 1;
+                    break;
+                }
+            if (bstart_hit)
+                continue;
+        }
+
+        a->rop = ROP_get_field_chain;
+        a->n_ops = 8;
+        a->ops[4] = b->ops[0];
+        a->ops[5] = b->ops[1];
+        a->ops[6] = b->ops[2];
+        a->ops[7] = b->ops[3];
+        drop[i + 1] = 1;
+        i++;                                /* do not chain into the dropped insn */
+    }
+
+    for (i = 0; i < n; i++) {
+        if (!drop[i]) {
+            if (out != i)
+                ir->insns[out] = ir->insns[i];
+            remap[i] = out;
+            out++;
+        }
+    }
+    if (out == n)
+        goto done;                          /* nothing fused */
+    ir->n_insns = out;
+    first[n] = out;
+    for (i = n - 1; i >= 0; i--)
+        first[i] = drop[i] ? first[i + 1] : remap[i];
+    for (i = 0; i < n_pcs; i++) {
+        int old = pc_to_insn[i];
+        if (old < 0 || old > n)
+            old = 0;
+        pc_to_insn[i] = first[old];
+    }
+ done:
+    js_free(ctx, drop);
+    js_free(ctx, is_target);
+    js_free(ctx, remap);
+    js_free(ctx, first);
+}
