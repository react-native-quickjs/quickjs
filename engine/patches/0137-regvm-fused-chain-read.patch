+/*
+ * Fuse an adjacent `get_field` chain: a `get_field` whose destination is the
+ * receiver of the next `get_field`/`get_field2` becomes one
+ * `ROP_get_field_chain`, writing both destinations.
+ *
+ * This drops the second instruction, so it must not be a branch, catch or
+ * finally target (read from the `t` operands through `pc_to_insn`) or a block
+ * start. Runs after allocation and the ownership analysis, which never see the
+ * fused opcode.
+ */
+static void regvm_fuse_field_chain(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
+                                   int n_pcs, const int *bstart, int n_blocks)
+{
+    int n = ir->n_insns, i, k, out = 0;
+    unsigned char *drop = NULL, *is_target = NULL;
+    int *remap = NULL, *first = NULL;
+
+    if (n < 2)
+        return;
+    if (REGVM_KNOB("REGVM_NOCHAIN"))
+        return;
+    drop = js_mallocz(ctx, (size_t)n);
+    is_target = js_mallocz(ctx, (size_t)n);
+    remap = js_malloc(ctx, (size_t)n * sizeof(int));
+    first = js_malloc(ctx, (size_t)(n + 1) * sizeof(int));
+    if (!drop || !is_target || !remap || !first)
+        goto done;
+
+    for (i = 0; i < n; i++) {
+        const char *fmt = regvm_rop_fmt[ir->insns[i].rop];
+        for (k = 0; fmt && fmt[k]; k++) {
+            int32_t pc;
+            int ti;
+            if (fmt[k] != 't')
+                continue;
+            pc = ir->insns[i].ops[k];
+            ti = (pc >= 0 && pc < n_pcs) ? pc_to_insn[pc] : -1;
+            if (ti >= 0 && ti < n)
+                is_target[ti] = 1;
+        }
+    }
+
+    for (i = 0; i + 1 < n; i++) {
+        JSRegInsn *a = &ir->insns[i], *b = &ir->insns[i + 1];
+
+        if (drop[i] || drop[i + 1])
+            continue;
+        if (a->rop != ROP_get_field || a->n_ops != 4)
+            continue;
+        if (b->rop != ROP_get_field && b->rop != ROP_get_field2)
+            continue;
+        if (b->n_ops != 4)
+            continue;
+        if (b->ops[1] != a->ops[0])
+            continue;                       /* receiver is not the first result */
+        if (b->ops[0] == a->ops[0])
+            continue;                       /* would write one destination twice */
+        if (is_target[i + 1])
+            continue;
+        {
+            int bstart_hit = 0;
+            for (k = 0; k < n_blocks; k++)
+                if (bstart[k] == b->src_pc) {
+                    bstart_hit = 1;
+                    break;
+                }
+            if (bstart_hit)
+                continue;
+        }
+
+        a->rop = ROP_get_field_chain;
+        a->n_ops = 8;
+        a->ops[4] = b->ops[0];
+        a->ops[5] = b->ops[1];
+        a->ops[6] = b->ops[2];
+        a->ops[7] = b->ops[3];
+        drop[i + 1] = 1;
+        i++;                                /* do not chain into the dropped insn */
+    }
+
+    for (i = 0; i < n; i++) {
+        if (!drop[i]) {
+            if (out != i)
+                ir->insns[out] = ir->insns[i];
+            remap[i] = out;
+            out++;
+        }
+    }
+    if (out == n)
+        goto done;                          /* nothing fused */
+    ir->n_insns = out;
+    first[n] = out;
+    for (i = n - 1; i >= 0; i--)
+        first[i] = drop[i] ? first[i + 1] : remap[i];
+    for (i = 0; i < n_pcs; i++) {
+        int old = pc_to_insn[i];
+        if (old < 0 || old > n)
+            old = 0;
+        pc_to_insn[i] = first[old];
+    }
+ done:
+    js_free(ctx, drop);
+    js_free(ctx, is_target);
+    js_free(ctx, remap);
+    js_free(ctx, first);
+}
