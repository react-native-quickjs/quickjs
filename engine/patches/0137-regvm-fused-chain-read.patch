+static uint8_t *REGVM_CC regvm_t_get_field_chain(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int r1 = T_REG(3);
+    int site1 = T_REG(9);
+    int d2 = T_REG(11);
+    int site2 = T_REG(19);
