+/*
+ * The fused chain read: a `get_field` whose destination is the receiver of the
+ * next `get_field`/`get_field2`, as one instruction writing both destinations.
+ *
+ * Both sites quicken independently: the generic handler tests both shapes, and
+ * the slow handler rewrites the opcode to `_own` only when both are cached own
+ * slots.
+ *
+ * The first store cannot use T_SET_NEXT, which dispatches. It is inlined, and
+ * when the old value's last reference dies `..._free1` releases it and does
+ * the second read.
+ */
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_second_slow(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int site1 = T_REG(9);
+    int d2 = T_REG(11);
+    JSAtom atom2 = (JSAtom)T_U32(15);
+    int site2 = T_REG(19);
+    JSValue v2;
+
+    if (site2 == REG_IC_NONE) {
+        v2 = JS_GetProperty(ctx, FR(d1), atom2);
+    } else {
+        v2 = regvm_get_field_ic(ctx, f->b, &f->pic, FR(d1), atom2, site2);
+    }
+    if (unlikely(JS_IsException(v2)))
+        T_FAIL();
+    /* Quicken only when both sites are cached own slots. */
+    if (likely(f->pic != NULL && site1 != REG_IC_NONE &&
+               f->pic[site1].kind == REG_PIC_OWN &&
+               f->pic[site2].kind == REG_PIC_OWN)) {
+        *ip = (uint8_t)ROP_get_field_chain_own;
+    } else {
+        *ip = (uint8_t)ROP_get_field_chain;
+    }
+    T_SET_NEXT(d2, v2, T_SZ_CHAIN);
+}
+
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_free1(REGVM_ARGS)
+{
+    js_free_value_rt(ctx->rt, f->set_v);
+    __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+}
+
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_slow(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int r1 = T_REG(3);
+    JSAtom atom1 = (JSAtom)T_U32(5);
+    int site1 = T_REG(9);
+    JSValue v1, old1;
+
+    if (site1 == REG_IC_NONE) {
+        v1 = JS_GetProperty(ctx, FR(r1), atom1);
+    } else {
+        v1 = regvm_get_field_ic(ctx, f->b, &f->pic, FR(r1), atom1, site1);
+    }
+    if (unlikely(JS_IsException(v1)))
+        T_FAIL();
+    old1 = FR(d1);
+    FR(d1) = v1;
+    if (unlikely(REGVM_HAS_COUNT(old1)) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old1)) <= 0)) {
+        f->set_v = old1;
+        __attribute__((musttail)) return regvm_t_get_field_chain_free1(REGVM_PASS);
+    }
+    __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+}
+
+static uint8_t *REGVM_CC regvm_t_get_field_chain(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int r1 = T_REG(3);
+    int site1 = T_REG(9);
+    int d2 = T_REG(11);
+    int site2 = T_REG(19);
+    JSValue v1, v2, old1;
+
+    if (unlikely(!regvm_own_read_hit(f->pic, f->b->regvm_pic_holder, FR(r1),
+                                     site1, &v1)))
+        __attribute__((musttail)) return regvm_t_get_field_chain_slow(REGVM_PASS);
+    old1 = FR(d1);
+    FR(d1) = v1;
+    if (unlikely(REGVM_HAS_COUNT(old1)) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old1)) <= 0)) {
+        f->set_v = old1;
+        __attribute__((musttail)) return regvm_t_get_field_chain_free1(REGVM_PASS);
+    }
+    if (unlikely(!regvm_own_read_hit(f->pic, f->b->regvm_pic_holder, FR(d1),
+                                     site2, &v2)))
+        __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+    T_SET_NEXT(d2, v2, T_SZ_CHAIN);
+}
+
+static uint8_t *REGVM_CC regvm_t_get_field_chain_own(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int r1 = T_REG(3);
+    int site1 = T_REG(9);
+    int d2 = T_REG(11);
+    int site2 = T_REG(19);
+    JSValue recv = FR(r1), v1, old1, v2;
+
+    if (likely(JS_VALUE_GET_TAG(recv) == JS_TAG_OBJECT)) {
+        JSObject *p = JS_VALUE_GET_OBJ(recv);
+        JSRegPIC *e = &f->pic[site1];
+        if (likely(e->shape == p->shape)) {
+            v1 = *(JSValue *)((char *)p->prop + e->slot_off);
+            if (likely(JS_VALUE_GET_TAG(v1) >= 0)) {
+                goto have_v1;
+            } else if (likely(JS_VALUE_GET_TAG(v1) != JS_TAG_LAZY_JSON)) {
+                JS_REF_COUNT(JS_VALUE_GET_PTR(v1))++;
+                goto have_v1;
+            }
+        }
+    }
+    __attribute__((musttail)) return regvm_t_get_field_chain_slow(REGVM_PASS);
+ have_v1:
+    old1 = FR(d1);
+    FR(d1) = v1;
+    if (unlikely(REGVM_HAS_COUNT(old1)) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old1)) <= 0)) {
+        f->set_v = old1;
+        __attribute__((musttail)) return regvm_t_get_field_chain_free1(REGVM_PASS);
+    }
+    {
+        JSValue r = FR(d1);
+        if (likely(JS_VALUE_GET_TAG(r) == JS_TAG_OBJECT)) {
+            JSObject *p = JS_VALUE_GET_OBJ(r);
+            JSRegPIC *e = &f->pic[site2];
+            if (likely(e->shape == p->shape)) {
+                v2 = *(JSValue *)((char *)p->prop + e->slot_off);
+                if (likely(JS_VALUE_GET_TAG(v2) >= 0)) {
+                    T_SET_NEXT(d2, v2, T_SZ_CHAIN);
+                } else if (likely(JS_VALUE_GET_TAG(v2) != JS_TAG_LAZY_JSON)) {
+                    JS_REF_COUNT(JS_VALUE_GET_PTR(v2))++;
+                    T_SET_NEXT(d2, v2, T_SZ_CHAIN);
+                }
+            }
+        }
+    }
+    __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+}
