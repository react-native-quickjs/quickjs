+/*
+ * X3b: the fused chain read.
+ *
+ * A `get_field` whose destination is immediately the receiver of the next
+ * `get_field`/`get_field2` is emitted as one instruction, `ROP_get_field_chain`.
+ * It performs both reads and writes both destinations, so it is exactly the
+ * pair it replaces: the first destination stays live, and nothing observable
+ * happens between the two reads. Only a dispatch and the second instruction's
+ * operand decode are saved.
+ *
+ * Both sites quicken independently. The generic handler tests both shapes
+ * inline; whichever read misses continues in a slow handler, and that handler
+ * is what rewrites the opcode byte -- to `_own` only when both sites are cached
+ * own slots, and back to the generic form otherwise, so the own handler may
+ * omit the kind and prototype tests.
+ *
+ * The first store cannot use T_SET_NEXT: that dispatches, and the second read
+ * has not run yet. The overwrite is inlined instead, and the rare case where
+ * the old value's last reference dies continues in `..._free1`, which releases
+ * it and then performs the second read.
+ */
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_second_slow(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int site1 = T_REG(9);
+    int d2 = T_REG(11);
+    JSAtom atom2 = (JSAtom)T_U32(15);
+    int site2 = T_REG(19);
+    JSValue v2;
+
+    if (site2 == REG_IC_NONE) {
+        v2 = JS_GetProperty(ctx, FR(d1), atom2);
+    } else {
+        v2 = regvm_get_field_ic(ctx, f->b, &f->pic, FR(d1), atom2, site2);
+    }
+    if (unlikely(JS_IsException(v2)))
+        T_FAIL();
+    /* Quicken only when both sites are cached own slots. Anything else keeps
+       (or restores) the generic form, whose hit test carries the kind and the
+       prototype branch the own handler omits. */
+    if (likely(f->pic != NULL && site1 != REG_IC_NONE &&
+               f->pic[site1].kind == REG_PIC_OWN &&
+               f->pic[site2].kind == REG_PIC_OWN)) {
+        *ip = (uint8_t)ROP_get_field_chain_own;
+    } else {
+        *ip = (uint8_t)ROP_get_field_chain;
+    }
+    T_SET_NEXT(d2, v2, T_SZ_CHAIN);
+}
+
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_free1(REGVM_ARGS)
+{
+    js_free_value_rt(ctx->rt, f->set_v);
+    __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+}
+
+static __attribute__((noinline)) uint8_t *REGVM_CC
+regvm_t_get_field_chain_slow(REGVM_ARGS)
+{
+    int d1 = T_REG(1);
+    int r1 = T_REG(3);
+    JSAtom atom1 = (JSAtom)T_U32(5);
+    int site1 = T_REG(9);
+    JSValue v1, old1;
+
+    if (site1 == REG_IC_NONE) {
+        v1 = JS_GetProperty(ctx, FR(r1), atom1);
+    } else {
+        v1 = regvm_get_field_ic(ctx, f->b, &f->pic, FR(r1), atom1, site1);
+    }
+    if (unlikely(JS_IsException(v1)))
+        T_FAIL();
+    old1 = FR(d1);
+    FR(d1) = v1;
+    if (unlikely(REGVM_HAS_COUNT(old1)) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old1)) <= 0)) {
+        f->set_v = old1;
+        __attribute__((musttail)) return regvm_t_get_field_chain_free1(REGVM_PASS);
+    }
+    __attribute__((musttail)) return regvm_t_get_field_chain_second_slow(REGVM_PASS);
+}
