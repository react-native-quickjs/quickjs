Subject: The profile build notes every store into a profiled shape's slots, so the slot types it reports are complete

What this does
  - Profile build only: the store and add hooks record, per shape and slot, the value kinds written and the shape of an object value.
    The profile dump merges these notes into the `V` lines, which the heap walk alone got wrong (it sees only objects on the
    collector's list and misses values that were overwritten, such as a constructor's `this.x = null`).

Why we need it
  A promise about a slot is derived from every type the slot ever held; a partial view would promise what a later store breaks.

Functions touched
  `aot_note_of`, `aot_note_slot`, `aot_note_object`, `js_aot_content_store`, `js_aot_content_filled`, `js_aot_content_last`,
  `aot_dump_contents`. All under `QJS_AOT_PROFILE`; the preprocessed non-profile source holds none of it.

No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -16409,6 +16409,72 @@
     }
 }
 
+#if QJS_AOT_PROFILE
+/* What the program stored into the slots of each shape, noted at the hooks every store passes: the
+   types, and the shape of an object value (one, or "several"). The profile dump merges it with the
+   heap walk, which cannot see objects that are not on the collector's list or values that were
+   overwritten. */
+#define AOT_NOTE_SLOTS 32
+typedef struct AotNote {
+    JSShape *sh;
+    uint16_t types[AOT_NOTE_SLOTS];
+    JSShape *vs[AOT_NOTE_SLOTS];
+    uint8_t multi[AOT_NOTE_SLOTS];
+} AotNote;
+static AotNote *aot_notes;
+static int aot_nnotes, aot_capnotes;
+static uint16_t aot_tag_class(JSValue v);
+
+static AotNote *aot_note_of(JSShape *sh)
+{
+    static int last = -1;
+    int i;
+    if (last >= 0 && aot_notes[last].sh == sh)
+        return &aot_notes[last];
+    for (i = 0; i < aot_nnotes; i++)
+        if (aot_notes[i].sh == sh)
+            goto found;
+    if (aot_nnotes == aot_capnotes) {
+        int nc = aot_capnotes ? aot_capnotes * 2 : 64;
+        AotNote *nn = (realloc)(aot_notes, sizeof(*nn) * (size_t)nc);
+        if (nn == NULL)
+            return NULL;
+        aot_notes = nn;
+        aot_capnotes = nc;
+    }
+    memset(&aot_notes[aot_nnotes], 0, sizeof(aot_notes[0]));
+    aot_notes[aot_nnotes].sh = sh;
+    i = aot_nnotes++;
+found:
+    last = i;
+    return &aot_notes[i];
+}
+
+static void aot_note_slot(JSShape *sh, uint32_t slot, JSValue v)
+{
+    AotNote *n;
+    uint16_t bit;
+    if (slot >= AOT_NOTE_SLOTS || (n = aot_note_of(sh)) == NULL)
+        return;
+    bit = aot_tag_class(v);
+    n->types[slot] |= bit;
+    if (bit == AOT_TYPE_OBJECT) {
+        JSShape *vsh = JS_VALUE_GET_OBJ(v)->shape;
+        if (n->vs[slot] == NULL)
+            n->vs[slot] = vsh;
+        else if (n->vs[slot] != vsh)
+            n->multi[slot] = 1;
+    }
+}
+
+static void aot_note_object(JSObject *p, uint32_t from)
+{
+    uint32_t i, n = p->shape->prop_count;
+    for (i = from; i < n && i < AOT_NOTE_SLOTS; i++)
+        aot_note_slot(p->shape, i, p->prop[i].u.value);
+}
+#endif
+
