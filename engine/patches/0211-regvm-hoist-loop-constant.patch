Subject: Hoist the loop constant out of the back edge

What this does
  Hoist the loop constant out of the back edge.

Why we need it
  A counted loop's back edge targets the `load_i32` that materialises the bound, so the constant reloads every iteration although nothing in the loop rewrites it.

What it adds
  An IR pass retargets a backward edge whose target is a pure constant load with a single destination definition to the instruction after it; the load runs once on the entry fall-through.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index 0d948d4..4b215b8 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -60866,6 +60866,83 @@ static void regvm_fuse_self_branch(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
     js_free(ctx, first);
 }
 
+/*
+ * The back edge of a counted loop targets the constant load of its bound, which
+ * re-executes every iteration. Retarget the edge past the load. Only a backward
+ * edge to a pure constant load whose register is written nowhere else
+ * qualifies, so the load has always run when the edge is taken.
+ */
+static void regvm_hoist_loop_const(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
+                                   int n_pcs, int n_values, const int *ireg)
+{
+    int n = ir->insns ? ir->n_insns : 0, i, p;
+    int *defs = NULL, *insn_pc = NULL;
+
+    if (n < 3 || n_values <= 0 || !ireg)
+        return;
+    defs = js_malloc(ctx, (size_t)n_values * sizeof(int));
+    insn_pc = js_malloc(ctx, (size_t)n * sizeof(int));
+    if (!defs || !insn_pc)
+        goto done;
+    for (i = 0; i < n_values; i++)
+        defs[i] = -1;
+    for (i = 0; i < n; i++) {
+        JSRegInsn *in = &ir->insns[i];
+        const char *fmt = regvm_rop_fmt[in->rop];
+        int v, pr;
+
+        if (!fmt || fmt[0] != 'r')
+            continue;
+        v = in->ops[0];
+        if (v < 0 || v >= n_values)
+            continue;
+        pr = ireg[v];
+        if (pr < 0 || pr >= n_values)
+            continue;
+        defs[pr] = (defs[pr] < 0) ? i : -2;
+    }
+    for (i = 0; i < n; i++)
+        insn_pc[i] = -1;
+    for (p = 0; p < n_pcs; p++) {
+        int ti = pc_to_insn[p];
+        if (ti >= 0 && ti < n && insn_pc[ti] < 0)
+            insn_pc[ti] = p;
+    }
+    for (i = 0; i < n; i++) {
+        JSRegInsn *br = &ir->insns[i];
+        int ti, v, pr, nxt;
+
+        if (br->rop != ROP_branch || br->n_ops != 1)
+            continue;
+        if (br->ops[0] < 0 || br->ops[0] >= n_pcs)
+            continue;
+        ti = pc_to_insn[br->ops[0]];
+        if (ti < 0 || ti >= i)              /* backward edges only */
+            continue;
+        switch (ir->insns[ti].rop) {
+        case ROP_load_i8: case ROP_load_i8_s: case ROP_load_i32:
+        case ROP_load_const: case ROP_load_undefined: case ROP_load_null:
+        case ROP_load_true: case ROP_load_false:
+            break;
+        default:
+            continue;
+        }
+        v = ir->insns[ti].ops[0];
+        if (v < 0 || v >= n_values)
+            continue;
+        pr = ireg[v];
+        if (pr < 0 || pr >= n_values || defs[pr] != ti)
+            continue;                       /* one definition: this load */
+        nxt = ti + 1;
+        if (nxt >= i || insn_pc[nxt] < 0)   /* nothing between load and edge */
+            continue;
+        br->ops[0] = insn_pc[nxt];
+    }
+ done:
+    js_free(ctx, defs);
+    js_free(ctx, insn_pc);
+}
+
 /* Register operands are byte offsets: one byte reaches register 15, two bytes
    reach register 4095. */
 #define REGVM_NARROW_REG_MAX 16
@@ -64725,6 +64802,8 @@ static __exception int js_regvm_encode(JSContext *ctx, JSFunctionDef *fd,
                              n_values, phi_in);
     regvm_fuse_self_branch(ctx, &ir, pc_to_insn, bc_len + n_stubs_used,
                            n_values, ireg);
+    regvm_hoist_loop_const(ctx, &ir, pc_to_insn, bc_len + n_stubs_used,
+                           n_values, ireg);
     /*
      * Forward a frame read to a value still in its register: a local stored
      * earlier in the same block can be read from the stored value's register.
