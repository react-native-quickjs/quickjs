+    js_free(ctx, B->succ);
+    js_free(ctx, B->pred_off);
+    js_free(ctx, B->pred);
+    js_free(ctx, B->in_depth);
+    js_free(ctx, B->ent_off);
+    js_free(ctx, B->ent);
+    js_free(ctx, B->out_off);
+    js_free(ctx, B->out);
+    js_free(ctx, B->out_depth);
+    js_free(ctx, B->push_base);
+    js_free(ctx, B->ireg);
+    js_free(ctx, B->scratch);
