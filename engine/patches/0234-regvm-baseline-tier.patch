+        changed = 0;
+        for (b = 0; b < B->n_blocks; b++) {
+            int d, np, ns;
+            if (B->in_depth[b] < 0)
+                continue;
+            d = B->in_depth[b];
+            for (pos = B->bstart[b]; pos < B->bstart[b + 1];
+                 pos += short_opcode_info(bc[pos]).size) {
+                regvm_effect(fd, bc, pos, &np, &ns);
+                if (d < np) {
+                    /* cannot happen for a parser-accepted stack shape */
+                    goto refuse;
+                }
+                d += ns - np;
+                if (d > B->max_depth)
