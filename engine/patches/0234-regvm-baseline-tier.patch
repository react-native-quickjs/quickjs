+/*
+ * --- the baseline tier ------------------------------------------------------
+ *
+ * The third lowering, entered only when the optimising path refused a shape
+ * twice. A direct translation of the stack bytecode: a value's identity is its
+ * operand-stack depth, with no SSA, liveness, promotion, destructive reuse or
+ * fusion. Its only per-block state is the entry depth.
+ *
+ * A depth below V is a register (`ireg[d] = d`). A deeper value has no
+ * register the 16-bit operand can name, so it lives in a slot at the top of
+ * the register file, reached through ROP_slot_get/ROP_slot_put:
+ *
+ *     [ 0 .. V )              direct value registers (depth d < V is reg d)
+ *     [ V .. V+K )            K spill temporaries
+ *     [ V+K ]                 the encoder's scratch, when the IR uses one
+ *     [ V+K+1 .. V+K+1+win )  the call window
+ *     [ STACK_BASE .. )       the stack area (depth d >= V is
+ *                             regs[STACK_BASE + (d - V)])
+ *
+ * The encoder sees V+K registers, and the frame's regvm_reg_count is raised
+ * past the stack area afterwards.
+ */
+
+#define REGVM_BASELINE_SPILL_TMPS 16
