+ * register operand is below 4,096. A deep value (depth >= V) lives in the
+ * stack area: a read is preceded by a ROP_slot_get into one of K spill
+ * temporaries, the operand is replaced by the temporary, and a write is
+ * followed by a ROP_slot_put. An instruction that reads and writes a deep
+ * value gets both. `regvm_own_has_dest`/`dest_index`/`second_dest_index`
+ * classify each operand.
+ *
+ * The recorded stack shapes are expanded here as parallel moves: loads for
+ * deep sources, a spare register for cycles, stores for deep destinations.
+ */
+
+typedef struct JSRegBlOut {
+    JSContext *ctx;
+    JSRegInsn *insn;
+    int n, cap, failed;
+} JSRegBlOut;
+
+/* The spill pass's view of the layout and the value map. */
+
+static JSRegInsn *regvm_bl_add(JSRegBlOut *o)
+{
+    if (o->failed)
+        return NULL;
+    if (o->n >= o->cap) {
+        int nc = o->cap ? o->cap * 2 : 64;
+        JSRegInsn *ni = js_realloc(o->ctx, o->insn, (size_t)nc * sizeof(*ni));
+        if (!ni) {
+            o->failed = 1;
+            return NULL;
+        }
+        o->insn = ni;
+        o->cap = nc;
+    }
+    memset(&o->insn[o->n], 0, sizeof(JSRegInsn));
+    return &o->insn[o->n++];
+}
+
+static void regvm_bl_op2(JSRegInsn *in, uint16_t rop, int spc, int a, int b)
+{
+    in->rop = rop;
+    in->src_pc = spc;
+    in->n_ops = 2;
+    in->ops[0] = a;
+    in->ops[1] = b;
+    in->origin = REGVM_ORIG_LOWER;
+}
+
+/* Is `v` a value the encoder's register field cannot reach (a deep value)? */
+static int regvm_b_deep(const JSRegBlCtx *C, int32_t v)
+{
+    return v >= 0 && v < C->n_values && C->ireg[v] < 0;
+}
+
+/* Expand the recorded parallel copy at `sh`. A deep source or destination
+   moves through a spill temporary. */
+static int regvm_baseline_expand_shape(JSContext *ctx, JSRegBlOut *o,
+                                       const JSRegBlCtx *C,
+                                       const JSRegBShape *sh, int src_pc)
+{
+    int sreg[8], dreg[8], sdeep[8], ddeep[8], stmp[8], dtmp[8];
+    int srslot[8];
+    int n = sh->ns, j, k2, npre = 0;
+    int V = C->V;
+
+    for (j = 0; j < n; j++) {
+        int32_t sv = sh->src_id[j], dv = sh->dst_id[j];
+        int32_t sid = -1, did = -1;
+        srslot[j] = -1;
+        if (regvm_b_deep(C, sv)) {
+            sid = C->base + npre++;
+            srslot[j] = C->stack_base + (sv - V);
+        }
+        if (regvm_b_deep(C, dv)) {
+            did = C->base + npre++;
+        }
+        /* A deep value is -1 in `bl_val`, so it goes through the temporary
+           loaded from its slot, not `ireg[sv]`. */
+        sreg[j] = sid >= 0 ? sid
+                           : ((sv >= 0 && sv < C->n_values) ? C->ireg[sv] : -1);
+        dreg[j] = did >= 0 ? did
+                           : ((dv >= 0 && dv < C->n_values) ? C->ireg[dv] : -1);
+        sdeep[j] = sid >= 0;
+        ddeep[j] = did >= 0;
+    }
+    if (npre > C->K) {
+        JS_ThrowInternalError(ctx, "regvm: baseline spill needs %d temporaries "
+                              "(the limit is %d)", npre, C->K);
+        return -1;
+    }
+    for (j = 0; j < n; j++) {
+        stmp[j] = sreg[j];
+        dtmp[j] = dreg[j];
+    }
+    for (j = 0; j < n; j++)
+        if (sdeep[j]) {
+            JSRegInsn *in = regvm_bl_add(o);
+            if (!in)
+                return -1;
+            regvm_bl_op2(in, ROP_slot_get, src_pc, sreg[j], srslot[j]);
+        }
+    {
+        int done[8], rem = n;
+        int cyc = C->base + (C->K > 0 ? C->K - 1 : 0);
+        for (j = 0; j < n; j++)
+            done[j] = 0;
+        while (rem > 0) {
+            int pick = -1, blocked;
+            for (j = 0; j < n && pick < 0; j++) {
+                if (done[j] || stmp[j] == dtmp[j])
+                    continue;
+                blocked = 0;
+                for (k2 = 0; k2 < n; k2++)
+                    if (!done[k2] && k2 != j && stmp[k2] == dtmp[j]) {
+                        blocked = 1;
+                        break;
+                    }
+                if (!blocked)
+                    pick = j;
+            }
+            if (pick < 0) {
+                /* a copyless cycle: rotate through the spare and retry */
+                int bumped = 0;
+                for (j = 0; j < n; j++)
+                    if (!done[j] && stmp[j] != dtmp[j]) {
+                        JSRegInsn *in = regvm_bl_add(o);
+                        if (!in)
+                            return -1;
+                        regvm_bl_op2(in, ROP_move, src_pc, cyc, stmp[j]);
+                        stmp[j] = cyc;
+                        bumped = 1;
+                        break;
+                    }
+                if (!bumped)
+                    rem = 0;
+                continue;
+            }
+            done[pick] = 1;
+            if (stmp[pick] != dtmp[pick]) {
+                JSRegInsn *in = regvm_bl_add(o);
+                if (!in)
+                    return -1;
+                regvm_bl_op2(in, ROP_move, src_pc, dtmp[pick], stmp[pick]);
+            }
+            rem--;
+        }
+    }
+    for (j = 0; j < n; j++)
+        if (ddeep[j]) {
+            JSRegInsn *in = regvm_bl_add(o);
+            if (!in)
+                return -1;
+            regvm_bl_op2(in, ROP_slot_put, src_pc, C->stack_base + (sh->dst_id[j] - V), dreg[j]);
+        }
+    return 0;
+}
+
+static int regvm_baseline_spill(JSContext *ctx, JSRegIR *ir,
+                                const JSRegBlCtx *C, JSRegBScratch *bs,
+                                int *pc_to_insn, int n_pcs)
+{
+    int i, k, n = ir->n_insns, si = 0;
+    int V = C->V, K = C->K;
+    JSRegBlOut o;
+    int *newidx;
+
+    o.ctx = ctx;
+    o.insn = NULL;
+    o.n = o.cap = o.failed = 0;
+    /* pc_to_insn indexes the pre-spill IR, and this pass inserts instructions,
+       so `newidx[i]` maps old instruction `i` to the output index of the first
+       instruction it produced. */
+    newidx = js_malloc(ctx, (size_t)(n > 0 ? n : 1) * sizeof(int));
+    if (!newidx)
+        return -1;
+
+    for (i = 0; i < n; i++) {
+        JSRegInsn *in = &ir->insns[i];
+        const char *fmt = regvm_rop_fmt[in->rop];
+        int32_t ops[8];
+        int has_dest, di, di2, ntmp = 0, tfor[8], j;
+        int deep_col[8], is_dest_col[8], dest_read[8];
+
+        newidx[i] = o.n;
+        /* A `move` with no operands is a placeholder: a shape, or a dropped
+           instruction. Shapes are recorded in emission order, so one cursor
+           finds it. */
+        if (in->rop == ROP_move && in->n_ops == 0) {
+            if (si < bs->n_shapes && bs->shapes[si].at_insn == i) {
+                if (regvm_baseline_expand_shape(ctx, &o, C, &bs->shapes[si],
+                                                in->src_pc))
+                    goto fail;
+                si++;
+            }
+            continue;
+        }
+        if (!fmt) {
+            JS_ThrowInternalError(ctx, "regvm: baseline op %d has no format",
+                                  in->rop);
+            goto fail;
+        }
+        has_dest = regvm_own_has_dest(in->rop) && fmt[0] == 'r';
+        di = has_dest ? regvm_own_dest_index(in->rop) : -1;
+        if (di >= 0 && fmt[di] != 'r')
+            di = -1;
+        di2 = (di >= 0) ? regvm_own_second_dest_index(in->rop) : -1;
+        if (di2 >= 0 && fmt[di2] != 'r')
+            di2 = -1;
+
+        for (k = 0; k < 8; k++)
+            tfor[k] = -1;
+        for (k = 0; k < in->n_ops && fmt[k]; k++) {
+            int32_t v = in->ops[k];
+            ops[k] = v;
+            deep_col[k] = (fmt[k] == 'r') && regvm_b_deep(C, v);
+            is_dest_col[k] = (k == di || k == di2);
+            dest_read[k] = 0;
+        }
+        /* A destination that is also a source (in place) is read from its slot
+           first. */
+        for (k = 0; k < in->n_ops && fmt[k]; k++) {
+            int c;
+            if (fmt[k] != 'r' || !is_dest_col[k] || !deep_col[k])
+                continue;
+            for (c = 0; c < in->n_ops && fmt[c]; c++)
+                if (fmt[c] == 'r' && !is_dest_col[c] && ops[c] == ops[k]) {
+                    dest_read[k] = 1;
+                    break;
+                }
+        }
+        /* Each deep operand is replaced by a spill temporary. The window is
+           above every value and temporary id. */
+        for (k = 0; k < in->n_ops && fmt[k]; k++)
+            if (deep_col[k])
+                tfor[k] = C->base + ntmp++;
+        if (ntmp > K) {
+            JS_ThrowInternalError(ctx, "regvm: baseline spill needs %d temporaries "
+                                  "(the limit is %d)", ntmp, K);
+            goto fail;
+        }
+        for (k = 0; k < in->n_ops && fmt[k]; k++) {
+            if (!deep_col[k])
+                continue;
+            if (!is_dest_col[k] || dest_read[k]) {
+                JSRegInsn *ni = regvm_bl_add(&o);
+                if (!ni)
+                    goto fail;
+                regvm_bl_op2(ni, ROP_slot_get, in->src_pc, tfor[k],
+                             C->stack_base + (in->ops[k] - V));
+            }
+        }
+        {
+            JSRegInsn *ni = regvm_bl_add(&o);
+            if (!ni)
+                goto fail;
+            *ni = *in;
+            for (k = 0; k < in->n_ops && fmt[k]; k++)
+                if (deep_col[k])
+                    ni->ops[k] = tfor[k];
+        }
+        for (k = 0; k < in->n_ops && fmt[k]; k++)
+            if (is_dest_col[k] && deep_col[k]) {
+                JSRegInsn *ni = regvm_bl_add(&o);
+                if (!ni)
+                    goto fail;
+                regvm_bl_op2(ni, ROP_slot_put, in->src_pc,
+                             C->stack_base + (in->ops[k] - V), tfor[k]);
+            }
+        (void)j;
+    }
+    if (si != bs->n_shapes) {
+        JS_ThrowInternalError(ctx, "regvm: baseline lost %d stack shapes",
+                              bs->n_shapes - si);
+        goto fail;
+    }
+    /* Remap branch targets through `newidx`: the inserted instructions shift
+       every later index. An index at or past the old end maps to the new end.
+       */
+    for (k = 0; k < n_pcs; k++) {
+        int oi = pc_to_insn[k];
+        if (oi < 0)
+            continue;
+        pc_to_insn[k] = (oi >= n) ? o.n : newidx[oi];
+    }
+    js_free(ctx, newidx);
+    js_free(ctx, ir->insns);
+    ir->insns = o.insn;
+    ir->n_insns = o.n;
+    ir->cap = o.cap;
+    return 0;
+ fail:
+    js_free(ctx, newidx);
+    js_free(ctx, o.insn);
+    return -1;
+}
+
+/* The baseline builder: the CFG, an entry-depth dataflow, the identity value
+   model, `js_regvm_encode` and the spill pass. It cannot refuse a
+   parser-accepted shape. The encoder gets empty promotion, liveness, home,
+   reuse and split/copy inputs, and the identity model's edge moves are all
+   empty, so no stubs are emitted. */
+static __exception int js_regvm_build_baseline(JSContext *ctx, JSFunctionDef *fd,
+                                               const uint8_t *is_leader,
+                                               int *pdeferred)
+{
+    JSRegBaseline B;
+    uint8_t *defined = NULL;
+    uint8_t *ent_phi = NULL;
+    int rc = -1, b, i, v;
+
+    memset(&B, 0, sizeof(B));
+    *pdeferred = 0;
+
+    if (regvm_baseline_cfg(ctx, fd, is_leader, &B))
+        goto done;
+    if (B.bc_len <= 0)
+        goto empty;
+    if (regvm_baseline_preds(ctx, &B))
+        goto done;
+    {
+        int deferred = 0;
+        if (regvm_baseline_depths(ctx, fd, &B, &deferred)) {
+            /* A depth disagreement is a modelling gap; the caller reports it.
+               */
+            goto done;
+        }
+    }
+    if (regvm_baseline_pushbase(ctx, fd, &B))
+        goto done;
+    if (regvm_baseline_ident(ctx, &B))
+        goto done;
+
+    /* The encoder's baseline branch rebuilds `ireg` and grows `reg_count` to
+       V+K after the spill pass; pass the depth-identity array for the calls
+       before that. `defined`/`ent_phi`/`ident` span the spill temporaries so
+       `regvm_reg_of` and the round trip stay in range. */
+    {
+        /* V is at most max_depth + 1, so this bounds V + K. */
+        int K = B.max_depth > 0 ? REGVM_BASELINE_SPILL_TMPS : 0;
+        i = B.max_depth + 1 + K + 1;
+    }
+    if (i <= 0)
+        i = 1;
+    defined = js_mallocz(ctx, (size_t)i);
+    ent_phi = js_mallocz(ctx, (size_t)i * (size_t)(B.n_blocks > 0 ? B.n_blocks : 1));
+    if (!defined || !ent_phi)
+        goto done;
+    for (v = 0; v < i; v++)
+        defined[v] = 1;
+    fd->regvm_baseline = 1;
+    fd->regvm_baseline_depth = B.max_depth;
+    {
+        /* The identity value array the caller would normally allocate. */
+        int *ident = js_malloc(ctx, (size_t)(i > 0 ? i : 1) * sizeof(int));
+        int refused = 0;
+        const char *why = NULL;
+        if (!ident)
+            goto done;
+        for (v = 0; v < i; v++)
+            ident[v] = v;
+        if (regvm_report_deferred_on())
+            fprintf(stderr, "regvm: BASELINE encode bc_len=%d blocks=%d "
+                    "max_depth=%d\n", B.bc_len, B.n_blocks, B.max_depth);
+        rc = js_regvm_encode(ctx, fd, B.bc, B.bc_len,
+                             NULL /* reuse */, B.n_blocks, B.bstart, B.in_depth,
+                             B.ent_off, B.ent, ent_phi, B.out_off, B.out,
+                             B.out_depth, B.pred_off, B.pred, B.succ, B.push_base,
+                             NULL /* split_of */, NULL /* copy_of */,
+                             NULL /* home_slot_of_def */,
+                             NULL /* home_of */, 0 /* n_home_values */,
+                             0 /* home_mode */,
+                             NULL /* slot_ok */, NULL /* ok_index */,
+                             0 /* n_slots */, 0 /* ns_ok */,
+                             NULL, NULL, NULL, NULL, defined,
+                             NULL, NULL, 0 /* live_words */,
+                             ident, i, i /* reg_count */, &refused, &why);
+        js_free(ctx, ident);
+        if (rc)
+            goto done;
+        if (refused) {
+            /*
+             * The baseline is the last tier; a refusal here is a modelling gap
+             * the caller must surface, not a shape to hand on.
+             */
+            if (regvm_report_deferred_on())
+                fprintf(stderr, "regvm: BASELINE refused: %s\n",
+                        why ? why : "?");
+            if (why)
+                JS_ThrowInternalError(ctx, "regvm: baseline refused: %s", why);
+            else
+                JS_ThrowInternalError(ctx, "regvm: baseline refused");
+            goto done;
+        }
+    }
+    js_regvm_stats.baseline_funcs++;
+    if (regvm_report_deferred_on())
+        fprintf(stderr, "regvm: BASELINE lowered\n");
+    rc = 0;
+    goto done;
+
+ empty:
+    /* A body with no bytecode: leave regvm_len at zero so the scan emits
+       `return undefined`, as for any empty body. */
+    fd->regvm_baseline = 0;
+    fd->regvm_len = 0;
+    rc = 0;
+    goto done;
+
+ done:
+    regvm_baseline_free(ctx, &B);
+    js_free(ctx, defined);
+    js_free(ctx, ent_phi);
+    (void)b;
+    return rc;
+}
