+/* Probe the cell cache; on a hit stores a new reference in *pval.  A helper so
+   the OP_get_var handler adds no locals to JS_CallInternal. */
+static inline bool js_gv_cell_probe(JSContext *ctx, JSAtom atom, JSValue *pval)
+{
+    JSGVCell *gvc = ctx->gv_cells[atom & (JS_GV_CELL_SETS - 1)];
+    uint32_t gen = ctx->rt->gv_cell_gen;
+
+    if (likely(gvc[0].atom == atom && gvc[0].gen == gen)) {
+        *pval = js_dup(gvc[0].obj->prop[gvc[0].offset].u.value);
+        return true;
+    }
+    if (gvc[1].atom == atom && gvc[1].gen == gen) {
+        *pval = js_dup(gvc[1].obj->prop[gvc[1].offset].u.value);
+        return true;
+    }
+    return false;
 }
 
+/* Record "this atom is own data property #(pr - p->prop) of p". */
+static inline void js_gv_cell_fill(JSContext *ctx, JSAtom prop,
+                                   JSObject *p, JSProperty *pr)
+{
+    JSGVCell *set = ctx->gv_cells[prop & (JS_GV_CELL_SETS - 1)];
+    if (set[0].atom != prop)
+        set[1] = set[0];
+    set[0].atom = prop;
+    set[0].gen = ctx->rt->gv_cell_gen;
+    set[0].offset = (uint32_t)(pr - p->prop);
+    set[0].obj = p;
+}
