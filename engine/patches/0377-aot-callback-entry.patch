Subject: A compiled callback is entered from JS_Call, and a sort calls its compiled comparator directly

What this does
  - `JS_Call` enters a compiled function through its native entry before it calls `JS_CallInternal`,
    under the conditions `JS_CallInternal` already enters it under (a bytecode function with a native
    entry that never writes its arguments, takes at most the given count, is a plain function, is not
    lazy and is not disabled). The interrupt poll `JS_CallInternal` makes first is made here, and the
    reclamation after a call from the top level is as before.
  - `Array.prototype.sort` with such a comparator makes the same checks once, and calls the entry
    for each comparison.

Why we need it
  A builtin that calls back (a sort comparator, forEach, map, filter, reduce) went through
  `JS_CallInternal`, whose frame is that of the whole interpreter: the call cost about 80 cycles before
  the compiled function's own entry started. A sort of 400 numbers with `function (x, y) { return x - y; }`
  spent 40% of its time there.

--- a/quickjs.c
+++ b/quickjs.c
@@ -41996,8 +41996,38 @@
 JSValue JS_Call(JSContext *ctx, JSValueConst func_obj, JSValueConst this_obj,
                 int argc, JSValueConst *argv)
 {
-    JSValue res = JS_CallInternal(ctx, func_obj, this_obj, JS_UNDEFINED,
-                                  argc, argv, JS_CALL_FLAG_COPY_ARGV);
+    JSValue res;
+#if QJS_AOT && QJS_REGVM && QJS_DRC
+    /* A compiled function with a native entry (a builtin's callback: a sort comparator, forEach)
+       is entered here, under the conditions JS_CallInternal enters it under, without the large
+       frame JS_CallInternal sets up first. The entry runs in the function's own realm (it takes
+       its context from the bytecode, as it does when JS_CallInternal calls it), and it checks its
+       own stack margin whenever the function has a call site, which any recursion through a
+       callback has. */
+    if (likely(JS_VALUE_GET_TAG(func_obj) == JS_TAG_OBJECT) &&
+        JS_VALUE_GET_OBJ(func_obj)->class_id == JS_CLASS_BYTECODE_FUNCTION) {
+        JSObject *p = JS_VALUE_GET_OBJ(func_obj);
+        JSFunctionBytecode *b = p->u.func.function_bytecode;
+
+        if (b->aot_nfn != NULL && b->argv_safe && !b->args_captured && argc >= b->arg_count &&
+            b->func_kind == JS_FUNC_NORMAL && !b->is_lazy) {
+            JSRuntime *rt = ctx->rt;
+            JSAotRun *ar = rt->aot_run;
+
+            if (likely(ar == NULL || ar->disabled == NULL ||
+                       !((ar->disabled[b->aot_index >> 3] >> (b->aot_index & 7)) & 1))) {
+                if (js_poll_interrupts(ctx))
+                    return JS_EXCEPTION;
+                res = ((JSAotNFn)b->aot_nfn)(ctx, rt->regvm_cur, p, this_obj, (JSValue *)argv, argc);
+                if (rt->current_stack_frame == NULL && regvm_light_head(rt->regvm_cur) == NULL)
+                    js_drc_safepoint(rt);
+                return res;
+            }
+        }
+    }
+#endif
+    res = JS_CallInternal(ctx, func_obj, this_obj, JS_UNDEFINED,
+                          argc, argv, JS_CALL_FLAG_COPY_ARGV);
 #if QJS_DRC
     if (ctx->rt->current_stack_frame == NULL
         && regvm_light_head(ctx->rt->regvm_cur) == NULL)
@@ -85869,6 +85899,12 @@
     int exception;
