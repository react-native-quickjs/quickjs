Subject: Expose what compiled code needs to replay a cached add-transition store inline

What this does
  - The layout header gains the cell's epoch-stamp offset and the add-transition kind, the
    runtime's epoch offset, and the object's flag word (its offset, the extensible bit, the
    bits that forbid a replay, the inline slot capacity's mask and shift), all probed from
    the real structs.

Why we need it
  Setting a constructor's fields (`this.p = v`) replays the site's cached add transition once
  per property. The replay is a handful of loads, a shape swap by count and one slot store, but
  it was a call into the engine per property (regvm_put_field_add_hit and its wrapper were 30
  percent of a field-heavy constructor). With these offsets the unit does the replay inline
  when the new shape fits the object's slots and the old shape has another holder (so
  dropping its count frees nothing); growth, a watched or exotic object, a non-extensible
  one, a stale epoch stamp and a sole-holder old shape take the engine as before. Nothing in the inline
  path allocates or can start a collection.

--- a/quickjs.c
+++ b/quickjs.c
@@ -60865,6 +60865,43 @@
     out->class_c_function = JS_CLASS_C_FUNCTION;
     out->off_cfunc_c_function = (uint32_t)offsetof(JSObject, u.cfunc.c_function);
     out->off_cfunc_magic = (uint32_t)offsetof(JSObject, u.cfunc.magic);
+    out->off_regpic_misses = (uint32_t)offsetof(JSRegPIC, misses);
+    out->reg_pic_add_w = REG_PIC_ADD_W;
+    out->off_rt_ic_epoch = (uint32_t)offsetof(JSRuntime, ic_watchpoint_epoch);
+    {
+        /* The object's flag bits and its inline slot capacity share one 16-bit word:
+           find where it is and which bits each field takes by setting them in a
+           zeroed object. */
+        JSObject o;
+        const uint8_t *q = (const uint8_t *)&o;
+        size_t i;
+        uint16_t w;
+
+        memset(&o, 0, sizeof(o));
+        o.extensible = 1;
+        o.is_exotic = 1;
+        o.gv_watched = 1;
+        o.prop_inline_cap = 31;
+        for (i = 0; i < sizeof(o) && q[i] == 0; i++)
+            ;
+        out->off_object_flags16 = (uint32_t)(i & ~(size_t)1);
+        memcpy(&w, q + out->off_object_flags16, 2);
+        out->object_inline_cap_mask = w;
+        memset(&o, 0, sizeof(o));
+        o.extensible = 1;
+        memcpy(&w, q + out->off_object_flags16, 2);
+        out->object_extensible_mask = w;
+        memset(&o, 0, sizeof(o));
+        o.is_exotic = 1;
+        o.gv_watched = 1;
+        memcpy(&w, q + out->off_object_flags16, 2);
+        out->object_noadd_mask = w;
+        memset(&o, 0, sizeof(o));
+        o.prop_inline_cap = 31;
+        memcpy(&w, q + out->off_object_flags16, 2);
+        out->object_inline_cap_mask = w;
+        out->object_inline_cap_shift = (uint32_t)__builtin_ctz(w);
+    }
     out->hash = qjs_aot_layout_hash(out);
 }
 
--- a/quickjs-aot-rt.h
+++ b/quickjs-aot-rt.h
@@ -163,6 +163,13 @@
     /* A C function object: its class id and where it keeps the function pointer
        and the magic number, so a unit can tell a builtin from any other callee. */
     uint32_t class_c_function, off_cfunc_c_function, off_cfunc_magic;
+    /* The inline replay of a cached add-transition store: the cell's epoch stamp and
+       kind, the runtime's epoch, and the object's flag word (where it is, the
+       extensible bit, the bits that forbid the replay, and the inline slot
+       capacity's mask and shift). */
+    uint32_t off_regpic_misses, reg_pic_add_w, off_rt_ic_epoch;
+    uint32_t off_object_flags16, object_extensible_mask, object_noadd_mask;
+    uint32_t object_inline_cap_mask, object_inline_cap_shift;
 } JSAotGenLayout;
 
