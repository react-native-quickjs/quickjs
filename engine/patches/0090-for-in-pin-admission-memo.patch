Subject: Memoize the for-in pin admission scan per shape

What this does
  Remembers, per shape, whether a for-in source was admitted by the pin
  admission scan.

Why we need it
  The scan repeats for every loop over the same layout, and its answer is a
  property of that layout.

What it adds
  The memo holds a counted reference to the shape, which keeps the answer tied to
  the layout it was computed for, and an answer is reused only while the shape is
  unchanged. A refused source stays refused and is not re-scanned; a shape the scan
  has not seen runs it as before. No opcode is added or retired and BC_VERSION is
  unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -467,6 +467,16 @@ struct JSRuntime {
     JSAtom forin_atom;
     uint32_t forin_idx;
 
+    /* Memo for js_for_in_try_pin's O(properties) admission scan. The verdict is
+       a property of the shape, so one entry serves every object of that shape.
+       Each slot holds a counted reference, which forces mutations onto the
+       clone path, so the shape the memo describes cannot change and its address
+       cannot be reused. Direct-mapped by shape address. */
+#define JS_PIN_MEMO_BITS 3
+#define JS_PIN_MEMO_SIZE (1 << JS_PIN_MEMO_BITS)
+    JSShape *pin_memo_shape[JS_PIN_MEMO_SIZE];
+    uint8_t pin_memo_ok[JS_PIN_MEMO_SIZE];
+
     JSInterruptHandler *interrupt_handler;
     void *interrupt_opaque;
 
@@ -2970,6 +2980,12 @@ void JS_FreeRuntime(JSRuntime *rt)
         rt->forin_shape = NULL;
         rt->forin_atom = JS_ATOM_NULL;
     }
+    for (int i = 0; i < JS_PIN_MEMO_SIZE; i++) {
+        if (rt->pin_memo_shape[i]) {
+            js_free_shape(rt, rt->pin_memo_shape[i]);
+            rt->pin_memo_shape[i] = NULL;
+        }
+    }
     rt->in_free = true;
 #ifdef QJS_ICSTAT
     js_icstat_dump();
@@ -18842,24 +18858,42 @@ static no_inline JSValue js_args_apply_reified(JSContext *ctx, JSValue *slot,
      directly. */
 static bool js_for_in_try_pin(JSContext *ctx, JSForInIterator *it, JSObject *p)
 {
+    JSRuntime *rt = ctx->rt;
     JSShape *sh = p->shape;
     JSShapeProperty *prs;
     uint32_t idx;
-    int i;
+    int i, slot;
+    bool ok;
 
     if (p->class_id != JS_CLASS_OBJECT || p->fast_array || p->is_exotic)
         return false;
     if (!sh->is_hashed)
         return false;
-    for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
-        if (prs->atom == JS_ATOM_NULL || !(prs->flags & JS_PROP_ENUMERABLE))
-            continue;
-        if (JS_AtomIsArrayIndex(ctx, &idx, prs->atom) ||
-            JS_AtomGetKind(ctx, prs->atom) != JS_ATOM_KIND_STRING ||
-            (prs->flags & JS_PROP_TMASK) == JS_PROP_VARREF) {
-            return false;
+    /* Per-shape admission, memoized. Low address bits carry no entropy and are
+       shifted off. Both verdicts are recorded so a rejected shape is not
+       re-scanned. */
+    slot = (int)(((uintptr_t)sh >> 5) & (JS_PIN_MEMO_SIZE - 1));
+    if (sh == rt->pin_memo_shape[slot]) {
+        ok = rt->pin_memo_ok[slot] != 0;
+    } else {
+        ok = true;
+        for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+            if (prs->atom == JS_ATOM_NULL || !(prs->flags & JS_PROP_ENUMERABLE))
+                continue;
+            if (JS_AtomIsArrayIndex(ctx, &idx, prs->atom) ||
+                JS_AtomGetKind(ctx, prs->atom) != JS_ATOM_KIND_STRING ||
+                (prs->flags & JS_PROP_TMASK) == JS_PROP_VARREF) {
+                ok = false;
+                break;
+            }
         }
+        if (rt->pin_memo_shape[slot])
+            js_free_shape(rt, rt->pin_memo_shape[slot]);
+        rt->pin_memo_shape[slot] = js_dup_shape(sh);
+        rt->pin_memo_ok[slot] = ok;
     }
+    if (!ok)
+        return false;
     it->pin_shape = js_dup_shape(sh);
     return true;
 }
