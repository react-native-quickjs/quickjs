+/* for-in shape pinning: enumerate p's own shape in place instead of copying
+   its property names into the iterator. Admission:
+   - JS_CLASS_OBJECT, !fast_array, !is_exotic: every own key comes from the
+     shape.
+   - shape->is_hashed: a second reference then forces every own-property
+     mutation onto a new shape. An unhashed shape is mutated in place and
+     compact_properties frees it ignoring the refcount.
+   - no enumerable array-index key: for-in yields indices first, in numeric
+     order.
+   - no enumerable symbol key and no VARREF: the pinned walk yields names
+     directly. */
+static bool js_for_in_try_pin(JSContext *ctx, JSForInIterator *it, JSObject *p)
+{
+    JSShape *sh = p->shape;
+    JSShapeProperty *prs;
+    uint32_t idx;
+    int i;
+
+    if (p->class_id != JS_CLASS_OBJECT || p->fast_array || p->is_exotic)
+        return false;
+    if (!sh->is_hashed)
+        return false;
+    for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if (prs->atom == JS_ATOM_NULL || !(prs->flags & JS_PROP_ENUMERABLE))
+            continue;
+        if (JS_AtomIsArrayIndex(ctx, &idx, prs->atom) ||
+            JS_AtomGetKind(ctx, prs->atom) != JS_ATOM_KIND_STRING ||
+            (prs->flags & JS_PROP_TMASK) == JS_PROP_VARREF) {
+            return false;
+        }
+    }
+    it->pin_shape = js_dup_shape(sh);
+    return true;
+}
