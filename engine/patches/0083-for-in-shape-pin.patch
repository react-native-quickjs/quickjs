+/* for-in shape pinning. Try to enumerate p's own shape in place instead of
+   copying its property names into the iterator.
+
+   Admission, and why each condition is needed:
+   - JS_CLASS_OBJECT, !fast_array, !is_exotic: the object's own keys must come
+     from the shape and nowhere else. Arrays, typed arrays, String wrappers,
+     Proxies and module namespaces synthesize keys the shape does not contain.
+   - shape->is_hashed: load-bearing. A second reference on a hashed shape forces
+     every own-property mutation to leave the object on a different shape
+     (add_property takes the transition or clones, js_shape_prepare_update clones
+     because the refcount is not 1). An unhashed shape is mutated in place
+     however many references exist, and compact_properties frees it ignoring the
+     refcount, so pinning one is stale-prone and a use-after-free.
+   - no enumerable array-index key: for-in must yield array indices first in
+     ascending numeric order, and shape order is insertion order.
+   - no enumerable symbol key and no VARREF: the pinned walk yields the name
+     directly, so it must not meet an atom the generic path treats specially. */
+static bool js_for_in_try_pin(JSContext *ctx, JSForInIterator *it, JSObject *p)
+{
+    JSShape *sh = p->shape;
+    JSShapeProperty *prs;
+    uint32_t idx;
+    int i;
+
+    if (p->class_id != JS_CLASS_OBJECT || p->fast_array || p->is_exotic)
+        return false;
+    if (!sh->is_hashed)
+        return false;
+    for (i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if (prs->atom == JS_ATOM_NULL || !(prs->flags & JS_PROP_ENUMERABLE))
+            continue;
+        if (JS_AtomIsArrayIndex(ctx, &idx, prs->atom) ||
+            JS_AtomGetKind(ctx, prs->atom) != JS_ATOM_KIND_STRING ||
+            (prs->flags & JS_PROP_TMASK) == JS_PROP_VARREF) {
+            return false;
+        }
+    }
+    it->pin_shape = js_dup_shape(sh);
+    return true;
+}
+
