+/* Parse an array whose elements are all JSON numbers without routing each
+   number and punctuation mark through json_next_token().  Return 1 when the
+   array is not numeric-only so the caller can use the general parser. */
+static int json_parse_numeric_array(JSParseState *s, JSValue *pval)
+{
+    JSContext *ctx = s->ctx;
+    const uint8_t *saved = s->buf_ptr;
+    const uint8_t *p = saved;
+    JSValue *elems = NULL;
+    int elems_size = 0, n = 0, ret = 1;
+
+    for (;;) {
+        while (p < s->buf_end && (*p == ' ' || *p == '\t' ||
+                                   *p == '\n' || *p == '\r'))
+            p++;
+        if (p >= s->buf_end)
+            goto fallback;
+        if (*p == ']') {
+            p++;
+            ret = 0;
+            break;
+        }
+        if (*p != '-' && (*p < '0' || *p > '9'))
+            goto fallback;
+        if (n >= elems_size) {
+            int new_size = elems_size ? elems_size * 2 : 8;
+            JSValue *new_elems = js_realloc(ctx, elems,
+                                            sizeof(*elems) * new_size);
+            if (!new_elems) {
+                ret = -1;
+                goto fail;
+            }
+            elems = new_elems;
+            elems_size = new_size;
+        }
+        if (json_parse_number(s, &p) < 0) {
+            ret = -1;
+            goto fail;
+        }
+        elems[n++] = s->token.u.num.val;
+        while (p < s->buf_end && (*p == ' ' || *p == '\t' ||
+                                   *p == '\n' || *p == '\r'))
+            p++;
+        if (p >= s->buf_end)
+            goto fallback;
+        if (*p == ']') {
+            p++;
+            ret = 0;
+            break;
+        }
+        if (*p != ',')
+            goto fallback;
+        p++;
+        while (p < s->buf_end && (*p == ' ' || *p == '\t' ||
+                                   *p == '\n' || *p == '\r'))
+            p++;
+        if (p >= s->buf_end || *p == ']' ||
+            (*p != '-' && (*p < '0' || *p > '9')))
+            goto fallback;
+    }
+    if (ret == 0) {
+        JSValue array = js_new_array_from_owned(ctx, n, elems);
+        if (JS_IsException(array))
+            return -1;
+        s->buf_ptr = p;
+        s->token.val = ']';
+        *pval = array;
+        return 0;
+    }
+fallback:
+    while (n > 0)
+        JS_FreeValue(ctx, elems[--n]);
+    js_free(ctx, elems);
+    s->buf_ptr = saved;
+    return 1;
+fail:
+    js_free(ctx, elems);
+    s->buf_ptr = saved;
+    if (ret == 1)
+        return -1;
+    return -1;
+}
