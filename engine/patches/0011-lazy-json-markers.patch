+
+ fail_obj2:
+    JS_FreeValue(ctx, obj);
+    JS_FreeValue(ctx, backing);
+    return JS_EXCEPTION;
+
+ fail_obj:
+    JS_FreeValue(ctx, obj);
+    JS_FreeValue(ctx, backing);
