+#if QJS_DRC
+/* ---- deferred reference counting ------------------------------------------
+ *
+ * Register frames are GC roots. A counted value whose ref_count reaches zero
+ * is parked (objects on gc_zero_ref_count_list, everything else in rt->zct)
+ * instead of freed. js_drc_reconcile() pins every value a live register window
+ * holds, frees the parked values no register refers to, then unpins. A counted
+ * value at zero is never freed outside js_drc_reconcile().
+ */
+#define JS_GC_IN_ZCT(p) (js_rc(p)->in_zct)
+
+static void js_free_value_rt(JSRuntime *rt, JSValue v);
+
+static void js_drc_push(JSRuntime *rt, JSValue v)
+{
+    if (rt->zct_len == rt->zct_cap) {
+        uint32_t ncap = rt->zct_cap ? rt->zct_cap * 2 : 256;
+        /* Not js_realloc_rt(): pushing onto the ZCT must not trigger a GC. */
+        JSValue *nz = rt->mf.js_realloc(rt->malloc_state.opaque, rt->zct,
+                                        sizeof(JSValue) * ncap);
+        if (!nz)
+            abort(); /* out of memory while deferring a free */
+        rt->zct = nz;
+        rt->zct_cap = ncap;
+    }
+    rt->zct[rt->zct_len++] = v;
+}
+
+/* Park 'v' after its ref_count has reached zero. */
+static void js_drc_zero(JSRuntime *rt, JSValue v)
+{
+    uint32_t tag = JS_VALUE_GET_TAG(v);
+
+    if (rt->drc_in_reconcile) {
+        /* Inside reconcile a zero count is final. */
+        js_free_value_rt(rt, v);
+        return;
+    }
+    switch (tag) {
+    case JS_TAG_OBJECT:
+    case JS_TAG_FUNCTION_BYTECODE:
+        {
+            JSGCObjectHeader *p = JS_VALUE_GET_PTR(v);
+            list_del(&p->link);
+            list_add(&p->link, &rt->gc_zero_ref_count_list);
+            rt->zct_nobj++;
+        }
+        break;
+    default:
+        {
+            void *ptr = JS_VALUE_GET_PTR(v);
+            if (!JS_GC_IN_ZCT(ptr)) {
+                JS_GC_IN_ZCT(ptr) = 1;
+                js_drc_push(rt, v);
+            }
+        }
+        break;
+    }
+}
+
+static void js_drc_pin(JSRuntime *rt)
+{
+    JSStackFrame *sf;
+    uint32_t i;
+
+    for (sf = rt->current_stack_frame; sf != NULL; sf = sf->prev_frame) {
+        for (i = 0; i < sf->rv_nregs; i++) {
+            JSValue v = sf->rv_regs[i];
+            if (JS_VALUE_HAS_REF_COUNT(v))
+                JS_REF_COUNT(JS_VALUE_GET_PTR(v))++;
+        }
+    }
+}
+
+static void js_drc_unpin(JSRuntime *rt)
+{
+    JSStackFrame *sf;
+    uint32_t i;
+
+    for (sf = rt->current_stack_frame; sf != NULL; sf = sf->prev_frame) {
+        for (i = 0; i < sf->rv_nregs; i++) {
+            JSValue v = sf->rv_regs[i];
+            if (JS_VALUE_HAS_REF_COUNT(v)) {
+                void *ptr = JS_VALUE_GET_PTR(v);
+                if (--JS_REF_COUNT(ptr) <= 0)
+                    js_drc_zero(rt, v);
+            }
+        }
+    }
+}
+
+/* Frees every parked value that no live register refers to. The caller must
+   have pinned the register windows first. */
+static void js_drc_reconcile_locked(JSRuntime *rt)
+{
+    struct list_head *el, *el1;
+    JSGCObjectHeader *p;
+    uint32_t i;
+
+    rt->drc_in_reconcile = 1;
+
+    /* Non-GC counted values (strings, ropes, BigInt, symbols). Clear the in_zct
+       bits first so a value resurrected and then freed by a cascade leaves no
+       dangling marker. */
+    for (i = 0; i < rt->zct_len; i++)
+        JS_GC_IN_ZCT(JS_VALUE_GET_PTR(rt->zct[i])) = 0;
+    for (i = 0; i < rt->zct_len; i++) {
+        JSValue v = rt->zct[i];
+        if (JS_REF_COUNT(JS_VALUE_GET_PTR(v)) == 0)
+            js_free_value_rt(rt, v);
+    }
+    rt->zct_len = 0;
+
+    /* Objects: keep the ones a register refers to, free the rest. */
+    list_for_each_safe(el, el1, &rt->gc_zero_ref_count_list) {
+        p = list_entry(el, JSGCObjectHeader, link);
+        if (JS_REF_COUNT(p) > 0) {
+            list_del(&p->link);
+            if (JS_GC_NOTRACE(p))
+                list_add_tail(&p->link, &rt->gc_notrace_list);
+            else
+                list_add_tail(&p->link, &rt->gc_obj_list);
+        }
+    }
+    rt->zct_nobj = 0;
+    if (!list_empty(&rt->gc_zero_ref_count_list))
+        free_zero_refcount(rt);
+
+    rt->drc_in_reconcile = 0;
+}
+
+static void js_drc_reconcile(JSRuntime *rt)
+{
+    js_drc_pin(rt);
+    js_drc_reconcile_locked(rt);
+    js_drc_unpin(rt);
+
+    rt->zct_limit = (rt->zct_len + rt->zct_nobj) * 2;
+    if (rt->zct_limit < 4096)
+        rt->zct_limit = 4096;
+}
+
+static inline void js_drc_safepoint(JSRuntime *rt)
+{
+    if (unlikely(!rt->drc_in_reconcile &&
+                 rt->zct_len + rt->zct_nobj > rt->zct_limit))
+        js_drc_reconcile(rt);
+}
+
+/* Adopt a value being stored into a register: drop the reference previously
+   owned by the destination. */
+#define REG_ADOPT(rt, v)                                                     \
+    do {                                                                     \
+        if (JS_VALUE_HAS_REF_COUNT(v) &&                                     \
+            --JS_REF_COUNT(JS_VALUE_GET_PTR(v)) <= 0)                        \
+            js_drc_zero(rt, v);                                              \
+    } while (0)
+#else /* !QJS_DRC */
+#define js_drc_safepoint(rt) ((void)0)
+#endif /* QJS_DRC */
+
