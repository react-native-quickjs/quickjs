+                      tv, f->arg_buf, na, slots);
+    f = lay.rec;
+    __attribute__((musttail))
+        return regvm_t_dispatch(f->b->regvm_code, f->fr, f, cb->realm);
+}
+#endif /* QJS_REGVM_RECORD */
