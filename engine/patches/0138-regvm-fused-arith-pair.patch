+/* Fuse `mul dm, x, y` with an immediately following `add`/`sub` of `dm`. The
+   fused instruction still writes `dm`. It drops the second instruction, so a
+   branch, catch or finally target or a block start there is refused. */
+static void regvm_fuse_arith_pair(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
+                                  int n_pcs, const int *bstart, int n_blocks)
+{
+    int n = ir->n_insns, i, k, out = 0;
+    unsigned char *drop = NULL, *is_target = NULL;
+    int *remap = NULL, *first = NULL;
+
+    if (n < 2)
+        return;
+    if (REGVM_KNOB("REGVM_NOARITH2"))
+        return;
+    drop = js_mallocz(ctx, (size_t)n);
+    is_target = js_mallocz(ctx, (size_t)n);
+    remap = js_malloc(ctx, (size_t)n * sizeof(int));
+    first = js_malloc(ctx, (size_t)(n + 1) * sizeof(int));
+    if (!drop || !is_target || !remap || !first)
+        goto done;
+
+    for (i = 0; i < n; i++) {
+        const char *fmt = regvm_rop_fmt[ir->insns[i].rop];
+        for (k = 0; fmt && fmt[k]; k++) {
+            int32_t pc;
+            int ti;
+            if (fmt[k] != 't')
+                continue;
+            pc = ir->insns[i].ops[k];
+            ti = (pc >= 0 && pc < n_pcs) ? pc_to_insn[pc] : -1;
+            if (ti >= 0 && ti < n)
+                is_target[ti] = 1;
+        }
+    }
+
+    for (i = 0; i + 1 < n; i++) {
+        JSRegInsn *a = &ir->insns[i], *b = &ir->insns[i + 1];
+        int bstart_hit = 0, rev, c;
+
+        if (drop[i] || drop[i + 1])
+            continue;
+        /* The product must be formed by a plain multiply. */
+        if (a->rop != ROP_binary || a->n_ops != 4 || a->ops[1] != REG_BIN_MUL)
+            continue;
+        /* and consumed by an add or a subtract. */
+        if (b->rop != ROP_binary || b->n_ops != 4)
+            continue;
+        if (b->ops[1] != REG_BIN_ADD && b->ops[1] != REG_BIN_SUB)
+            continue;
+        /* The product must be one of the operands; which one picks the opcode.
+           */
+        if (b->ops[2] == a->ops[0]) {
+            rev = 0;
+            c = b->ops[3];
+        } else if (b->ops[3] == a->ops[0]) {
+            rev = 1;
+            c = b->ops[2];
+        } else {
+            continue;
+        }
+        if (is_target[i + 1])
+            continue;
+        for (k = 0; k < n_blocks; k++)
+            if (bstart[k] == b->src_pc) {
+                bstart_hit = 1;
+                break;
+            }
+        if (bstart_hit)
+            continue;
+
+        if (b->ops[1] == REG_BIN_ADD)
+            a->rop = rev ? ROP_add_mul : ROP_mul_add;
+        else
+            a->rop = rev ? ROP_sub_mul : ROP_mul_sub;
+        a->n_ops = 5;
+        a->ops[1] = a->ops[2];              /* the mul's left operand  -> x */
+        a->ops[2] = a->ops[3];              /* the mul's right operand -> y */
+        a->ops[3] = b->ops[0];              /* the add's destination   -> da */
+        a->ops[4] = c;                      /* the add's other operand -> c */
+        drop[i + 1] = 1;
+        i++;                                /* do not fuse into the dropped insn */
+    }
+
+    for (i = 0; i < n; i++) {
+        if (!drop[i]) {
+            if (out != i)
+                ir->insns[out] = ir->insns[i];
+            remap[i] = out;
+            out++;
+        }
+    }
+    if (out == n)
+        goto done;
+    ir->n_insns = out;
+    first[n] = out;
+    for (i = n - 1; i >= 0; i--)
+        first[i] = drop[i] ? first[i + 1] : remap[i];
+    for (i = 0; i < n_pcs; i++) {
+        int old = pc_to_insn[i];
+        if (old < 0 || old > n)
+            old = 0;
+        pc_to_insn[i] = first[old];
+    }
+ done:
+    js_free(ctx, drop);
+    js_free(ctx, is_target);
+    js_free(ctx, remap);
+    js_free(ctx, first);
+}
