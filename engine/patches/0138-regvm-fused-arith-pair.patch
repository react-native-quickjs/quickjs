+/*
+ * Fused arithmetic: `mul dm, x, y` followed by an add or sub of `dm` and `c`
+ * becomes one instruction. The product is stored to `dm` and the add's result
+ * to `da`. Every operand is read before either store. The int path chains
+ * regvm_num_fast; anything else runs the two operations in order in the slow
+ * handler.
+ */
+#define REGVM_F_ADD(a, b) ((a) + (b))
+#define REGVM_F_SUB(a, b) ((a) - (b))
+
+/* `rev` is 0 for `p OP c` and 1 for `c OP p`: the orders differ for `-` and,
+   with strings, for `+`. A compile-time constant per instantiation. */
+#define T_DEF_ARITH2(name, sub2, FOP, rev) \
+    static __attribute__((noinline)) uint8_t *REGVM_CC \
+    regvm_t_##name##_slow(REGVM_ARGS) \
+    { \
+        int dm = T_REG(1); \
+        int x = T_REG(3), y = T_REG(5); \
+        int da = T_REG(7); \
+        int c = T_REG(9); \
