+/*
+ * X6: store an intermediate value without dispatching.
+ *
+ * The fused arithmetic still owes the mul's own store -- `dm` keeps the product
+ * exactly as it did before the fusion, so anything reading it afterwards is
+ * unaffected. T_SET_NEXT cannot be used because it dispatches, and the add has
+ * not run yet. The rare case where the old value's last reference dies is
+ * released directly; the handler is already a normal (non-tail) function here,
+ * so there is no dispatch to preserve.
+ */
+static inline void regvm_store_intermediate(JSRuntime *rt, JSValue *slot, JSValue v)
+{
+    JSValue old = *slot;
+
+    *slot = v;
+    if (unlikely(REGVM_HAS_COUNT(old)) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old)) <= 0))
+        js_free_value_rt(rt, old);
+}
+
+static inline void regvm_store_intermediate_f64(JSRuntime *rt, JSValue *slot, double r)
+{
+    int64_t ot = slot->tag;
+    JSValue old;
+
+    if (unlikely(ot < 0))
+        old = *slot;
+    slot->u.float64 = r;
+    slot->tag = JS_TAG_FLOAT64;
+    if (unlikely(ot < 0) &&
+        unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(old)) <= 0))
+        js_free_value_rt(rt, old);
