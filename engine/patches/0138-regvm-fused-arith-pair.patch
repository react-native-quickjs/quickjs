+        a->ops[2] = a->ops[3];              /* the mul's right operand -> y */
+        a->ops[3] = b->ops[0];              /* the add's destination   -> da */
+        a->ops[4] = c;                      /* the add's other operand -> c */
+        drop[i + 1] = 1;
+        i++;                                /* do not fuse into the dropped insn */
