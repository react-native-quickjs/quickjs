+            js_regvm_binary(ctx, REG_BIN_MUL, FR(x), FR(y), &t)) \
+            T_FAIL(); \
+        regvm_store_intermediate(ctx->rt, &FR(dm), t); \
+        if (rev) { \
+            if (!regvm_num_fast(sub2, FR(c), FR(dm), &r) && \
+                js_regvm_binary(ctx, sub2, FR(c), FR(dm), &r)) \
+                T_FAIL(); \
+        } else { \
+            if (!regvm_num_fast(sub2, FR(dm), FR(c), &r) && \
+                js_regvm_binary(ctx, sub2, FR(dm), FR(c), &r)) \
+                T_FAIL(); \
+        } \
+        T_SET_NEXT(da, r, T_SZ_RRRRR); \
+    } \
+    static uint8_t *REGVM_CC regvm_t_##name(REGVM_ARGS) \
+    { \
+        int dm = T_REG(1); \
+        int x = T_REG(3), y = T_REG(5); \
+        int da = T_REG(7); \
+        int c = T_REG(9); \
+        JSValue t, r; \
+        if (likely(JS_VALUE_GET_TAG(FR(x)) == JS_TAG_FLOAT64 && \
+                   JS_VALUE_GET_TAG(FR(y)) == JS_TAG_FLOAT64 && \
