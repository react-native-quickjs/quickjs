 /*
+ * X6: fuse an arithmetic pair.
+ *
+ * `mul dm, x, y` immediately followed by `add`/`sub da, dm, c` becomes one
+ * instruction, `mul_add dm x y da c`: the product is formed and stored to `dm`,
+ * then `da` receives `dm + c`. Only the product as the LEFT operand is fused,
+ * because `c + p` and `c - p` are not the same operations and the operand order
+ * of a JavaScript `+` is observable. The fused instruction still writes `dm`,
+ * so anything that reads the product afterwards sees exactly what it saw
+ * before; the fusion removes a dispatch, not a value.
+ *
+ * Like the chain fusion, this drops the second instruction, so a branch, catch
+ * or finally target that still named it would resolve past the fused pair. That
+ * and a block start are refused.
+ */
+static void regvm_fuse_arith_pair(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
+                                  int n_pcs, const int *bstart, int n_blocks)
+{
+    int n = ir->n_insns, i, k, out = 0;
+    unsigned char *drop = NULL, *is_target = NULL;
+    int *remap = NULL, *first = NULL;
+
+    if (n < 2)
+        return;
+    if (REGVM_KNOB("REGVM_NOARITH2"))
+        return;
+    drop = js_mallocz(ctx, (size_t)n);
+    is_target = js_mallocz(ctx, (size_t)n);
+    remap = js_malloc(ctx, (size_t)n * sizeof(int));
+    first = js_malloc(ctx, (size_t)(n + 1) * sizeof(int));
+    if (!drop || !is_target || !remap || !first)
+        goto done;
+
+    for (i = 0; i < n; i++) {
+        const char *fmt = regvm_rop_fmt[ir->insns[i].rop];
+        for (k = 0; fmt && fmt[k]; k++) {
+            int32_t pc;
+            int ti;
+            if (fmt[k] != 't')
+                continue;
+            pc = ir->insns[i].ops[k];
+            ti = (pc >= 0 && pc < n_pcs) ? pc_to_insn[pc] : -1;
+            if (ti >= 0 && ti < n)
+                is_target[ti] = 1;
+        }
+    }
+
+    for (i = 0; i + 1 < n; i++) {
+        JSRegInsn *a = &ir->insns[i], *b = &ir->insns[i + 1];
+        int bstart_hit = 0, rev, c;
+
+        if (drop[i] || drop[i + 1])
+            continue;
+        /* The product must be formed by a plain multiply. */
+        if (a->rop != ROP_binary || a->n_ops != 4 || a->ops[1] != REG_BIN_MUL)
+            continue;
+        /* and consumed by an add or a subtract. */
+        if (b->rop != ROP_binary || b->n_ops != 4)
+            continue;
+        if (b->ops[1] != REG_BIN_ADD && b->ops[1] != REG_BIN_SUB)
+            continue;
+        /* The product must be one of the two operands. Which one decides the
+           opcode: `c + p` is not `p + c` when a string is involved, and
+           `c - p` is not `p - c` at all. */
+        if (b->ops[2] == a->ops[0]) {
+            rev = 0;
+            c = b->ops[3];
+        } else if (b->ops[3] == a->ops[0]) {
+            rev = 1;
+            c = b->ops[2];
+        } else {
+            continue;
+        }
+        if (is_target[i + 1])
+            continue;
+        for (k = 0; k < n_blocks; k++)
+            if (bstart[k] == b->src_pc) {
+                bstart_hit = 1;
+                break;
+            }
+        if (bstart_hit)
