+                 : likely(regvm_num_fast(sub2, t, FR(c), &r)))) { \
+            regvm_store_intermediate(ctx->rt, &FR(dm), t); \
+            T_SET_NEXT(da, r, T_SZ_RRRRR); \
+        } \
+        __attribute__((musttail)) return regvm_t_##name##_slow(REGVM_PASS); \
+    }
