+        aot_nh = nt;
+        aot_nh_mask = nm;
+    }
+    h = aot_ph(sh, aot_nh_mask);
+    while (aot_nh[h]) h = (h + 1) & aot_nh_mask;
+    aot_nh[h] = idx + 1;
+}
+
+static void aot_note_shape_freed(JSShape *sh)
+{
+    int i;
+    if (aot_nnotes == 0)
