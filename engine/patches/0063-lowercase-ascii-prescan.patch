+                             : (c8 >= 'a' && c8 <= 'z'))
+                    c8 += to_lower ? 32 : (uint8_t)-32;
+                str8(q)[k] = c8;
+            }
+            str8(q)[p->len] = '\0';
+            JS_FreeValue(ctx, val);
+            return JS_MKPTR(JS_TAG_STRING, q);
+        }
+    }
