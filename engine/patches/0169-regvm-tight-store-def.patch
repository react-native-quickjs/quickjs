+++ b/quickjs.c
@@ -60078,23 +60078,22 @@ static int regvm_perm_of(int op, int out)
     return map && out >= 0 && out < n ? map[out] : -1;
 }
 
-/* Identify the result-producing instruction of a syntactically tight store.
-   The answer depends only on the bytecode sequence inside this basic block. */
+/* Identify the result-producing instruction of a syntactically tight store,
