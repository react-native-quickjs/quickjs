Subject: A Map or Set lookup of an int key compares ints directly and hashes without the general switch

What this does
  - `map_find_record`, for an int key, compares an int record key by value, and takes the general
    SameValueZero test only for a record key of another kind.
  - `map_hash_key` hashes an int key as the double of the same value, as before, without the
    NaN and tag dispatch of the general path (the hash is unchanged, so a float64 key with an integral
    value still lands in the same bucket).

Why we need it
  A lookup of an int key spent a function call per chain element in `js_same_value_zero`, and the hash
  went through a switch for a case that is one conversion and the finaliser. mapset
  (Map get/set and Set add/delete of int keys, 1.5M iterations) was 28.5 times a hand-written hash
  map and is 25.6 now.

--- a/quickjs.c
+++ b/quickjs.c
@@ -97117,8 +97117,11 @@
         h = (uint32_t)map_hash_mix64((uint64_t)(uintptr_t)JS_VALUE_GET_PTR(key));
         break;
     case JS_TAG_INT:
-        d = JS_VALUE_GET_INT(key);
-        goto hash_float64;
+        /* the hash of the number's double, which a float64 key with the same value takes below */
+        u.d = (double)JS_VALUE_GET_INT(key);
+        h = (uint32_t)map_hash_mix64(u.u64);
+        tag = JS_TAG_FLOAT64;
+        break;
     case JS_TAG_SHORT_BIG_INT:
         d = JS_VALUE_GET_SHORT_BIG_INT(key);
         goto hash_float64;
@@ -97153,6 +97156,19 @@
     JSMapRecord *mr;
     uint32_t h;
     h = map_hash_key(ctx, key) & (s->hash_size - 1);
+    if (JS_VALUE_GET_TAG(key) == JS_TAG_INT) {
+        /* two ints are equal when their values are; any other pairing takes the general test */
+        list_for_each(el, &s->hash_table[h]) {
+            mr = list_entry(el, JSMapRecord, hash_link);
+            if (JS_VALUE_GET_TAG(mr->key) == JS_TAG_INT) {
+                if (JS_VALUE_GET_INT(mr->key) == JS_VALUE_GET_INT(key))
+                    return mr;
+            } else if (js_same_value_zero(ctx, mr->key, key)) {
+                return mr;
+            }
+        }
