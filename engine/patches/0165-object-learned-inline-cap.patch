                                           JSValueConst func_obj,
@@ -38018,16 +38098,22 @@ static JSValue JS_CallConstructorInternal(JSContext *ctx,
         return JS_CallInternal(ctx, func_obj, JS_UNDEFINED, new_target, argc, argv, flags);
     } else {
         JSValue obj, ret;
+        JSFunctionBytecode *nb = js_new_target_bytecode(new_target);
         /* legacy constructor behavior */
-        obj = js_create_from_ctor(ctx, new_target, JS_CLASS_OBJECT);
+        obj = js_create_from_ctor_cap(ctx, new_target, JS_CLASS_OBJECT,
+                                      nb ? nb->inst_inline_cap : 0);
         if (JS_IsException(obj))
             return JS_EXCEPTION;
         ret = JS_CallInternal(ctx, func_obj, obj, new_target, argc, argv, flags);
         if (JS_VALUE_GET_TAG(ret) == JS_TAG_OBJECT ||
             JS_IsException(ret)) {
+            if (nb)
+                js_learn_instance_cap(nb, ret);
             JS_FreeValue(ctx, obj);
             return ret;
         } else {
+            if (nb)
+                js_learn_instance_cap(nb, obj);
             JS_FreeValue(ctx, ret);
             return obj;
         }
