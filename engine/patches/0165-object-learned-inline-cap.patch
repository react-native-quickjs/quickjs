+/* Slack tracking, keyed on new.target, so a base constructor serving
+   `new Sub()` learns the subclass layout. Bytecode functions only. */
+static JSFunctionBytecode *js_new_target_bytecode(JSValueConst new_target)
+{
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(new_target) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(new_target);
+    if (p->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return NULL;
+    return p->u.func.function_bytecode;
+}
+
+static void js_learn_instance_cap(JSFunctionBytecode *nb, JSValueConst inst)
+{
+    JSObject *p;
+    uint32_t ps;
+
+    if (JS_VALUE_GET_TAG(inst) != JS_TAG_OBJECT)
+        return;
+    p = JS_VALUE_GET_OBJ(inst);
+    if (p->class_id != JS_CLASS_OBJECT)
+        return;
+    ps = p->shape->prop_size;
+    if (ps > JS_OBJ_LEARNED_INLINE_MAX)
+        ps = JS_OBJ_LEARNED_INLINE_MAX;
+    if (ps > nb->inst_cap_seen)
+        nb->inst_cap_seen = ps;
+    if (nb->inst_cap_samples < JS_OBJ_LEARN_SAMPLES) {
+        nb->inst_cap_samples++;
+        if (nb->inst_cap_samples == JS_OBJ_LEARN_SAMPLES &&
+            nb->inst_cap_seen > nb->inst_inline_cap)
+            nb->inst_inline_cap = nb->inst_cap_seen;
+    }
+}
+
