Subject: register VM: compute argv_safe from register code

What this does:
  Adds regvm_argv_safe_op / regvm_scan_argv_safe, the register-code form of
  js_arg_ref_opcode, and uses it on the bundle read path to set both
  b->args_captured and b->argv_safe. A debug build asserts the register scan
  agrees with the stack scan that JS_ReadFunctionBytecode ran.

Why we need it:
  `argv_safe` and `args_captured` are never serialized, and after the stack
  bytecode stops being written into bundles there is no stack code to scan, so
  the decoder must derive them from the register program. The register scan
  reproduces exactly the register VM's own borrow condition
  (regvm_args_borrowable: `!args_captured`): a var_ref onto a parameter slot
  (ROP_make_local_ref with kind 1, lowered from OP_make_arg_ref) or the mapped
  `arguments` object (ROP_special_object with
  OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS). A wrong flag is a memory-safety bug
  under DRC, and bundles are untrusted input.

Needs a bytecode version bump:
  No. No opcode, operand or serialized field changes.

Notes:
  Bundle plan D7 plus the 4.4 cross-check.
  Deviation, recorded in the plan's Findings: D7's two conditions are exactly
  the stack scan's js_arg_ref_opcode, so the flag they compute is
  `args_captured`, not the stack VM's broader `argv_safe`. The register
  lowering elides dead argument stores, so the register code cannot reproduce
  `argv_safe` exactly; it is strictly more permissive, which is safe because a
  register frame borrows on `args_captured` (regvm_args_borrowable), and the
  stack VM only consults `argv_safe` when it is the caller. The debug assert
  therefore compares `args_captured` (the register VM's flag), and it agrees.
  Gates: box2d 546.1008391043414; test262 50/81192; diff-suite 400/0/0; the
  13-row Octane round trip source == eager == lazy; ASan round trip clean.

--- a/quickjs.c
+++ b/quickjs.c
@@ -69632,6 +69632,9 @@
    definition is freed. All the child functions are also created. It
    must be done this way to resolve all the variables. */
 static void js_scan_argv_safe(JSFunctionBytecode *b);
+#if QJS_REGVM
+static bool regvm_scan_argv_safe(const uint8_t *code, int len);
+#endif
 
 static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
 {
@@ -69866,6 +69869,18 @@
         js_free(ctx, fd->regvm_code);
         fd->regvm_code = NULL;
         fd->regvm_len = 0;
+#if !defined(NDEBUG)
+        /* Bundle plan 4.4: the register scan must agree with the stack scan
+           that js_scan_argv_safe just ran. The register VM borrows a caller's
+           argument window on `!args_captured` (regvm_args_borrowable), and the
+           register scan reproduces exactly that condition; a debug build
+           asserts they agree. (`argv_safe` is the stack VM's broader flag and
+           is not compared: the register lowering elides dead argument stores,
+           so the register code is strictly more permissive, which is safe for
+           the register VM.) */
+        assert(regvm_scan_argv_safe(b->regvm_code, b->regvm_len) ==
+               (b->args_captured == 0));
+#endif
     }
 #endif
 
@@ -73041,6 +73056,49 @@
     b->argv_safe = 1;
 }
 
+#if QJS_REGVM
+/* Bundle plan D7: the register-code form of js_arg_ref_opcode -- does the
+   program create a var_ref onto a parameter slot, or materialise the mapped
+   `arguments` object? Those are the cases that make a register frame's
+   argument window unsafe to borrow (`regvm_args_borrowable`), because a write
+   through the ref frees the slot's old value. `ops` points at the first
+   operand byte. The two conditions are exactly the stack scan's
+   js_arg_ref_opcode, so the flag they compute is args_captured; a debug build
+   asserts the two agree (§4.4). */
+static bool regvm_argv_safe_op(int op, const uint8_t *ops)
+{
+    switch (op) {
+    case ROP_make_local_ref: /* "rraub": r r a u b, kind is the last byte */
+        return ops[2 + 2 + 4 + 2] != 1;
+    case ROP_special_object: /* "rb": r b */
+        return ops[2] != OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS;
+    default:
+        return true;
+    }
+}
+
+/* Walk a register program and decide whether its argument window may be
+   borrowed (true) or a parameter slot is captured (false). `wide` is 1, as at
+   every other encoded-code walk: the encoder narrows operands in place. */
+static bool regvm_scan_argv_safe(const uint8_t *code, int len)
+{
+    const uint8_t *p = code, *end = p + len;
+
+    while (p < end) {
+        int op = *p, sz;
+        if (op >= ROP_COUNT || regvm_rop_fmt[op] == NULL)
+            return false;
+        if (!regvm_argv_safe_op(op, p + 1))
+            return false;
+        sz = regvm_fmt_size(regvm_rop_fmt[op], 1, (uint16_t)op);
+        if (sz < 0)
+            return false;
+        p += 1 + sz;
+    }
+    return p == end;
+}
+#endif
+
 /* Interns atom `idx` from its recorded position in the payload and memoises it
    in idx_to_atom. Reads through a scratch cursor so the caller's parse position
    is untouched. */
@@ -74004,6 +74062,25 @@
             b->regvm_owns_atoms = 0;
             goto fail_unregistered;
         }
+        /*
+         * Bundle plan D7: `argv_safe` is never serialized, and after P3 a
+         * register bundle carries no stack code to scan. Recompute it from the
+         * register program. The register scan reproduces the register VM's own
+         * borrow condition (`!args_captured`, see regvm_args_borrowable), which
+         * is the flag a register frame consults.
+         */
+        {
+            bool rs = regvm_scan_argv_safe(b->regvm_code, b->regvm_len);
+#if !defined(NDEBUG)
+            /* 4.4: the stack scan JS_ReadFunctionBytecode ran must agree on
+               args_captured. (`argv_safe` is the stack VM's broader flag; the
+               register lowering elides dead argument stores, so the register
+               code is strictly more permissive, which is safe here.) */
+            assert(rs == (b->args_captured == 0));
+#endif
+            b->args_captured = !rs;
+            b->argv_safe = rs;
+        }
     }
 #endif
 
