Subject: Compute `argv_safe` from register code

What this does
  Compute `argv_safe` from register code.

Why we need it
  `argv_safe`/`args_captured` are never serialized; once bundles carry no stack code the decoder must derive them from the register program, and a wrong flag is a memory-safety bug under DRC.

What it adds
  `regvm_argv_safe_op`/`regvm_scan_argv_safe` (the register form of `js_arg_ref_opcode`); the read path sets `b->args_captured`/`b->argv_safe` from it, with a debug assert against the stack scan.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -67087,6 +67087,9 @@ static void regvm_build_pc2line(JSContext *ctx, JSFunctionBytecode *b,
    definition is freed. All the child functions are also created. It
    must be done this way to resolve all the variables. */
 static void js_scan_argv_safe(JSFunctionBytecode *b);
+#if QJS_REGVM
+static bool regvm_scan_argv_safe(const uint8_t *code, int len);
+#endif
 
 static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
 {
@@ -67321,6 +67324,14 @@ static JSValue js_create_function(JSContext *ctx, JSFunctionDef *fd)
         js_free(ctx, fd->regvm_code);
         fd->regvm_code = NULL;
         fd->regvm_len = 0;
+#if !defined(NDEBUG)
+        /* The register scan must agree with the stack scan js_scan_argv_safe
+           just ran on args_captured, the condition regvm_args_borrowable uses;
+           a debug build asserts it. argv_safe is not compared: the register
+           lowering drops dead argument stores, so it may be more permissive. */
+        assert(regvm_scan_argv_safe(b->regvm_code, b->regvm_len) ==
+               (b->args_captured == 0));
+#endif
     }
 #endif
 
@@ -70487,6 +70498,46 @@ static void js_scan_argv_safe(JSFunctionBytecode *b)
     b->argv_safe = 1;
 }
 
+#if QJS_REGVM
+/* The register-code form of js_arg_ref_opcode: does the program create a
+   var_ref onto a parameter slot or materialise the mapped `arguments` object?
+   Either makes the argument window unsafe to borrow (`regvm_args_borrowable`):
+   a write through the ref frees the slot's old value. `ops` points at the
+   first operand byte. */
+static bool regvm_argv_safe_op(int op, const uint8_t *ops)
+{
+    switch (op) {
+    case ROP_make_local_ref: /* "rraub": r r a u b, kind is the last byte */
+        return ops[2 + 2 + 4 + 2] != 1;
+    case ROP_special_object: /* "rb": r b */
+        return ops[2] != OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS;
+    default:
+        return true;
+    }
+}
+
+/* Walk a register program and decide whether its argument window may be
+   borrowed (true) or a parameter slot is captured (false). `wide` is 1, as at
+   every other encoded-code walk: the encoder narrows operands in place. */
+static bool regvm_scan_argv_safe(const uint8_t *code, int len)
+{
+    const uint8_t *p = code, *end = p + len;
+
+    while (p < end) {
+        int op = *p, sz;
+        if (op >= ROP_COUNT || regvm_rop_fmt[op] == NULL)
+            return false;
+        if (!regvm_argv_safe_op(op, p + 1))
+            return false;
+        sz = regvm_fmt_size(regvm_rop_fmt[op], 1, (uint16_t)op);
+        if (sz < 0)
+            return false;
+        p += 1 + sz;
+    }
+    return p == end;
+}
+#endif
+
 /* Interns atom `idx` from its recorded position in the payload and memoises it
    in idx_to_atom. Reads through a scratch cursor so the caller's parse position
    is untouched. */
@@ -71441,6 +71492,22 @@ static JSValue JS_ReadFunctionTag(BCReaderState *s)
             b->regvm_owns_atoms = 0;
             goto fail_unregistered;
         }
+        /*
+         * `argv_safe` is never serialized, and a register bundle carries no
+         * stack code to scan, so recompute it from the register program.
+         */
+        {
+            bool rs = regvm_scan_argv_safe(b->regvm_code, b->regvm_len);
+#if !defined(NDEBUG)
+            /* 4.4: the stack scan JS_ReadFunctionBytecode ran must agree on
+               args_captured. (`argv_safe` is the stack VM's broader flag; the
+               register lowering elides dead argument stores, so the register
+               code is strictly more permissive, which is safe here.) */
+            assert(rs == (b->args_captured == 0));
+#endif
+            b->args_captured = !rs;
+            b->argv_safe = rs;
+        }
     }
 #endif
 
