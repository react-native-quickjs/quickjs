+QJS_AOT_STUB int qjs_aot_should_deopt(JSContext *ctx, uint32_t site)
+{
+    JSAotRun *r = aot_run_ensure(ctx->rt);
+
+    if (r == NULL || !r->sweep_on || r->sweep_runs == NULL ||
+        site >= r->deopt_count)
