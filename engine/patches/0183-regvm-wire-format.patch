+            } else { /* 'c', non-atom */
+                if (regvm_wire_get_leb(&w, w_end, &v))
+                    goto fail_leb;
+                sv = (int32_t)v;
+            }
+
+            if (!is_atom) {
+                if (fmt[m] == 'r') {
+                    if (sv < 0 || sv >= b->regvm_reg_count * (int)sizeof(JSValue) ||
