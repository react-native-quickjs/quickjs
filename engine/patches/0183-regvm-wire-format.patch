+        if ((op == ROP_binary_loc_reg || op == ROP_binary_loc_loc) &&
+            (uint32_t)ops[2] >= (uint32_t)b->var_count) {
+            JS_ThrowSyntaxError(ctx, "register local slot out of range");
+            goto fail_ins;
+        }
