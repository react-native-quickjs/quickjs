+            } else if (fmt[m] == 'u' || fmt[m] == 's') {
+                if (regvm_wire_get_leb(&w, w_end, &v) || v > 0xffff)
+                    goto fail_leb;
+                sv = (int32_t)v;
+            } else if (fmt[m] == 'I') {
+                if (regvm_wire_get_sleb(&w, w_end, &sv))
+                    goto fail_leb;
+            } else if (fmt[m] == 't') {
+                if (regvm_wire_get_sleb(&w, w_end, &sv))
+                    goto fail_leb;
