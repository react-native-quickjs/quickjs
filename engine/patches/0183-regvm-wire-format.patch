+        if (op == ROP_special_object && ops[1] == OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS)
+            borrowable = false;
+#if QJS_REGVM_THREAD
+        /* D13: the interpreter-eligibility flag is a property of the build, not
+           the bytecode, so it is recomputed here rather than serialized. Doing
