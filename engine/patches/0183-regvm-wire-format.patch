+/* Wire form of an atom operand: bc_put_atom's tagged-int / bundle-index
+   split, appended to the caller's buffer. */
+static int regvm_wire_put_atom(BCWriterState *s, DynBuf *d, JSAtom atom)
+{
+    uint32_t v;
+
+    if (__JS_AtomIsTaggedInt(atom)) {
+        v = (__JS_AtomToUInt32(atom) << 1) | 1;
+    } else {
+        if (bc_atom_to_idx(s, &v, atom))
+            return -1;
+        v <<= 1;
+    }
+    dbuf_put_leb128(d, v);
+    return 0;
+}
+
+/* exec -> wire. Register operands become ULEB128 register indices (a narrow
+   byte stays as it is), atoms the tagged-int / bundle-index ULEB, branch
+   offsets SLEB128 from the instruction end, wide 32-bit operands LEB128. The
+   walk is regvm_map_atoms2's. `wire_len` is written in front of the bytes. */
+static int regvm_wire_encode(BCWriterState *s, const JSFunctionBytecode *b)
+{
+    const uint8_t *code = b->regvm_code;
+    int len = b->regvm_len;
+    DynBuf wire;
+    int p = 0, rc = -1;
+
+    dbuf_init(&wire);
+    while (p < len) {
+        int op = code[p];
+        const char *fmt;
+        int q, m, kind = -1, nar;
+
+        if (op <= 0 || op >= ROP_COUNT || !(fmt = regvm_rop_fmt[op]))
+            goto done;
+        nar = regvm_rop_narrow((uint16_t)op);
+        dbuf_putc(&wire, (uint8_t)op);
+        q = p + 1;
+        for (m = 0; fmt[m]; m++) {
+            int need;
+            uint32_t v;
+            int32_t sv;
+
+            switch (fmt[m]) {
+            case 'r': need = nar ? 1 : 2; break;
+            case 'i': case 'b': need = 1; break;
+            case 'u': case 's': need = 2; break;
+            case 'I': case 'c': case 'a': need = 4; break;
+            case 't': need = nar ? 1 : 4; break;
+            default: goto done;
+            }
+            if (q + need > len)
+                goto done;
+            if (need == 4)
+                v = (uint32_t)code[q] | ((uint32_t)code[q + 1] << 8) |
+                    ((uint32_t)code[q + 2] << 16) |
+                    ((uint32_t)code[q + 3] << 24);
+            else if (need == 2)
+                v = (uint32_t)(code[q] | (code[q + 1] << 8));
+            else
+                v = code[q];
+            sv = (need == 1) ? (int32_t)(int8_t)v : (int32_t)v;
+            if (fmt[m] == 'b')
+                kind = (int)v;
+
+            switch (fmt[m]) {
+            case 'r':
+                if (nar)
+                    dbuf_putc(&wire, (uint8_t)v); /* narrow: stored byte as is */
+                else
+                    dbuf_put_leb128(&wire, v / (uint32_t)sizeof(JSValue));
+                break;
+            case 'i': case 'b':
+                dbuf_putc(&wire, (uint8_t)v);
+                break;
+            case 'u': case 's':
+                dbuf_put_leb128(&wire, v);
+                break;
+            case 'c':
+                if ((op == ROP_load_const || op == ROP_binary_cpool) &&
+                    kind == REG_CONST_ATOM) {
+                    if (regvm_wire_put_atom(s, &wire, (JSAtom)v))
+                        goto done;
+                } else {
+                    dbuf_put_leb128(&wire, v);
+                }
+                break;
+            case 'a':
+                if (regvm_wire_put_atom(s, &wire, (JSAtom)v))
+                    goto done;
+                break;
+            case 'I':
+                dbuf_put_sleb128(&wire, (int32_t)v);
+                break;
+            case 't':
+                dbuf_put_sleb128(&wire, sv);
+                break;
+            }
+            q += need;
+        }
+        p = q;
+    }
+    bc_put_leb128(s, (uint32_t)wire.size);
+    dbuf_put(&s->dbuf, wire.buf, wire.size);
+    rc = 0;
+ done:
+    dbuf_free(&wire);
+    return rc;
+}
