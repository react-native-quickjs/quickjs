Subject: Report the traced GC population and its composition

What this does
  Adds to JSMemoryUsage the size of the population the cycle collector walks, its
  composition by GC object type, and the size of the untraced side.

Why we need it
  The object count that was reported covers only JS objects and is a strict subset
  of the population the collector walks, so a cost derived from it is attributed to
  the wrong denominator, and the two differ by an amount that depends on the heap.

What it adds
  The counts are taken before the branches that skip most GC types, so every
  traced object is counted once, and they are produced by the loop that already
  walks the heap. Nothing is added to a hot path and no behaviour changes. No
  opcode is added or retired and BC_VERSION is unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.h
+++ b/quickjs.h
@@ -740,6 +740,16 @@
     int64_t c_func_count, array_count;
     int64_t fast_array_count, fast_array_elements;
     int64_t binary_object_count, binary_object_size;
+    /* The population the CYCLE COLLECTOR walks, and its composition.
+       `obj_count` is not it: JS_ComputeMemoryUsage increments that only for
+       JS_GC_OBJ_TYPE_JS_OBJECT and continues on every other GC type, so it is a
+       strict subset of gc_obj_list. Dividing a collection time by obj_count
+       therefore prices per-JSObject rather than per-traced-object, and the ratio
+       between the two is not constant across workloads: lazily-deserialized
+       function bytecodes are not traced while source-compiled ones are. */
+    int64_t traced_count, notrace_count;
+    int64_t traced_js_object, traced_fnbc, traced_shape, traced_var_ref,
+            traced_async, traced_other;
 } JSMemoryUsage;
 
 JS_EXTERN void JS_ComputeMemoryUsage(JSRuntime *rt, JSMemoryUsage *s);
--- a/quickjs.c
+++ b/quickjs.c
@@ -9320,6 +9320,7 @@
 
     list_for_each(el, &rt->gc_notrace_list) {
         JSGCObjectHeader *gp = list_entry(el, JSGCObjectHeader, link);
+        s->notrace_count++;
         if (JS_GC_TYPE(gp) == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE)
             compute_bytecode_size((JSFunctionBytecode *)gp, hp);
     }
@@ -9328,6 +9329,19 @@
         JSObject *p;
         JSShape *sh;
         JSShapeProperty *prs;
+
+        /* Counted before the `continues` below, which skip most GC types
+           because the size accounting only sizes two of them -- which is
+           exactly why obj_count is not the traced population. */
+        s->traced_count++;
+        switch (JS_GC_TYPE(gp)) {
+        case JS_GC_OBJ_TYPE_JS_OBJECT:         s->traced_js_object++; break;
+        case JS_GC_OBJ_TYPE_FUNCTION_BYTECODE: s->traced_fnbc++;      break;
+        case JS_GC_OBJ_TYPE_SHAPE:             s->traced_shape++;     break;
+        case JS_GC_OBJ_TYPE_VAR_REF:           s->traced_var_ref++;   break;
+        case JS_GC_OBJ_TYPE_ASYNC_FUNCTION:    s->traced_async++;     break;
+        default:                               s->traced_other++;     break;
+        }
 
         /* XXX: could count the other GC object types too */
         if (JS_GC_TYPE(gp) == JS_GC_OBJ_TYPE_FUNCTION_BYTECODE) {
