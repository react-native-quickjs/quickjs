+/* The double case of a fused compare, the counterpart of regvm_int_cmp. -1
+   means "not a double comparison". The inverted forms stay inverted: `!(a <
+   b)` is true for NaN where `a >= b` is false. */
+static inline int regvm_double_cmp(int sub, double a, double b)
+{
+    switch (sub) {
+    case REG_BIN_LT: return a < b;
+    case REG_BIN_LTE: return a <= b;
+    case REG_BIN_GT: return a > b;
+    case REG_BIN_GTE: return a >= b;
+    case REG_BIN_STRICT_EQ: return a == b;
+    case REG_BIN_STRICT_NEQ: return a != b;
+    default: return -1;
+    }
+}
