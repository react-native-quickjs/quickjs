+/*
+ * The bitwise and shift fast path. For an int operand, or a double inside the
+ * int32 range, JS_ToInt32/ToUint32 is only a truncation, so it is done here.
+ * Anything else (out-of-range doubles included, since `(int32_t)d` is
+ * undefined there) goes to the slow path. Returns 0 for anything it does not
+ * handle.
+ */
+static inline __attribute__((always_inline)) int regvm_to_int32_fast(JSValue v, int32_t *out)
+{
+    int tag = JS_VALUE_GET_TAG(v);
+    if (likely(tag == JS_TAG_INT)) {
+        *out = JS_VALUE_GET_INT(v);
+        return 1;
+    }
+    if (tag == JS_TAG_FLOAT64) {
+        double d = JS_VALUE_GET_FLOAT64(v);
+        if (likely(d >= -2147483648.0 && d < 2147483648.0)) {
+            *out = (int32_t)d;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static inline __attribute__((always_inline)) int regvm_bitwise_fast(int sub, JSValue a, JSValue b, JSValue *out)
+{
+    int32_t v1, v2, r;
+
+    if (unlikely(!regvm_to_int32_fast(a, &v1) || !regvm_to_int32_fast(b, &v2)))
+        return 0;
+    switch (sub) {
+    case REG_BIN_AND: r = v1 & v2; break;
+    case REG_BIN_OR:  r = v1 | v2; break;
+    case REG_BIN_XOR: r = v1 ^ v2; break;
+    case REG_BIN_SHL: r = (int32_t)((uint32_t)v1 << (v2 & 31)); break;
+    case REG_BIN_SAR: r = v1 >> (v2 & 31); break;
+    case REG_BIN_SHR:
+        /* `>>>` is the one operation whose result is not an int32: a value above
+           INT32_MAX comes back as a double. */
+        *out = js_uint32((uint32_t)v1 >> (v2 & 31));
+        return 1;
+    default: return 0;
+    }
+    *out = js_int32(r);
+    return 1;
+}
+
