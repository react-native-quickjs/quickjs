+/*
+ * The bitwise and shift fast path. The engine's `js_binary_logic_slow` and
+ * `js_shr_slow` convert both operands with JS_ToInt32/ToUint32 and then do the
+ * 32-bit operation; for an operand that is already an int, or a double inside
+ * the int32 range, that conversion is only a truncation, so it is done here. A
+ * double outside the range, a BigInt, a string or anything else falls through
+ * to the slow path, which owns the modular conversion, the BigInt cases and the
+ * exceptions. Returns 0 for anything it does not handle.
+ *
+ * `(int32_t)d` is only defined for a `d` inside the int32 range, so the range is
+ * checked rather than relied on; `2147483648.0` itself goes out of line, where
+ * the modular conversion lives.
+ */
+static inline __attribute__((always_inline)) int regvm_to_int32_fast(JSValue v, int32_t *out)
+{
+    int tag = JS_VALUE_GET_TAG(v);
+    if (likely(tag == JS_TAG_INT)) {
+        *out = JS_VALUE_GET_INT(v);
+        return 1;
+    }
+    if (tag == JS_TAG_FLOAT64) {
+        double d = JS_VALUE_GET_FLOAT64(v);
+        if (likely(d >= -2147483648.0 && d < 2147483648.0)) {
+            *out = (int32_t)d;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static inline __attribute__((always_inline)) int regvm_bitwise_fast(int sub, JSValue a, JSValue b, JSValue *out)
+{
+    int32_t v1, v2, r;
