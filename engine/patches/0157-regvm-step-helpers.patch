+static uint8_t *REGVM_CC regvm_s_ROP_add(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ { REGVM_BIN_OP(REG_BIN_ADD); }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
+
+static uint8_t *REGVM_CC regvm_s_ROP_add_brand(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
