+static uint8_t *REGVM_CC regvm_s_ROP_append(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int w = RD_REG();
+                JSValue *sp = &regs[w + 3];
+                if (js_append_enumerate(ctx, sp))
+                    goto exception;
+                REGVM_NEXT();
+            }
+            /* The with family. Each is a two-armed branch: if the name is in
+               the object and not in Symbol.unscopables, do the arm's work and
+               jump to the with body; otherwise fall through. */
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
