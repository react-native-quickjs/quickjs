+                int o = RD_REG();
+                int k = -1;
+                JSAtom atom;
+                int f, op_flags, flags, ret, kind;
+                JSValue value = JS_UNDEFINED, getter = JS_UNDEFINED;
+                JSValue setter = JS_UNDEFINED;
+                if (op == ROP_define_method_computed) {
+                    k = RD_REG();
+                    atom = JS_ValueToAtom(ctx, regs[k]);
+                    if (atom == JS_ATOM_NULL)
+                        goto exception;
