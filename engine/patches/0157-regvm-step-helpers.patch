+static uint8_t *REGVM_CC regvm_s_ROP_binary(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int sub = RD_U8();
+                int a = RD_REG();
+                int c = RD_REG();
+                JSValue out;
+#ifdef QJS_REGVM_COUNT
+                js_regvm_binsub[sub]++;
+#endif
+                if (!regvm_num_fast(sub, regs[a], regs[c], &out) &&
+                    js_regvm_binary(ctx, sub, regs[a], regs[c], &out))
+                    goto exception;
+                SET_REG_P(d, out);
+                REGVM_NEXT();
+            }
+            /* The same operation with a local-slot source. The slot is read
+               before any user code can run, so it needs no stabilizing. */
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
