+static uint8_t *REGVM_CC regvm_s_ROP_iter_close(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int it = RD_REG();
+                int nx = RD_REG();
+                int k;
+                /*
+                 * The entry this loop pushed is the innermost iterator entry,
+                   but not
+                 * necessarily on top: a finally running inside the loop has its
+                   continuation
+                 * above it, and that stays. So the entry is found, and the
+                   entries above it
+                 * move down over the gap.
+                 *
+                 * Whether there is anything to close is the entry's answer, not
+                   the
+                 * register's: the register holds a copy the allocator may have
+                   placed
+                 * elsewhere.
+                 */
+                for (k = rf->nctl - 1; k >= 0; k--)
+                    if (rf->ctl[k].kind == REG_CTL_ITER)
+                        break;
+                if (k >= 0) {
+                    JSValue iter = rf->ctl[k].iter;
+                    JS_FreeValue(ctx, rf->ctl[k].next);
+                    rf->ctl[k].iter = JS_UNDEFINED;
+                    for (; k < rf->nctl - 1; k++)
+                        rf->ctl[k] = rf->ctl[k + 1];
+                    --rf->nctl;
+                    if (!JS_IsUndefined(iter)) {
+                        if (JS_IteratorClose(ctx, iter, false)) {
+                            JS_FreeValue(ctx, iter);
+                            goto exception;
+                        }
+                        JS_FreeValue(ctx, iter);
+                    }
+                }
+                /* The stack VM pops these slots. Registers retain ownership;
+                   they may be shared with another logical operand. */
+                REGVM_NEXT();
+            }
+            /*
+             * OP_drop of a control-stack sentinel removes that entry. A
+               for-of's entry
+             * owns the iterator and next method it recorded, so those are
+               released; a
+             * try's entry owns nothing. The only code that drops a sentinel by
+               hand is a
+             * try about to run its finally and a delegation driving the
+               iteration
+             * protocol, so no open iterator is lost.
+             */
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
