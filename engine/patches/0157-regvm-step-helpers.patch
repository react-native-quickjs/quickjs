+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int o = RD_REG();
+                int home = RD_REG();
+                if (JS_AddBrand(ctx, regs[o], regs[home]) < 0)
+                    goto exception;
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
