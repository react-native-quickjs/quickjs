+static uint8_t *REGVM_CC regvm_s_ROP_call(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int c = RD_REG();
+                int ab = RD_REG();
+                int na = RD_U8();
+                /* named `oargv`, not `rf->argv`: the activation's own argument
+                   vector is the parameter `rf->argv`, and the nested-call code
+                   saves it. */
+                JSValue *oargv = &regs[ab];
+                AOT_PROF_CALL(ctx, b, (uint32_t)(rpc - b->regvm_code), regs[c], na);
+#ifdef QJS_REGVM_COUNT
+                js_regvm_argmoves += (uint64_t)na;
+#endif
+#if QJS_REGVM_INLOOP_CALL
+                REGVM_INLOOP_CALL(regs[c], JS_UNDEFINED, d, ab, na);
+#endif
+                if (!js_call_c_function_fast(ctx, regs[c], JS_UNDEFINED, na,
+                                             vc(oargv), 0, &ret_val))
+                    ret_val = JS_CallInternal(ctx, regs[c], JS_UNDEFINED,
+                                              JS_UNDEFINED, na, vc(oargv), 0);
+                if (JS_IsException(ret_val))
+                    goto exception;
+                SET_REG_P(d, ret_val);
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
