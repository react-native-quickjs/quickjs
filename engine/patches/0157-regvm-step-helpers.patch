+static uint8_t *REGVM_CC regvm_s_ROP_add_imm_s(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG8();
+                int a = RD_REG8();
+                int32_t imm = RD_OFF8();
+                JSValue v = regs[a];
+                JSValue out;
+
+                if (JS_VALUE_GET_TAG(v) == JS_TAG_INT) {
+                    int32_t sum;
+
+                    if (likely(!__builtin_add_overflow(JS_VALUE_GET_INT(v), imm, &sum))) {
+                        SET_REG_P(d, js_int32((int32_t)sum));
+                        REGVM_NEXT();
+                    }
+                    SET_REG_P(d, js_float64((double)((int64_t)JS_VALUE_GET_INT(v) + imm)));
+                    REGVM_NEXT();
+                }
+                if (!regvm_num_fast(REG_BIN_ADD, v, js_int32(imm), &out) &&
+                    js_regvm_binary(ctx, REG_BIN_ADD, v, js_int32(imm), &out))
+                    goto exception;
+                SET_REG_P(d, out);
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
