+uint8_t *regvm_step(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    return regvm_step_table[*ip](ip, fr, rf, ctx);
+}
+
+/* The P1 census: ROPs with no step form.  Target 0. */
+int regvm_step_uncovered(void)
+{
+    int i, n = 0;
+    for (i = 0; i < ROP_COUNT; i++)
+        if (!regvm_step_covered[i])
+            n++;
+    return n;
+}
