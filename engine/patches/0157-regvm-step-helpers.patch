+static uint8_t *REGVM_CC regvm_s_ROP_get_field_chain(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                /* X3b: two reads, two destinations, one dispatch. The second
+                   receiver is the first destination, so it is read back after
+                   the first SET_REG -- exactly the value the dropped second
+                   instruction would have consumed. */
+                int d1 = RD_REG();
+                int r1 = RD_REG();
+                JSAtom atom1 = RD_U32();
+                int site1 = RD_U16();
+                int d2 = RD_REG();
+                int r2 = RD_REG();
+                JSAtom atom2 = RD_U32();
+                int site2 = RD_U16();
+                JSValue v1, v2;
+                int own1 = 1, own2 = 1;
+                (void)r2;
+                if (site1 != REG_IC_NONE &&
+                    regvm_own_read_hit(pic, b->regvm_pic_holder, regs[r1], site1, &v1)) {
+                    own1 = 0;
+                } else if (site1 == REG_IC_NONE) {
+                    v1 = JS_GetProperty(ctx, regs[r1], atom1);
+                } else {
+                    v1 = regvm_get_field_ic(ctx, b, &pic, regs[r1], atom1, site1);
+                }
+                if (JS_IsException(v1))
+                    goto exception;
+#if QJS_DRC
+                SET_REG_B(d1, v1);
+                if (own1)
+                    REG_ADOPT(ctx->rt, v1);
+#else
+                SET_REG_P(d1, v1);
+                (void)own1;
+#endif
+                if (site2 != REG_IC_NONE &&
+                    regvm_own_read_hit(pic, b->regvm_pic_holder, regs[d1], site2, &v2)) {
+                    own2 = 0;
+                } else if (site2 == REG_IC_NONE) {
+                    v2 = JS_GetProperty(ctx, regs[d1], atom2);
+                } else {
+                    v2 = regvm_get_field_ic(ctx, b, &pic, regs[d1], atom2, site2);
+                }
+                if (JS_IsException(v2))
+                    goto exception;
+#if QJS_DRC
+                SET_REG_B(d2, v2);
+                if (own2)
+                    REG_ADOPT(ctx->rt, v2);
+#else
+                SET_REG_P(d2, v2);
+                (void)own2;
+#endif
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
