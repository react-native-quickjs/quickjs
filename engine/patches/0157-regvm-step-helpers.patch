+static uint8_t *REGVM_CC regvm_s_ROP_with_get(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int o = RD_REG();
+                JSAtom atom = RD_U32();
+                int is_with = RD_U8();
+                int32_t off = RD_I32();
+                int taken = JS_HasProperty(ctx, regs[o], atom);
+                if (unlikely(taken < 0))
+                    goto exception;
+                if (taken && is_with) {
+                    taken = js_has_unscopable(ctx, regs[o], atom);
+                    if (unlikely(taken < 0))
+                        goto exception;
+                    taken = !taken;
+                }
+                if (taken) {
+                    JSValue val;
+                    if (op == ROP_with_get) {
+                        val = JS_GetProperty(ctx, regs[o], atom);
+                    } else {
+                        int r = JS_DeleteProperty(ctx, regs[o], atom, 0);
+                        if (unlikely(r < 0))
+                            goto exception;
+                        val = js_bool(r);
+                    }
+                    if (unlikely(JS_IsException(val)))
+                        goto exception;
+                    SET_REG_P(d, val);
+                    rpc += off;
+                }
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
