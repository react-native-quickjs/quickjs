+                           arguments and the typed arrays */
+#ifdef QJS_REGVM_COUNT
+                        js_regvm_elem[1]++;
+#endif
+                    } else {
+#ifdef QJS_REGVM_COUNT
+                        js_regvm_elem[2]++;
+#endif
+                        val = JS_GetPropertyValueConst(ctx, recv, k);
+                    }
+                } else {
+#ifdef QJS_REGVM_COUNT
+                    js_regvm_elem[2]++;
+#endif
+                    val = JS_GetPropertyValueConst(ctx, recv, k);
+                }
+                if (JS_IsException(val))
