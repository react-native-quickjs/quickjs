+static uint8_t *REGVM_CC regvm_s_ROP_with_put(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int v = RD_REG();
+                int o = RD_REG();
+                JSAtom atom = RD_U32();
+                int is_with = RD_U8();
+                int32_t off = RD_I32();
+                int taken = JS_HasProperty(ctx, regs[o], atom);
+                if (unlikely(taken < 0))
+                    goto exception;
+                if (taken && is_with) {
+                    taken = js_has_unscopable(ctx, regs[o], atom);
+                    if (unlikely(taken < 0))
+                        goto exception;
+                    taken = !taken;
