+/* yield / yield_star: park, or on resume deliver the handshake slots. */
+static uint8_t *REGVM_CC regvm_s_yield(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSValue *regs = fr;
+    JSFunctionBytecode *b = rf->b;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    int s = RD_REG();
+    int d = RD_REG();
+    int d2 = RD_REG();
+    if (ip == rf->resume_marker) {
+        SET_REG_P(d, REGVM_SLOT(1));
+        REGVM_SLOT(1) = JS_UNDEFINED;
+        SET_REG_P(d2, REGVM_SLOT(2));
+        REGVM_SLOT(2) = JS_UNDEFINED;
+        rf->resume_marker = NULL;
+        return rpc;
+    }
+#if QJS_DRC
+    REGVM_SLOT(1) = regs[s];
+#else
+    JS_FreeValue(ctx, REGVM_SLOT(1));
+    REGVM_SLOT(1) = regs[s];
+#endif
+    regs[s] = JS_UNDEFINED;
+    rf->sf->cur_pc = ip;
+    REGVM_STEP_SUSPEND_CODE(js_int32(op == ROP_yield ? FUNC_RET_YIELD
+                                                     : FUNC_RET_YIELD_STAR));
+}
+
+/* await: park, or on resume deliver the single handshake slot. */
+static uint8_t *REGVM_CC regvm_s_await(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSValue *regs = fr;
+    JSFunctionBytecode *b = rf->b;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    int s = RD_REG();
+    int d = RD_REG();
+    (void)op;
+    if (ip == rf->resume_marker) {
+        rf->resume_marker = NULL;
+        SET_REG_P(d, REGVM_SLOT(1));
+        REGVM_SLOT(1) = JS_UNDEFINED;
+        return rpc;
+    }
+#if QJS_DRC
+    REGVM_SLOT(1) = regs[s];
+#else
+    JS_FreeValue(ctx, REGVM_SLOT(1));
+    REGVM_SLOT(1) = regs[s];
+#endif
+    regs[s] = JS_UNDEFINED;
+    rf->sf->cur_pc = ip;
+    REGVM_STEP_SUSPEND_CODE(js_int32(FUNC_RET_AWAIT));
+}
