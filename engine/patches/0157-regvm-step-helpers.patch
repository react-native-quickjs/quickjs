+/*
+ * Hand-written twins.  These are the bodies the extractor refuses: they
+ * suspend the frame, leave the activation, or use the monolith's stack
+ * pointer.  They are the contract's edge cases (plan section 3.3).
+ */
+
+/* A throw-only opcode: the monolith's `L_default`.  The register backend
+   never emits these, so the step engine reports them rather than running. */
+static uint8_t *REGVM_CC regvm_s_default(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    (void)fr; (void)rf;
+    JS_ThrowInternalError(ctx, "register VM: unimplemented opcode %d", *ip);
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
+
+/* Park the frame the way REGVM_SUSPEND does, but return the sentinel instead
+   of jumping to the monolith's done_generator.  `regs`, `b`, `ctx`, `rf` must
+   be in scope. */
+#define REGVM_STEP_SUSPEND_CODE(code_) do { \
+        JSValue _sus_code = (code_); \
+        rf->sf->rv_owns_regs = (JS_VALUE_GET_TAG(_sus_code) == JS_TAG_INT); \
+        if (rf->sf->rv_owns_regs) \
+            js_regvm_drc_suspend(ctx->rt, regs, \
+                                 (uint32_t)(b->regvm_reg_count + REGVM_HS - 1)); \
+        REGVM_SLOT(0) = js_int32(rf->nctl); \
+        rf->sf->cur_sp = regs + b->regvm_reg_count + REGVM_HS - 1; \
+        rf->ret = _sus_code; \
+        return REGVM_STEP_SUSPEND; \
+    } while (0)
+
+/* The initial yield parks too, and parameter defaults may already have left
+   live values in the registers, so it owns the window unconditionally. */
+#define REGVM_STEP_SUSPEND_OWN(code_) do { \
+        JSValue _sus_code = (code_); \
+        rf->sf->rv_owns_regs = 1; \
+        js_regvm_drc_suspend(ctx->rt, regs, \
+                             (uint32_t)(b->regvm_reg_count + REGVM_HS - 1)); \
+        REGVM_SLOT(0) = js_int32(rf->nctl); \
+        rf->sf->cur_sp = regs + b->regvm_reg_count + REGVM_HS - 1; \
+        rf->ret = _sus_code; \
+        return REGVM_STEP_SUSPEND; \
+    } while (0)
+
+/* return: the frame hands its value to the caller and leaves. */
+static uint8_t *REGVM_CC regvm_s_return(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSValue *regs = fr;
+    JSFunctionBytecode *b = rf->b;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    int s = RD_REG();
+    (void)op;
+    if (rf->flags & JS_CALL_FLAG_GENERATOR) {
+#if QJS_DRC
+        REGVM_SLOT(1) = js_dup(regs[s]);
+#else
+        JS_FreeValue(ctx, REGVM_SLOT(1));
+        REGVM_SLOT(1) = regs[s];
+#endif
+        regs[s] = JS_UNDEFINED;
+        rf->sf->cur_pc = rpc;
+        REGVM_STEP_SUSPEND_CODE(JS_UNDEFINED);
+    }
+    {
+        JSValue rv = regs[s];
+#if QJS_DRC
+        if (JS_VALUE_HAS_REF_COUNT(rv))
+            JS_REF_COUNT(JS_VALUE_GET_PTR(rv))++;
+#endif
+        regs[s] = JS_UNDEFINED;
+        rf->ret = rv;
+    }
+    return REGVM_COLD_RET;
+}
+
+static uint8_t *REGVM_CC regvm_s_return_undefined(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSValue *regs = fr;
+    JSFunctionBytecode *b = rf->b;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    (void)op;
+    if (rf->flags & JS_CALL_FLAG_GENERATOR) {
+#if QJS_DRC
+        REGVM_SLOT(1) = JS_UNDEFINED;
+#else
+        JS_FreeValue(ctx, REGVM_SLOT(1));
+        REGVM_SLOT(1) = JS_UNDEFINED;
+#endif
+        rf->sf->cur_pc = rpc;
+        REGVM_STEP_SUSPEND_CODE(JS_UNDEFINED);
+    }
+    rf->ret = JS_UNDEFINED;
+    return REGVM_COLD_RET;
+}
