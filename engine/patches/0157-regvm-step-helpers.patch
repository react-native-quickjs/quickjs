+static uint8_t *REGVM_CC regvm_s_ROP_binary_cpool(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int sub = RD_U8();
+                int a = RD_REG();
+                int kind = RD_U8();
+                uint32_t idx = RD_U32();
+                JSValue out;
+                if (kind == REG_CONST_CPOOL) {
+                    if (!regvm_num_fast(sub, regs[a], b->cpool[idx], &out) &&
+                        js_regvm_binary(ctx, sub, regs[a], b->cpool[idx], &out))
+                        goto exception;
+                } else {
+                    JSValue cst = JS_AtomToValue(ctx, idx);
+                    if (JS_IsException(cst))
+                        goto exception;
+                    if (!regvm_num_fast(sub, regs[a], cst, &out) &&
+                        js_regvm_binary(ctx, sub, regs[a], cst, &out)) {
