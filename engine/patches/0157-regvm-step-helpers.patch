+static uint8_t *REGVM_CC regvm_s_ROP_apply_arguments(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int w = RD_REG();
+                int d = RD_REG();
+                int idx = RD_U16();
+                JSValue *sp = &regs[w + 3];
+                JSObject *pa = js_args_apply_is_builtin(sp[-2]);
+                if (likely(pa != NULL &&
+                           (rf->arg_buf == (JSValue *)rf->argv ||
+                            rf->argc <= b->arg_count))) {
+                    if (unlikely(check_function(pa->u.cfunc.realm, sp[-3])))
+                        goto exception;
+                    ret_val = JS_Call(ctx, sp[-3], sp[-1], rf->argc, vc(rf->arg_buf));
+                } else {
+                    ret_val = js_args_apply_reified(ctx, &rf->var_buf[idx], sp - 3,
+                                                    rf->argc, rf->argv, rf->sf, b->arg_count);
+                }
+                if (JS_IsException(ret_val))
+                    goto exception;
+                SET_REG_P(d, ret_val);
+                REGVM_NEXT();
+            }
+ exception:
+    rf->ret = JS_EXCEPTION;
+    return NULL;
+}
