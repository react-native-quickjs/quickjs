+                    if (sum >= INT32_MIN && sum <= INT32_MAX) {
+                        SET_REG_P(d, js_int32((int32_t)sum));
+                        REGVM_NEXT();
+                    }
+                    SET_REG_P(d, js_float64((double)((int64_t)JS_VALUE_GET_INT(v) + imm)));
+                    REGVM_NEXT();
