+static uint8_t *REGVM_CC regvm_s_ROP_apply_eval(uint8_t *ip, JSValue *fr, JSRegRun *rf, JSContext *ctx)
+{
+    JSFunctionBytecode *b = rf->b;
+    JSObject *p = JS_VALUE_GET_OBJ(rf->sf->cur_func);
+    JSRegPIC *pic = rf->pic;
+    uint8_t *rpc = ip;
+    int op = *rpc++;
+    JSValue ret_val = JS_UNDEFINED;
+    JSValue *regs = fr;
+    (void)b; (void)p; (void)pic; (void)rpc; (void)op; (void)ret_val; (void)regs;
+ {
+                int d = RD_REG();
+                int f = RD_REG();
+                int arr = RD_REG();
+                int scope = RD_U16() - 1;
+                uint32_t len = 0;
+                /* build_arg_list duplicates, so the array value stays usable */
+                JSValue *tab = build_arg_list(ctx, &len, regs[arr]);
+                if (!tab)
+                    goto exception;
+                if (js_same_value(ctx, regs[f], ctx->eval_obj)) {
+                    JSValue src = (len >= 1) ? tab[0] : JS_UNDEFINED;
+                    ret_val = JS_EvalObject(ctx, JS_UNDEFINED, src,
+                                            JS_EVAL_TYPE_DIRECT, scope);
+                } else {
+                    ret_val = JS_Call(ctx, regs[f], JS_UNDEFINED, len, vc(tab));
+                }
