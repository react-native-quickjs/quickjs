+/* Fold newly appended instructions into the argument index, once each, so the
+   lowering stays linear. Mirrors the first pass of regvm_arg_retarget_scan;
+   `aw_last_win` replaces its second pass. */
+static void regvm_arg_index_sync(JSRegIR *ir)
+{
+    int i;
+    if (ir->aw_n <= 0)
+        return;
+    for (i = ir->aw_scanned; i < ir->n_insns; i++) {
+        const JSRegInsn *in = &ir->insns[i];
+        const char *fmt = regvm_rop_fmt[in->rop];
+        int di, di2, k;
+        if (!fmt)
+            continue;
+        di = regvm_own_dest_index(in->rop);
+        if (!regvm_own_has_dest(in->rop) || fmt[di] != 'r')
+            di = -1;
+        di2 = di >= 0 ? regvm_own_second_dest_index(in->rop) : -1;
+        for (k = 0; k < in->n_ops && fmt[k]; k++) {
+            int r = in->ops[k];
+            if (fmt[k] != 'r' || k == di || (di2 >= 0 && k == di2))
+                continue;
+            if (r >= 0 && r < ir->aw_n)
+                ir->aw_reads[r]++;
+        }
+        if (di >= 0) {
+            int d = in->ops[di];
+            if (d >= 0 && d < ir->aw_n)
+                ir->aw_def[d] = i;
+        }
+        for (k = 0; k < in->n_ops && fmt[k]; k++)
+            if (in->ops[k] <= REGVM_WIN(0))
+                ir->aw_last_win = i;
+    }
+    ir->aw_scanned = ir->n_insns;
+}
+
+/* Record that the producer at `def` now writes the call window instead of
+   `v`: forget v's old definition and note that `def` names the window. */
+static void regvm_arg_retarget_insn(JSRegIR *ir, int def, int win, int v)
+{
+    JSRegInsn *d = &ir->insns[def];
+    d->ops[regvm_own_dest_index(d->rop)] = win;
+    if (ir->aw_n <= 0)
+        return;
+    if (v >= 0 && v < ir->aw_n)
+        ir->aw_def[v] = -1;
+    if (def > ir->aw_last_win)
+        ir->aw_last_win = def;
+}
+
+static int regvm_arg_retarget(JSRegIR *ir, int v,
+                              const int *home_of, int n_values)
+{
+    int result;
+    if (v < 0 || (home_of && v < n_values && home_of[v] >= 0)) {
+        result = -1;
+    } else if (v >= ir->aw_n) {
+        /* No index (allocation failed, or a value outside it): full scan. */
+        result = regvm_arg_retarget_scan(ir, v, home_of, n_values);
+    } else {
+        int def;
+        regvm_arg_index_sync(ir);
+        def = ir->aw_def[v];
+        if (def < 0 || ir->aw_reads[v] != 0) {
+            result = -1;
+        } else {
+            uint8_t o = ir->insns[def].origin;
+            if (o == REGVM_ORIG_PHI || o == REGVM_ORIG_CYCLE ||
+                o == REGVM_ORIG_SPLIT || o == REGVM_ORIG_HOMECOPY)
+                result = -1;
+            else if (ir->aw_last_win >= def)
+                result = -1;
+            else
+                result = def;
+        }
+    }
+#ifdef QJS_REGVM_ARGCHECK
+    {
+        int old = regvm_arg_retarget_scan(ir, v, home_of, n_values);
+        if (old != result) {
+            fprintf(stderr, "regvm ARGCHECK: v=%d fast=%d scan=%d\n",
+                    v, result, old);
+            abort();
+        }
+    }
+#endif
+    return result;
+}
