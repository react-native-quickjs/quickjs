+    uint32_t val;
+    if (bc_get_leb128(s, &val))
+        return -1;
+    if (val > INT32_MAX) {
+        JS_ThrowSyntaxError(s->ctx, "invalid count");
+        return -1;
+    }
+    *pval = (int)val;
+    return 0;
