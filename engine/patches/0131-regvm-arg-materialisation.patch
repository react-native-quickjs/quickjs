+/* Decide which of one call's arguments can be produced in place. `pop` names
+   the call's n_all operands; the arguments are argc entries from arg_off.
+   defs[a] is the producer to retarget, or -1. No two arguments share a
+   producer. */
+static void regvm_stage_args(const JSRegIR *ir, const int *pop, int n_all,
+                             int arg_off, int argc, const int *home_of,
+                             int n_values, int *defs)
+{
+    int a, b;
+    for (a = 0; a < argc; a++) {
+        int v = pop[arg_off + a], n = 0;
+        defs[a] = regvm_arg_retarget(ir, v, home_of, n_values);
+        if (defs[a] < 0)
+            continue;
+        for (b = 0; b < n_all; b++)
+            if (pop[b] == v)
+                n++;
+        if (n != 1)
+            defs[a] = -1;
+    }
+    for (a = 0; a < argc; a++) {
+        if (defs[a] < 0)
+            continue;
+        for (b = a + 1; b < argc; b++)
+            if (defs[b] == defs[a])
+                defs[a] = defs[b] = -1;
+    }
+}
