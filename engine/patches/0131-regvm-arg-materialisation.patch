+static int regvm_own_has_dest(uint16_t rop);
+static int regvm_own_dest_index(uint16_t rop);
+static int regvm_own_second_dest_index(uint16_t rop);
+
+/*
+ * Which call arguments can be produced straight into the window, so the
+ * staging `ROP_move` into `REGVM_WIN(a)` disappears. Every refusal is a
+ * correctness rule:
+ *   - a version of a variable's home (`home_of[v] >= 0`): the home write
+ *     would be lost;
+ *   - a value any emitted instruction reads: the copy must be its only use;
+ *   - a value named by more than one of the call's operands;
+ *   - a producer that is an edge copy (phi, cycle break, split, home copy);
+ *   - a producer, or anything between it and here, that names the window:
+ *     a call in the interval would clobber a sibling argument.
+ *
+ * Returns the producer's index, or -1 to fall back to the move.
+ */
+static int regvm_arg_retarget(const JSRegIR *ir, int v,
+                              const int *home_of, int n_values)
+{
+    int i, def = -1, reads = 0;
+    if (v < 0 || (home_of && v < n_values && home_of[v] >= 0))
+        return -1;
+    for (i = 0; i < ir->n_insns; i++) {
+        const JSRegInsn *in = &ir->insns[i];
+        const char *fmt = regvm_rop_fmt[in->rop];
+        int di, di2, k;
+        if (!fmt)
+            continue;
+        di = regvm_own_dest_index(in->rop);
+        if (!regvm_own_has_dest(in->rop) || fmt[di] != 'r')
+            di = -1;
+        di2 = di >= 0 ? regvm_own_second_dest_index(in->rop) : -1;
+        for (k = 0; k < in->n_ops && fmt[k]; k++) {
+            if (fmt[k] != 'r' || k == di || (di2 >= 0 && k == di2))
+                continue;
+            if (in->ops[k] == v)
+                reads++;
+        }
+        if (di >= 0 && in->ops[di] == v)
+            def = i;
+    }
+    if (def < 0 || reads != 0)
+        return -1;
+    {
+        const JSRegInsn *d = &ir->insns[def];
+        uint8_t o = d->origin;
+        if (o == REGVM_ORIG_PHI || o == REGVM_ORIG_CYCLE ||
+            o == REGVM_ORIG_SPLIT || o == REGVM_ORIG_HOMECOPY)
+            return -1;
+    }
+    /* Nothing from the producer to here may name the window. */
+    for (i = def; i < ir->n_insns; i++) {
+        const JSRegInsn *in = &ir->insns[i];
+        const char *fmt = regvm_rop_fmt[in->rop];
+        int k;
+        if (!fmt)
+            continue;
+        for (k = 0; k < in->n_ops && fmt[k]; k++)
+            if (in->ops[k] <= REGVM_WIN(0))
+                return -1;
+    }
+    return def;
+}
