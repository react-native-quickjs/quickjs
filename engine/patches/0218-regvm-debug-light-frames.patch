+
+static bool regvm_debug_frame_at_level(JSRuntime *rt, int level,
+                                       JSStackFrame *scratch,
+                                       JSRegDebugFrame *out)
+{
+    JSRegDebugIter it;
+    JSRegDebugFrame fr;
+    int i = 0;
