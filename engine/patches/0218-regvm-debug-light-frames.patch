+static int regvm_debug_eval_light(JSContext *ctx, struct JSRegRun *lf,
+                                  JSStackFrame *target, JSStackFrame *saved,
+                                  JSValue **peval_vars)
+{
+    (void)ctx;
+    (void)lf;
+    (void)target;
+    (void)saved;
+    *peval_vars = NULL;
+    return 0;
+}
+#endif
