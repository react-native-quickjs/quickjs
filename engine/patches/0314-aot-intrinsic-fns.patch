Subject: Publish the builtin function pointers and the C-function layout to AOT units

What this does
  Adds `qjs_aot_intrinsic_fn(id)`, which returns the C function pointer of ten
  builtins (Math.sqrt, abs, floor, ceil, round, sin, cos, min, max, and the global
  parseInt), and three layout fields: the class id of a C function object and the
  offsets of its function pointer and magic number.

Why we need it
  A unit that lowers `Math.floor(x)` inline has to be sure the callee is the
  builtin and not something the program put in its place. The builtins' functions
  are static in the engine, so the unit cannot name them; with the pointers and the
  offsets it checks class, pointer and (for min/max) magic on the callee object, and
  falls back to the ordinary call otherwise. The pointers are the same in every
  runtime and realm. The layout fields are folded into the layout hash like every
  other field.

--- a/quickjs-aot-rt.h
+++ b/quickjs-aot-rt.h
@@ -132,6 +132,9 @@
     /* Where a closure cell keeps the pointer to its value, so a unit reads a
        captured variable through the function object's cell vector inline. */
     uint32_t off_varref_pvalue;
+    /* A C function object: its class id and where it keeps the function pointer
+       and the magic number, so a unit can tell a builtin from any other callee. */
+    uint32_t class_c_function, off_cfunc_c_function, off_cfunc_magic;
 } JSAotGenLayout;
 
 /* Fold every field after `hash` (the hash field itself is excluded). Shared by
@@ -276,6 +279,17 @@
    old and move in the owning build). Used where the handler uses SET_REG_P. */
 void qjs_aot_set_reg_p(JSContext *ctx, JSValue *fr, int off, JSValue v);
 
+/* The builtins a unit lowers inline. `qjs_aot_intrinsic_fn(id)` returns the C
+   function pointer the builtin's function object holds (`min` and `max` share
+   one, told apart by the magic number 0 and 1), or NULL for an unknown id. The
+   pointers are the same in every runtime and realm. */
+enum {
+    QJS_AOT_INTR_SQRT, QJS_AOT_INTR_ABS, QJS_AOT_INTR_FLOOR, QJS_AOT_INTR_CEIL,
+    QJS_AOT_INTR_ROUND, QJS_AOT_INTR_SIN, QJS_AOT_INTR_COS, QJS_AOT_INTR_MIN,
+    QJS_AOT_INTR_MAX, QJS_AOT_INTR_PARSEINT, QJS_AOT_INTR_COUNT
+};
+void *qjs_aot_intrinsic_fn(int id);
+
 /* Fill one site's polymorphic property cache from an object the compiled body
    just checked. Returns 1 with the slot offset, or 0 when the property is not
    own data (or not writable, for a write) and the body must exit. Runs no
--- a/quickjs.c
+++ b/quickjs.c
@@ -60659,6 +60659,9 @@
     out->off_rc_back = (uint32_t)(offsetof(JSMallocBlockHeader, user_data) -
                                   offsetof(JSMallocBlockHeader, ref_count));
     out->off_varref_pvalue = (uint32_t)offsetof(JSVarRef, pvalue);
+    out->class_c_function = JS_CLASS_C_FUNCTION;
+    out->off_cfunc_c_function = (uint32_t)offsetof(JSObject, u.cfunc.c_function);
+    out->off_cfunc_magic = (uint32_t)offsetof(JSObject, u.cfunc.magic);
     out->hash = qjs_aot_layout_hash(out);
 }
 
@@ -88652,6 +88655,24 @@
 static double js_math_log(double d) { return log(d); }
 static double js_math_sin(double d) { return sin(d); }
 static double js_math_tan(double d) { return tan(d); }
+#if QJS_AOT || QJS_AOT_GEN
+void *qjs_aot_intrinsic_fn(int id)
+{
+    switch (id) {
+    case QJS_AOT_INTR_SQRT: return (void *)js_math_sqrt;
+    case QJS_AOT_INTR_ABS: return (void *)js_math_fabs;
+    case QJS_AOT_INTR_FLOOR: return (void *)js_math_floor;
+    case QJS_AOT_INTR_CEIL: return (void *)js_math_ceil;
+    case QJS_AOT_INTR_ROUND: return (void *)js_math_round;
+    case QJS_AOT_INTR_SIN: return (void *)js_math_sin;
+    case QJS_AOT_INTR_COS: return (void *)js_math_cos;
+    case QJS_AOT_INTR_MIN:
+    case QJS_AOT_INTR_MAX: return (void *)js_math_min_max;
+    case QJS_AOT_INTR_PARSEINT: return (void *)js_parseInt;
+    }
+    return NULL;
+}
+#endif
 static double js_math_trunc(double d) { return trunc(d); }
 static double js_math_cosh(double d) { return cosh(d); }
 static double js_math_sinh(double d) { return sinh(d); }
