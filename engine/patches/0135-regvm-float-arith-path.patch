Subject: Adds a float-only fast path to the register VM's add, sub and mul

What this does
  Adds a float-only fast path to the register VM's add, sub and mul.

Why we need it
  The second-largest gap; moving them into xmm and jumping to the shared int/float store merge.

What it adds
  The three opcodes test both operand tags before either payload is loaded and read the operands directly as doubles, so the hit is `movsd`/`mulsd`/`movsd`; a new `T_SET_NEXT_F64` tail reads the destination's old tag alone and fetches the full old value only when that tag says a reference count lives there; the operation is a compile-time literal so the selection folds away and `regvm_num_fast` still handles ints, mixed operands, bitwise and comparisons unchanged.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -23038,6 +23038,25 @@ static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_free_slow(REGVM_ARGS)
         T_NEXT(off); \
     } while (0)
 
+/* The float store tail. Only the destination's old tag is read first; the
+   old value is fetched, before the overwrite, only when it is counted. The
+   tag is written as the whole int64_t so the upper bits stay defined. */
+#define T_SET_NEXT_F64(d, r, off) do { \
+        int64_t _ot = FR(d).tag; \
+        JSValue _o; \
+        if (unlikely(_ot < 0)) \
+            _o = FR(d); \
+        FR(d).u.float64 = (r); \
+        FR(d).tag = JS_TAG_FLOAT64; \
+        if (unlikely(_ot < 0) && \
+            unlikely(--JS_REF_COUNT(JS_VALUE_GET_PTR(_o)) <= 0)) { \
+            f->set_v = _o; \
+            __attribute__((musttail)) \
+                return regvm_t_free_slow(ip + (off), fr, f, ctx); \
+        } \
+        T_NEXT(off); \
+    } while (0)
+
 /* One list per family, expanded for the declarations, the dispatch table and
    the definitions, so they cannot disagree about which opcodes are
    converted. */
@@ -23155,6 +23174,39 @@ static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_free_slow(REGVM_ARGS)
         __attribute__((musttail)) return SLOW_(REGVM_PASS); \
     } while (0)
 
+/* The float-only arithmetic fast path: both tags are tested, then the
+   operands are read as doubles, with its own tail (T_SET_NEXT_F64). SUB_ is a
+   literal, so only add, sub and mul select it at compile time; everything else
+   goes through regvm_num_fast. */
+#define REGVM_F64_BIN(SUB_) \
+    ((SUB_) == REG_BIN_ADD || (SUB_) == REG_BIN_SUB || (SUB_) == REG_BIN_MUL)
+#define REGVM_F64_OP(SUB_, x, y) \
+    ((SUB_) == REG_BIN_ADD ? (x) + (y) : \
+     (SUB_) == REG_BIN_SUB ? (x) - (y) : (x) * (y))
+
+#define T_FAST_RRR_F64(SUB_, SZ_, SLOW_) do { \
+        int _d = T_REG(1); \
+        int _a = T_REG(3), _b = T_REG(5); \
+        if (likely(JS_VALUE_GET_TAG(FR(_a)) == JS_TAG_FLOAT64 && \
+                   JS_VALUE_GET_TAG(FR(_b)) == JS_TAG_FLOAT64)) { \
+            double _r = REGVM_F64_OP(SUB_, FR(_a).u.float64, FR(_b).u.float64); \
+            T_SET_NEXT_F64(_d, _r, SZ_); \
+        } \
+        JSValue _out; \
+        if (likely(regvm_num_fast(SUB_, FR(_a), FR(_b), &_out))) { \
+            T_SET_NEXT(_d, _out, SZ_); \
+        } \
+        __attribute__((musttail)) return SLOW_(REGVM_PASS); \
+    } while (0)
+
+/* the float-first path only for the ops it can take */
+#define T_FAST_BIN(SUB_, SZ_, SLOW_) do { \
+        if (REGVM_F64_BIN(SUB_)) \
+            T_FAST_RRR_F64(SUB_, SZ_, SLOW_); \
+        else \
+            T_FAST_RRR(SUB_, SZ_, SLOW_); \
+    } while (0)
+
 #define T_DECL(name, sub) \
     static uint8_t *REGVM_CC regvm_t_##name(REGVM_ARGS); \
     static uint8_t *REGVM_CC regvm_t_##name##_slow(REGVM_ARGS);
@@ -24036,7 +24088,7 @@ static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_call_method_slow(REGV
     static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_##name##_slow(REGVM_ARGS) \
     { T_BODY_RRR(sub, T_SZ_RRR); } \
     static uint8_t *REGVM_CC regvm_t_##name(REGVM_ARGS) \
-    { T_FAST_RRR(sub, T_SZ_RRR, regvm_t_##name##_slow); }
+    { T_FAST_BIN(sub, T_SZ_RRR, regvm_t_##name##_slow); }
 REGVM_T_BINARY_LIST(T_DEF_BIN)
 #undef T_DEF_BIN
 
