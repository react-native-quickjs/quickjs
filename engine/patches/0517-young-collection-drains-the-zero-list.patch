     js_gc_passes(rt, young, unlikely(gc_stat_on) ? __builtin_ia32_rdtsc() : 0, sz0);
-    if (young && rt->malloc_state.malloc_size > rt->gc_full_after + (rt->gc_full_after >> 1))
