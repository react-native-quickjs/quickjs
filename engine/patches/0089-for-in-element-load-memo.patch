Subject: Memoize the (shape, key) to index mapping for element loads

What this does
  Remembers the slot an element load resolved to, keyed on the receiver's shape
  and the key.

Why we need it
  Repeated loads on the same layout repeat the walk that found the slot.

What it adds
  The memo holds a counted reference to the shape, so it cannot outlive the layout
  it describes, and it is consulted only for a receiver whose shape still matches.
  A miss, a shape change, a proxy and any receiver the fast element path already
  declines take the existing path. No opcode is added or retired and BC_VERSION is
  unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -459,6 +459,14 @@ struct JSRuntime {
 
     struct JSStackFrame *current_stack_frame;
 
+    /* for-in element-load memo: in forin_shape, forin_atom is at forin_idx. A
+       property of the shape alone, so a reader that sees the same shape may
+       trust the index. The counted reference keeps the shape from being mutated
+       in place and keeps forin_atom alive. */
+    JSShape *forin_shape;
+    JSAtom forin_atom;
+    uint32_t forin_idx;
+
     JSInterruptHandler *interrupt_handler;
     void *interrupt_opaque;
 
@@ -2957,6 +2965,11 @@ void JS_FreeRuntime(JSRuntime *rt)
     bool leak = false;
     int i;
 
+    if (rt->forin_shape) {
+        js_free_shape(rt, rt->forin_shape);
+        rt->forin_shape = NULL;
+        rt->forin_atom = JS_ATOM_NULL;
+    }
     rt->in_free = true;
 #ifdef QJS_ICSTAT
     js_icstat_dump();
@@ -3846,6 +3859,12 @@ void JS_FreeContext(JSContext *ctx)
         return;
     assert(JS_REF_COUNT(ctx) == 0);
 
+    if (rt->forin_shape) {
+        js_free_shape(rt, rt->forin_shape);
+        rt->forin_shape = NULL;
+        rt->forin_atom = JS_ATOM_NULL;
+    }
+
 #ifdef ENABLE_DUMPS // JS_DUMP_ATOMS
     if (check_dump_flag(rt, JS_DUMP_ATOMS))
         JS_DumpAtoms(ctx->rt);
@@ -11579,6 +11598,32 @@ static bool js_get_fast_array_element(JSContext *ctx, JSObject *p,
     }
