+}
+
+JSValue qjs_aot_ret(JSRegRun *f)
+{
+    return f->ret;
+}
+
+/* The generated unit's exception unwinder: the monolith's `exception:` walk
+   for an entry frame (an AOT function is always called through
+   js_regvm_execute). Closes every for-of it passes and resumes at the
+   innermost catch. Returns JS_UNDEFINED with *resume_pc set when caught,
+   otherwise JS_EXCEPTION. */
+JSValue qjs_aot_unwind(JSContext *ctx, JSRegRun *f, JSValue *fr,
+                       uint32_t pc, uint32_t *resume_pc)
+{
+    JSRuntime *rt = ctx->rt;
+
+    (void)pc;
+    if (needs_backtrace(rt->current_exception)) {
+        f->sf->cur_pc = NULL;
+        build_backtrace(ctx, rt->current_exception, JS_UNDEFINED,
+                        NULL, 0, 0, 0);
+    }
+    while (f->nctl > 0) {
+        JSRegCtl *e = &f->ctl[f->nctl - 1];
+
+        if (e->kind == REG_CTL_ITER) {
+            --f->nctl;
+            JS_FreeValue(ctx, e->next);
+            JS_IteratorClose(ctx, e->iter, true);
+            JS_FreeValue(ctx, e->iter);
+        } else if (e->kind == REG_CTL_CATCH) {
+            JSValue exc = rt->current_exception;
+
+            --f->nctl;
+            rt->current_exception = JS_UNINITIALIZED;
+            JS_FreeValueRT(rt, ctx->error_back_trace);
+            ctx->error_back_trace = JS_UNDEFINED;
+#if QJS_DRC
+            fr[e->reg] = exc;
+            REG_ADOPT(rt, exc);
+#else
+            JS_FreeValue(ctx, fr[e->reg]);
+            fr[e->reg] = exc;
+#endif
+            *resume_pc = e->pc;
+            return JS_UNDEFINED;
+        } else {
+            /* a finally continuation is dropped, as the sentinel scan drops
+               the return address it carries */
+            --f->nctl;
+        }
+    }
+    return JS_EXCEPTION;
+}
+#endif /* QJS_AOT */
