+    h = (h ^ (uint32_t)b->regvm_reg_count) * 16777619u;
+    h = (h ^ (uint32_t)b->regvm_ctl_count) * 16777619u;
+    h = (h ^ (uint32_t)b->regvm_pic_count) * 16777619u;
+    return h;
