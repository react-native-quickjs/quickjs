+static int aot_gen_eligible(JSFunctionBytecode *b)
+{
+    return b->regvm_compiled && b->regvm_len > 0 &&
+           b->func_kind == JS_FUNC_NORMAL && !b->is_lazy;
+}
+
+int js_aot_gen_collect(JSRuntime *rt, JSAotGenFunc **pout)
+{
+    JSAotGenFunc *arr = NULL;
+    int n = 0, cap = 0, li;
+    struct list_head *el;
+
+    *pout = NULL;
+    for (li = 0; li < 2; li++) {
+        struct list_head *head = li == 0 ? &rt->gc_obj_list : &rt->gc_notrace_list;
+
+        list_for_each(el, head) {
+            JSGCObjectHeader *gp = list_entry(el, JSGCObjectHeader, link);
+            JSFunctionBytecode *b;
+            JSAotGenFunc *g;
+
+            if (JS_GC_TYPE(gp) != JS_GC_OBJ_TYPE_FUNCTION_BYTECODE)
+                continue;
+            b = (JSFunctionBytecode *)gp;
+            if (!aot_gen_eligible(b))
+                continue;
+            if (n == cap) {
+                JSAotGenFunc *na;
+                cap = cap ? cap * 2 : 64;
+                na = js_realloc_rt(rt, arr, sizeof(*arr) * (size_t)cap);
+                if (!na) {
+                    js_free_rt(rt, arr);
+                    return 0;
+                }
+                arr = na;
+            }
+            g = &arr[n];
+            memset(g, 0, sizeof(*g));
+            js_aot_digest(b, g->digest);
+            g->code_crc = js_aot_code_crc(b);
+            g->len = b->regvm_len;
+            g->reg_count = b->regvm_reg_count;
+            g->ctl_count = b->regvm_ctl_count;
+            g->pic_count = b->regvm_pic_count;
+            g->arg_count = b->arg_count;
+            g->var_count = b->var_count;
+            g->defined_arg_count = b->defined_arg_count;
+            g->func_kind = b->func_kind;
+            g->code = b->regvm_code;
+            JS_AtomGetStrRT(rt, g->name, sizeof(g->name), b->func_name);
+            if (b->filename != JS_ATOM_NULL)
+                JS_AtomGetStrRT(rt, g->file, sizeof(g->file), b->filename);
+            n++;
+        }
+    }
+    *pout = arr;
+    return n;
+}
+
+void js_aot_gen_free(JSRuntime *rt, JSAotGenFunc *arr)
+{
+    js_free_rt(rt, arr);
+}
+
+int js_aot_gen_insn_size(const uint8_t *code, int len, int off, int *p_op)
+{
+    int op, sz;
+    const char *fmt;
+
+    if (off < 0 || off >= len)
+        return -1;
+    op = code[off];
+    if (op <= 0 || op >= ROP_COUNT)
+        return -1;
+    fmt = regvm_rop_fmt[op];
+    if (!fmt)
+        return -1;
+    sz = regvm_fmt_size(fmt, 1 /* register operands are two bytes */,
+                        (uint16_t)op);
+    if (sz < 0 || off + 1 + sz > len)
+        return -1;
+    if (p_op)
+        *p_op = op;
+    return 1 + sz;
+}
+#endif /* QJS_AOT_GEN */
 
 
