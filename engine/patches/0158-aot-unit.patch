+static uint32_t js_aot_code_crc(JSFunctionBytecode *b)
+{
+    uint8_t d[16];
+    uint32_t h = 2166136261u;
+    int i;
+
+    /* The digest is atom- and encoding-independent, so it is stable across
+       processes; mix in the frame counts, which it does not cover. */
+    js_aot_digest(b, d);
+    for (i = 0; i < 16; i++)
