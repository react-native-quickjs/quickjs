+
+/* Bind a function to its generated entry. The table is sorted by digest;
+   `code_crc` catches a stale unit (QJS_AOT_VERIFY). Called once, when the
+   bytecode is final. */
+static void js_aot_bind(JSFunctionBytecode *b)
+{
+    uint8_t digest[16];
+    uint32_t lo, hi;
+
+    b->aot_fn = NULL;
+    b->aot_state = 2;           /* known-absent until a match is found */
+    if (!aot_unit_present())
+        return;
+    if (!b->regvm_compiled || b->regvm_len <= 0 ||
+        b->func_kind != JS_FUNC_NORMAL)
+        return;
+    js_aot_digest(b, digest);
+    lo = 0;
+    hi = qjs_aot_count;
+    while (lo < hi) {
+        uint32_t mid = lo + (hi - lo) / 2;
+        int c = memcmp(digest, qjs_aot_table[mid].digest, 16);
+
+        if (c == 0) {
+#if QJS_AOT_VERIFY
+            if (qjs_aot_table[mid].code_crc != js_aot_code_crc(b)) {
+                b->aot_state = 2;
+                return;
+            }
+#endif
+            b->aot_fn = (void *)qjs_aot_table[mid].fn;
+            b->aot_state = 1;   /* bound */
+            js_aot_bound_count++;
+            return;
+        }
+        if (c < 0)
+            hi = mid;
+        else
+            lo = mid + 1;
+    }
+}
