+/* ABI entry points for the generated unit. */
+uint8_t *qjs_aot_step(uint8_t *ip, JSValue *fr, JSRegRun *f, JSContext *ctx)
+{
+    return regvm_step(ip, fr, f, ctx);
+}
+
+uint8_t *qjs_aot_code(JSRegRun *f)
+{
