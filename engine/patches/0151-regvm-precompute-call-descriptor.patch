+    /* C2: precomputed call descriptor, set by regvm_set_call_desc() whenever the
+       inputs change (compile, deserialize, lazy materialization). `regvm_call_ready`
+       is exactly the conjunction `regvm_record_eligible` used to test, so the hot
+       call handler does one byte load instead of four field tests. `regvm_frame_need`
+       is the borrow-case arena size (arg_slots == 0), the common case, so
+       `regvm_record_alloc` is one load and one add instead of three multiplies. */
+    uint8_t regvm_call_ready;
+    uint32_t regvm_frame_need;
 #endif
 } JSFunctionBytecode;
 
