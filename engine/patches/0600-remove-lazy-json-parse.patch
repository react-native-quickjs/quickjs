-static JSShape *json_lazy_layout_shape(const JSONLazyLayout *layout)
-{
-    if (!layout || !layout->valid ||
-        JS_VALUE_GET_TAG(layout->template) != JS_TAG_OBJECT)
-        return NULL;
-    return JS_VALUE_GET_OBJ(layout->template)->shape;
