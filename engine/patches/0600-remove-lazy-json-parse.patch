-static JSValue js_lazy_eager_parse_range(JSContext *ctx, const char *base,
-                                        uint32_t start, uint32_t len)
-{
-    char *tmp = js_malloc(ctx, (size_t)len + 1);
-    JSValue v;
-    if (!tmp)
-        return JS_EXCEPTION;
-    memcpy(tmp, base + start, len);
-    tmp[len] = '\0';
-    v = JS_ParseJSON(ctx, tmp, len, "<lazy>");
-    js_free(ctx, tmp);
-    return v;
-}
