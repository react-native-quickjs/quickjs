-        while (initialized_atoms > 0)
-            JS_FreeAtom(ctx, entries[--initialized_atoms].atom);
-        js_free(ctx, entries);
-    }
-    return obj;
-fail:
-    if (entries) {
-        while (initialized_atoms > 0)
-            JS_FreeAtom(ctx, entries[--initialized_atoms].atom);
-        js_free(ctx, entries);
-    }
-    JS_FreeValue(ctx, obj);
-    return JS_HasException(ctx) ? JS_EXCEPTION : JS_UNDEFINED;
