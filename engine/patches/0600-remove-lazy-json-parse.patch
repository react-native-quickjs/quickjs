-                        child_index > INT32_MAX) {
-                        while (i > 0)
-                            JS_FreeValue(ctx, values[--i]);
-                        js_free(ctx, values);
-                        return JS_EXCEPTION;
-                    }
-                    child = &doc->nodes[child_index];
-                    values[i] = js_lazy_marker_new(child_index);
-                    child_index = child->next_sibling;
-                }
