-            uint32_t child_index = node->first_child;
-            for (i = 0; i < node->child_count; i++) {
-                JSONLazyTapeNode *child;
-                const uint8_t *kstart;
-                const uint8_t *kend;
-                JSAtom key;
-                JSValue marker;
-                if (child_index == UINT32_MAX ||
-                    child_index >= doc->node_count)
