+                              JSRegPIC **ppic, JSValue recv, JSAtom atom,
+                              JSValue val, int site)
+{
+    int ret = JS_SetPropertyInternal2(ctx, recv, atom, js_dup(val), recv,
+                                      JS_PROP_THROW_STRICT);
+    if (likely(ret >= 0))
+        regvm_put_pic_fill(ctx, b, ppic, recv, atom, site);
+    return ret;
