+/* Install one shape/slot into a site, counting a miss when the cached shape
+   changes and going dead at the limit. Shared by the read and the write fill. */
+static void regvm_pic_install(JSRuntime *rt, JSRegPIC *e, uint16_t kind,
+                              JSShape *rsh, JSShape *hsh, uint32_t slot)
+{
+    uint16_t misses;
+
+    if (e->kind == kind && e->shape == rsh && e->holder_shape == hsh)
+        return;                     /* already cached */
+
+    misses = e->misses;
+    if (e->kind != REG_PIC_EMPTY) {
+        if (++misses >= REG_PIC_MISS_LIMIT) {
+            regvm_pic_entry_reset(rt, e);       /* drops the shape references */
+            e->misses = REG_PIC_MISS_LIMIT;     /* EMPTY + limit means dead */
+            return;
+        }
+    }
+    regvm_pic_entry_reset(rt, e);   /* release the entry this replaces */
+    e->misses = misses;
+    e->shape = js_dup_shape(rsh);
+    e->holder_shape = hsh ? js_dup_shape(hsh) : NULL;
+    e->slot = slot;
+    e->kind = kind;
+}
