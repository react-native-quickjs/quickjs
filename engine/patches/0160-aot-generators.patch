+                js_aot_digest(b, g->digest);
+                g->code_crc = js_aot_code_crc(b);
+                g->len = b->regvm_len;
+                g->reg_count = b->regvm_reg_count;
+                g->ctl_count = b->regvm_ctl_count;
+                g->pic_count = b->regvm_pic_count;
+                g->code = b->regvm_code;
+            }
             n++;
         }
     }
diff --git a/quickjs-aot-gen.h b/quickjs-aot-gen.h
index 7ed0e52..861e541 100644
--- a/quickjs-aot-gen.h
+++ b/quickjs-aot-gen.h
@@ -12,7 +12,26 @@
 #include <stdint.h>
 #include "quickjs.h"
 
-/* One AOT-eligible function, flattened out of the engine's bytecode. */
+/*
+ * Why a function did not make it into the unit. AOT_GEN_ELIGIBLE is the only
+ * value for which `code`/`len` are meaningful; every other value carries the
+ * reason and a stack-bytecode length so the census can weigh it.
+ */
+enum {
+    AOT_GEN_ELIGIBLE = 0,
+    AOT_GEN_REF_LAZY,    /* body still in the source blob */
+    AOT_GEN_REF_REGVM,   /* register backend refused it (with/eval/complex) */
+    AOT_GEN_REF_EMPTY,   /* compiled, but an empty program */
+    AOT_GEN_REF_TOO_BIG, /* register program over AOT_GEN_MAX_LEN bytes */
+    AOT_GEN_REF_REASON_COUNT
+};
+
+/* Refuse absurdly large bodies: one emitted step body per instruction, so a
+   multi-hundred-KB register program would balloon the unit. Nothing in the
+   box2d/test262 corpus approaches this. */
+#define AOT_GEN_MAX_LEN (1 << 18)
+
+/* One function flattened out of the engine's bytecode (eligible or refused). */
 typedef struct JSAotGenFunc {
     uint8_t digest[16];        /* the binding key */
     uint32_t code_crc;         /* IRVERIFY hash of the register program */
@@ -24,15 +43,18 @@ typedef struct JSAotGenFunc {
     int var_count;
     int defined_arg_count;
     int func_kind;
+    int eligible;              /* AOT_GEN_ELIGIBLE or an AOT_GEN_REF_* reason */
+    int stack_len;             /* stack bytecode length when refused, else 0 */
     const uint8_t *code;       /* the register program; owned by the runtime */
     char name[128];
     char file[256];
 } JSAotGenFunc;
 
 /*
- * Collect every AOT-eligible function in `rt`. Returns the count and stores a
- * malloc'd array in *pout (release with js_aot_gen_free). Zero with *pout NULL
- * on allocation failure.
+ * Collect every function bytecode in `rt`, eligible or not, so the caller can
+ * both emit the eligible ones and report a refusal census. Returns the count
+ * and stores a malloc'd array in *pout (release with js_aot_gen_free). Zero
+ * with *pout NULL on allocation failure.
  */
 int js_aot_gen_collect(JSRuntime *rt, JSAotGenFunc **pout);
 void js_aot_gen_free(JSRuntime *rt, JSAotGenFunc *arr);
