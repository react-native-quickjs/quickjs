     for (i = 0; i < n; i++) {
@@ -60998,7 +60996,8 @@ static void regvm_hoist_loop_const(JSContext *ctx, JSRegIR *ir, int *pc_to_insn,
         pr = ireg[v];
         if (pr < 0 || pr >= n_values)
