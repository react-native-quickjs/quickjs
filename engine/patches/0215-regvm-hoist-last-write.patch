     }
     for (i = 0; i < n; i++)
         insn_pc[i] = -1;
@@ -63100,7 +63114,7 @@
             continue;
         pr = ireg[v];
         if (pr < 0 || pr >= n_values || defs[pr] != ti)
-            continue;                       /* one definition: this load */
+            continue;                       /* the load is the register's last write */
         nxt = ti + 1;
