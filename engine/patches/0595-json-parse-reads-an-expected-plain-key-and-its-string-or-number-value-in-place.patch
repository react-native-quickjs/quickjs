+                                    if (*p != ',')
+                                        goto obj_fail;
+                                    p = json_fast_ws(p + 1);
+                                    continue;
+                                }
+                            }
+                        }
+                    }
                     if (jsc && matched && jsc->atoms && k < jsc->n && jsc->plain[k])
                         s->json_key_hint = jsc->atoms[k];
