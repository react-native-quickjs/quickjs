From: quickjs-ng bundle work
Subject: Register VM: debug assertion for the argv invariant (0187)

What this does
  Adds a debug-only check of the invariant P6 relies on, directly where it
  matters. In JS_CallInternal, when a C caller's argv is used in place -- the
  caller passed JS_CALL_FLAG_COPY_ARGV and nothing was copied
  (arg_allocated_size == 0) -- the first min(argc, b->arg_count) arguments
  (capped at 16; the check is skipped above that) are snapshotted on entry and
  memcmp'd on the way out, on both the register-ASM and register-interpreter
  return paths. Under #ifndef NDEBUG plus QJS_REGVM.

Why we need it
  The 0186 cross-check (stack argv_safe => register argv_safe, plus
  args_captured equality) can only catch the register scan being stricter than
  the stack scan, which costs speed. It cannot catch the register scan being
  wrong -- missing an opcode that writes an argument slot -- and that is the
  case that clobbers a C caller's array and corrupts reference counts.
  argv-clobber.c covers only the ten shapes in it. This asserts the invariant
  itself, on every call test262 and the differential suite make.

What it adds
  quickjs.c
      the argv_snapshot[16] / argv_snapshot_n locals, the entry snapshot, and
      the memcmp assertions before the two register return paths in
      JS_CallInternal.

  Run once with a debug build: test262 50/81192, differential suite 400/0/0,
  zero assertions. A failure means an opcode is missing from
  regvm_scan_arg_flags -- add the opcode, do not weaken the assert.

  Gates (release): box2d 546.1008391043414 (source/eager/lazy); test262
  50/81192 no leaks; 13 Octane rows clean; argv-clobber source/eager/lazy all
  ok.

diff --git a/quickjs.c b/quickjs.c
index 7b8ee72..a2cb97f 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -35963,6 +35963,15 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
     JSVarRef **var_refs;
     size_t alloca_size;
 
+#if QJS_REGVM && !defined(NDEBUG)
+    /* P6 invariant: when a C caller's argv is used in place, the callee must
+       not write any argument slot. Snapshot the arguments on entry and check
+       them again before returning. See the plan's "argv_safe cross-check
+       direction" decision. */
+    JSValue argv_snapshot[16];
+    int argv_snapshot_n = 0;
+#endif
+
 #if QJS_REGVM
     /* Set on the generator-rejection resume path and handed to the register
        interpreter, which unwinds from there. */
@@ -36083,6 +36092,19 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
         arg_allocated_size = 0;
     }
 
+#if QJS_REGVM && !defined(NDEBUG)
+    /* P6: nothing was copied and the callee is not argument-captured, so a C
+       caller's argv is used in place. Snapshot it; the return path asserts the
+       callee wrote nothing into it. */
+    if ((flags & JS_CALL_FLAG_COPY_ARGV) && arg_allocated_size == 0) {
+        int n = min_int(argc, b->arg_count);
+        if (n > 0 && n <= (int)(sizeof(argv_snapshot) / sizeof(argv_snapshot[0]))) {
+            memcpy(argv_snapshot, argv, sizeof(JSValue) * n);
+            argv_snapshot_n = n;
+        }
+    }
+#endif
+
 #if QJS_REGVM
     /* The register frame's temporary area is the allocator's register count,
        not the stack VM's maximum depth. */
@@ -36195,12 +36217,29 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
         ast.resume_marker = NULL;
         ast.resume_pending = 0;
         ast.resume_rpc = NULL;
-        return regvm_asm_enter(&ast);
+        {
+            JSValue _r = regvm_asm_enter(&ast);
+#if !defined(NDEBUG)
+            if (argv_snapshot_n > 0)
+                assert(memcmp(argv, argv_snapshot,
+                              sizeof(JSValue) * argv_snapshot_n) == 0);
+#endif
+            return _r;
+        }
     }
 #else
-    return js_regvm_execute(caller_ctx, func_obj, this_obj, new_target, argc,
-                            argv, sf, b, local_buf, arg_buf, var_buf,
-                            stack_buf, sp, pc, flags, regvm_throw_pending);
+    {
+        JSValue _r = js_regvm_execute(caller_ctx, func_obj, this_obj,
+                                      new_target, argc, argv, sf, b, local_buf,
+                                      arg_buf, var_buf, stack_buf, sp, pc,
+                                      flags, regvm_throw_pending);
+#if !defined(NDEBUG)
+        if (argv_snapshot_n > 0)
+            assert(memcmp(argv, argv_snapshot,
+                          sizeof(JSValue) * argv_snapshot_n) == 0);
+#endif
+        return _r;
+    }
 #endif
 
 #else
