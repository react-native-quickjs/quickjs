+/* The engine's layout hash, from the same function the generator used, so the
+   two agree field for field. */
+static uint32_t js_aot_unit_layout_hash(void)
+{
+    JSAotGenLayout l;
+
+    js_aot_gen_layout(&l);
+    return l.hash;
+}
