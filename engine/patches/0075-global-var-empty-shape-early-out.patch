Subject: Skip the global_var_obj probe when its shape is empty

What this does
  Short-circuits the global variable lookup in OP_get_var when the global
  variable object holds no properties.

Why we need it
  The lookup walks the variable object on every global read, including when that
  object is empty, which is the state of a program that declares no global
  variables.

What it adds
  An empty shape check is taken before the probe. A shape that is not empty takes
  the existing path unchanged, and a missing name still produces the same
  reference error. No opcode is added or retired and BC_VERSION is unchanged.

Needs a bytecode version bump
  No.

--- a/quickjs.c
+++ b/quickjs.c
@@ -13461,12 +13461,16 @@
 
     /* no exotic behavior is possible in global_var_obj */
     p = JS_VALUE_GET_OBJ(ctx->global_var_obj);
-    prs = find_own_property(&pr, p, prop);
-    if (prs) {
-        /* XXX: should handle JS_PROP_TMASK properties */
-        if (unlikely(JS_IsUninitialized(pr->u.value)))
-            return JS_ThrowReferenceErrorUninitialized(ctx, prs->atom);
-        return js_dup(pr->u.value);
+    /* prop_count counts deleted properties as well, so a shape with prop_count == 0
+       has no entries at all and the probe cannot succeed. */
+    if (p->shape->prop_count != 0) {
+        prs = find_own_property(&pr, p, prop);
+        if (prs) {
+            /* XXX: should handle JS_PROP_TMASK properties */
+            if (unlikely(JS_IsUninitialized(pr->u.value)))
+                return JS_ThrowReferenceErrorUninitialized(ctx, prs->atom);
+            return js_dup(pr->u.value);
+        }
     }
 
     /* fast path */
@@ -13530,22 +13534,26 @@
 
     /* no exotic behavior is possible in global_var_obj */
     p = JS_VALUE_GET_OBJ(ctx->global_var_obj);
-    prs = find_own_property(&pr, p, prop);
-    if (prs) {
-        /* XXX: should handle JS_PROP_AUTOINIT properties? */
-        if (flag != 1) {
-            if (unlikely(JS_IsUninitialized(pr->u.value))) {
-                JS_FreeValue(ctx, val);
-                JS_ThrowReferenceErrorUninitialized(ctx, prs->atom);
-                return -1;
-            }
-            if (unlikely(!(prs->flags & JS_PROP_WRITABLE))) {
-                JS_FreeValue(ctx, val);
-                return JS_ThrowTypeErrorReadOnly(ctx, JS_PROP_THROW, prop);
+    /* prop_count counts deleted properties as well, so a shape with prop_count == 0
+       has no entries at all and the probe cannot succeed. */
+    if (p->shape->prop_count != 0) {
+        prs = find_own_property(&pr, p, prop);
+        if (prs) {
+            /* XXX: should handle JS_PROP_AUTOINIT properties? */
+            if (flag != 1) {
+                if (unlikely(JS_IsUninitialized(pr->u.value))) {
+                    JS_FreeValue(ctx, val);
+                    JS_ThrowReferenceErrorUninitialized(ctx, prs->atom);
+                    return -1;
+                }
+                if (unlikely(!(prs->flags & JS_PROP_WRITABLE))) {
+                    JS_FreeValue(ctx, val);
+                    return JS_ThrowTypeErrorReadOnly(ctx, JS_PROP_THROW, prop);
+                }
             }
+            set_value(ctx, &pr->u.value, val);
+            return 0;
         }
-        set_value(ctx, &pr->u.value, val);
-        return 0;
     }
 
     p = JS_VALUE_GET_OBJ(ctx->global_obj);
