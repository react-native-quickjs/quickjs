+    case JS_CLASS_INT8_ARRAY:  *out = js_int32(p->u.array.u.int8_ptr[idx]); return 1;
+    case JS_CLASS_INT16_ARRAY: *out = js_int32(p->u.array.u.int16_ptr[idx]); return 1;
+    case JS_CLASS_UINT16_ARRAY: *out = js_int32(p->u.array.u.uint16_ptr[idx]); return 1;
+    case JS_CLASS_INT32_ARRAY: *out = js_int32(p->u.array.u.int32_ptr[idx]); return 1;
+    case JS_CLASS_UINT32_ARRAY: *out = js_uint32(p->u.array.u.uint32_ptr[idx]); return 1;
+    case JS_CLASS_FLOAT32_ARRAY: *out = js_float64(p->u.array.u.float_ptr[idx]); return 1;
