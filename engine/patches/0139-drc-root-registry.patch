     struct JSGCObjectHeader *cur_gc_obj;
+    /* Register-VM register window owned by this frame, or NULL when the
+       frame does not run register code (stack interpreter, native call,
+       C frame). `rv_regs[0..rv_nregs)` are the frame's live registers and
+       are treated as roots by the deferred-RC collector. */
+    JSValue *rv_regs;
+    uint32_t rv_nregs;
 } JSStackFrame;
 
+#if QJS_REGVM && (QJS_DRC || QJS_DRC_VALIDATE)
+/*
+ * D1 root registry (HP-S3-DEFERRED-RC-PLAN-2026-10-02.md section 3, stage D1).
+ *
+ * A register-VM frame publishes its live register window on its JSStackFrame.
+ * `regvm_for_each_root_range` is the one place that finds register roots; the
+ * deferred-RC collector and the validator both go through it. Only frames that
+ * actually run register code have `rv_regs != NULL`; stack-interpreter frames,
+ * native frames and C frames leave it NULL.
+ */
+typedef void (*JSRegRootFn)(void *opaque, JSValue *regs, uint32_t nregs);
+
+static void regvm_for_each_root_range(JSRuntime *rt, JSRegRootFn fn,
+                                      void *opaque)
+{
+    JSStackFrame *sf;
+    for (sf = rt->current_stack_frame; sf != NULL; sf = sf->prev_frame) {
+        if (sf->rv_regs && sf->rv_nregs)
+            fn(opaque, sf->rv_regs, sf->rv_nregs);
+    }
+}
+#endif /* QJS_REGVM */
+
+/* Publish a frame's live register window as a GC root range. Inert (a no-op) in
+   builds that do not use the deferred-RC collector, so the root registry costs
+   nothing there. */
+#if QJS_DRC || QJS_DRC_VALIDATE
+#define REGVM_SET_ROOT(sf_, r_, n_) do { (sf_)->rv_regs = (r_); (sf_)->rv_nregs = (n_); } while (0)
+#else
+#define REGVM_SET_ROOT(sf_, r_, n_) ((void)0)
+#endif
+
 typedef enum {
     JS_GC_OBJ_TYPE_JS_OBJECT,
     JS_GC_OBJ_TYPE_FUNCTION_BYTECODE,
@@ -695,6 +745,35 @@
 #define JS_GC_MARK(p)   (js_rc(p)->mark)
 #define JS_GC_NOTRACE(p) (js_rc(p)->gc_notrace)
 
+#if QJS_REGVM && QJS_DRC_VALIDATE
+static void js_drc_validate_range(void *opaque, JSValue *regs, uint32_t nregs)
+{
+    JSRuntime *rt = opaque;
+    uint32_t i;
+    for (i = 0; i < nregs; i++) {
+        JSValue v = regs[i];
+        if (!JS_VALUE_HAS_REF_COUNT(v))
+            continue;
+        if (JS_REF_COUNT(JS_VALUE_GET_PTR(v)) < 1) {
+            fprintf(stderr,
+                    "drc-validate: register %p[%u] holds a counted value at "
+                    "ref_count %u\n",
+                    (void *)regs, i,
+                    JS_REF_COUNT(JS_VALUE_GET_PTR(v)));
+            abort();
+        }
+    }
+    (void)rt;
+}
+
+/* Every counted value reachable from a live register must be owned (count >= 1)
+   while registers still own. Called at GC time, never mid-release. */
+static void js_drc_validate_roots(JSRuntime *rt)
+{
+    regvm_for_each_root_range(rt, js_drc_validate_range, rt);
+}
+#endif
