Subject: Publishes each register frame's register window as a GC root range

What this does
  Publishes each register frame's register window as a GC root range.

Why we need it
  And the later register-ownership flip must not invent a second answer.

What it adds
  `JSStackFrame.rv_regs`/`rv_nregs`, set by `regvm_record_fill`, the in-loop call macro, the fresh `JS_CallInternal` bytecode path and `async_func_init` (excluding the integer handshake slot), cleared to NULL/0 by the three C-frame helpers, walked by `regvm_for_each_root_range`; `QJS_DRC_VALIDATE` adds a `JS_RunGC` validator asserting every counted register value is still owned.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -63,6 +63,15 @@ typedef struct JSRegIR JSRegIR;
 typedef struct JSRegRCC JSRegRCC;
 #endif
 
+/* Deferred reference counting. QJS_DRC enables the machinery (ZCT, reconcile,
+   register-root scanning); QJS_DRC_VALIDATE adds the debug root validator. */
+#ifndef QJS_DRC
+#define QJS_DRC 0
+#endif
+#ifndef QJS_DRC_VALIDATE
+#define QJS_DRC_VALIDATE 0
+#endif
+
 #if defined(EMSCRIPTEN) || defined(_MSC_VER)
 #define DIRECT_DISPATCH  0
 #else
@@ -610,8 +619,41 @@ typedef struct JSStackFrame {
        the coroutine's locals keep the (suspended) coroutine reachable by
        the cycle collector. */
     struct JSGCObjectHeader *cur_gc_obj;
+    /* The register window this frame owns, or NULL when it does not run
+       register code. `rv_regs[0..rv_nregs)` are roots for the deferred-RC
+       collector. */
+    JSValue *rv_regs;
+    uint32_t rv_nregs;
 } JSStackFrame;
 
+#if QJS_REGVM && (QJS_DRC || QJS_DRC_VALIDATE)
+/*
+ * Register root registry. A register-VM frame publishes its live register
+ * window on its JSStackFrame (`rv_regs`, NULL for every other frame), and
+ * `regvm_for_each_root_range` is the one place that finds register roots, for
+ * the collector and the validator alike.
+ */
+typedef void (*JSRegRootFn)(void *opaque, JSValue *regs, uint32_t nregs);
+
+static void regvm_for_each_root_range(JSRuntime *rt, JSRegRootFn fn,
+                                      void *opaque)
+{
+    JSStackFrame *sf;
+    for (sf = rt->current_stack_frame; sf != NULL; sf = sf->prev_frame) {
+        if (sf->rv_regs && sf->rv_nregs)
+            fn(opaque, sf->rv_regs, sf->rv_nregs);
+    }
+}
+#endif /* QJS_REGVM */
+
+/* Publish a frame's live register window as a GC root range. A no-op without
+   the deferred-RC collector. */
+#if QJS_DRC || QJS_DRC_VALIDATE
+#define REGVM_SET_ROOT(sf_, r_, n_) do { (sf_)->rv_regs = (r_); (sf_)->rv_nregs = (n_); } while (0)
+#else
+#define REGVM_SET_ROOT(sf_, r_, n_) ((void)0)
+#endif
+
 typedef enum {
     JS_GC_OBJ_TYPE_JS_OBJECT,
     JS_GC_OBJ_TYPE_FUNCTION_BYTECODE,
@@ -674,6 +716,35 @@ static inline JSMallocBlockHeader *js_rc(const void *p) {
 #define JS_GC_MARK(p)   (js_rc(p)->mark)
 #define JS_GC_NOTRACE(p) (js_rc(p)->gc_notrace)
 
+#if QJS_REGVM && QJS_DRC_VALIDATE
+static void js_drc_validate_range(void *opaque, JSValue *regs, uint32_t nregs)
+{
+    JSRuntime *rt = opaque;
+    uint32_t i;
+    for (i = 0; i < nregs; i++) {
+        JSValue v = regs[i];
+        if (!JS_VALUE_HAS_REF_COUNT(v))
+            continue;
+        if (JS_REF_COUNT(JS_VALUE_GET_PTR(v)) < 1) {
+            fprintf(stderr,
+                    "drc-validate: register %p[%u] holds a counted value at "
+                    "ref_count %u\n",
+                    (void *)regs, i,
+                    JS_REF_COUNT(JS_VALUE_GET_PTR(v)));
+            abort();
+        }
+    }
+    (void)rt;
+}
+
+/* Every counted value reachable from a live register must be owned (count >= 1)
+   while registers still own. Called at GC time, never mid-release. */
+static void js_drc_validate_roots(JSRuntime *rt)
+{
+    regvm_for_each_root_range(rt, js_drc_validate_range, rt);
+}
+#endif
+
