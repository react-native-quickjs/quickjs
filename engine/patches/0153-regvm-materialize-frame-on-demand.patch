+/* A nested record's JSStackFrame lives in the arena at `rec->sf_embed`, and
+   several of its fields duplicate the record's. The record fill does not store
+   them; `regvm_sf_materialize` reconstructs them on the cold paths that read
+   them (closure creation, debugger, errors, backtraces). */
+#if QJS_REGVM_RECORD && !QJS_REGVM_INLOOP_CALL
+#define REGVM_SLIM_FRAME 1
+struct JSRegRun;
+static void regvm_sf_materialize(JSRuntime *rt, JSStackFrame *sf);
+#else
+#define REGVM_SLIM_FRAME 0
+static inline void regvm_sf_materialize(JSRuntime *rt, JSStackFrame *sf)
+{
+    (void)rt;
+    (void)sf;
+}
+#endif
