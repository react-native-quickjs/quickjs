+#if REGVM_SLIM_FRAME
+/* Recover the record whose embedded JSStackFrame is `sf`, or NULL when `sf` is
+   not a record frame (the activation's own frame, a stack-interpreter frame, a
+   native frame, or a coroutine's heap frame). The frame arena holds only
+   records in this build (QJS_REGVM_INLOOP_CALL is off), so membership decides.
+   The arena never relocates while a frame is live, so the address test is
+   stable for the lifetime of `sf`. */
+static JSRegRun *regvm_rec_of_sf(JSRuntime *rt, JSStackFrame *sf)
+{
+    const uint8_t *p = (const uint8_t *)sf;
+
+    if (p < rt->regvm_frames || p >= rt->regvm_frames + rt->regvm_frames_top)
+        return NULL;
+    return (JSRegRun *)(p - offsetof(JSRegRun, sf_embed));
+}
+
+/* Reconstruct the JSStackFrame fields the record fill no longer stores. Called
+   from the cold readers; idempotent, and a no-op for a non-record frame. */
+static void regvm_sf_materialize(JSRuntime *rt, JSStackFrame *sf)
+{
+    JSRegRun *rec = regvm_rec_of_sf(rt, sf);
+    JSFunctionBytecode *b;
+
+    if (!rec)
+        return;
+    b = rec->b;
+    sf->is_strict_mode = b->is_strict_mode;
+    sf->is_constructor = false;
+    sf->var_buf = rec->var_buf;
+    sf->arg_buf = rec->arg_buf;
+    sf->arg_count = rec->arg_owned
+        ? (rec->argc > b->arg_count ? rec->argc : b->arg_count)
+        : rec->argc;
+    sf->cur_gc_obj = NULL;
+}
+#endif /* REGVM_SLIM_FRAME */
