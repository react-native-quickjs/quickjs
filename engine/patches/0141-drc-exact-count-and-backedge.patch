     __attribute__((musttail)) return regvm_t_dispatch(ip, fr, f, ctx);
 }
 
+/*
+ * The back-edge reconcile, reached only from a branch whose target is behind it
+ * and only when the deferred-RC zero-count table has outgrown its limit. It is a
+ * tail call so the branch handlers stay frameless; see REGVM_DRC_BACKEDGE. The
+ * register file does not move across a reconcile, so re-entering the chain at
+ * `ip` (the branch target) is safe.
+ */
+#if QJS_DRC
+static __attribute__((noinline)) uint8_t *REGVM_CC regvm_t_safepoint_slow(REGVM_ARGS)
+{
+    js_drc_reconcile(ctx->rt);
+    __attribute__((musttail)) return regvm_t_dispatch(ip, fr, f, ctx);
+}
+#endif
+
 
 /* Continue at ip + off: tail-call a threaded opcode, or return an unthreaded
    one to the dispatch loop. */
-#define T_NEXT(off) __attribute__((musttail)) \
-    return regvm_t_dispatch(ip + (off), fr, f, ctx)
+#define T_NEXT(off) do { \
+        int32_t _t_off = (off); \
+        REGVM_DRC_BACKEDGE(ctx->rt, _t_off); \
+        __attribute__((musttail)) \
+            return regvm_t_dispatch(ip + _t_off, fr, f, ctx); \
+    } while (0)
 
