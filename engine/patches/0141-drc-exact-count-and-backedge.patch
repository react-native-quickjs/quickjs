+   referenced only from a register has count zero and sits in the ZCT. */
+#if QJS_DRC
+#define JS_DRC_UNIQUELY_OWNED(p) (JS_REF_COUNT(p) == 1 && !JS_GC_IN_ZCT(p))
+#else
+#define JS_DRC_UNIQUELY_OWNED(p) (JS_REF_COUNT(p) == 1)
+#endif
 
