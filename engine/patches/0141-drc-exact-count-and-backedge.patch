+       not a parked register-only value. Every caller passes an owning slot. */
+    if (JS_GC_IN_ZCT(p1))
+        return 0;
+#endif
     if (JS_REF_COUNT(p1) != 1 + stack_ref)
         return 0;
     if (p1->is_wide_char != p2->is_wide_char)
@@ -22014,10 +22058,12 @@ js_closcyc_frame(JSRuntime *rt, JSStackFrame *sf, bool guarded)
 
     for (i = 0; i < sf->var_ref_count; i++) {
         JSVarRef *vr = sf->var_refs[i];
+#if !QJS_DRC
         JSFunctionBytecode *b;
         JSVarRef **vrs;
         JSObject *o;
         int j, n, owns;
+#endif
 
