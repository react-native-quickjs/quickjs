+/*
+ * A backward branch is a loop back edge. It is the only frequent, cheap and
+ * safe point inside a register-VM activation at which the deferred-RC zero
+ * count table can be drained: every live value is in a register there, so
+ * reconciling cannot free anything reachable. Without it a call-free
+ * allocation loop (a string builder, say) parks one value per iteration and
+ * the table grows to the whole iteration count, because the register VM only
+ * polls interrupts -- the other safepoint -- before in-line calls.
+ *
+ * The record chain's `T_NEXT`/`T_BR_NEXT` pass the *total* offset from the
+ * current instruction, so a negative value is exactly a backward branch. The
+ * check folds away at every sequential call site (a positive constant) and is
+ * only live on the branch handlers.
+ */
+#if QJS_DRC
+/*
+ * Checked inline at every backward branch, so the check costs three loads and a
+ * compare and, crucially, never makes the branch handler spill its state: the
+ * rare reconcile is a *tail call* into `regvm_t_safepoint_slow`, which runs the
+ * reconcile and re-enters the chain at the branch target. A non-tail call here
+ * would force the handler to preserve ip/fr/f/ctx across it, which is exactly
+ * the per-dispatch shuffle the frameless discipline exists to avoid.
+ */
+#define REGVM_DRC_BACKEDGE(rt_, off_)                                        \
+    do { if (unlikely((off_) < 0) &&                                         \
+             unlikely((rt_)->zct_len + (rt_)->zct_nobj >                     \
+                      (rt_)->zct_limit)) {                                   \
+        return regvm_t_safepoint_slow(ip + (off_), fr, f, ctx); }            \
+    } while (0)
+#else
+#define REGVM_DRC_BACKEDGE(rt_, off_) ((void)0)
+#endif
+
