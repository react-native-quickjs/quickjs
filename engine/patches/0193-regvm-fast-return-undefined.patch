Subject: Fast exit for return undefined

What this does
  Fast exit for return undefined.

Why we need it
  `regvm_t_return_undefined` was 20% of the empty-call micro: for a frame that owns nothing it parked `undefined` in `f->ret` and tail-called `regvm_t_return_trivial` to move it, a round trip that a value carrying no reference does not need.

What it adds
  For a bare frame it writes `undefined` into the caller's destination in line (no dup/adopt to balance); the rare arena chunk pop keeps its own out-of-line helper, so the handler stays frameless.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index a2fc416..4ddcb2c 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -25576,11 +25576,31 @@ static uint8_t *REGVM_CC regvm_t_return_undefined(REGVM_ARGS)
 #endif
         return ip;
     }
-    f->ret = JS_UNDEFINED;
 #if QJS_REGVM_RECORD
-    if (likely(f->flags & REGVM_FLAG_TRIVIAL_RET))
-        __attribute__((musttail)) return regvm_t_return_trivial(REGVM_PASS);
+    /* Fast exit for the implicit `return undefined`: a frame that owns nothing
+       writes `undefined` into the caller's destination in line. The rare arena
+       chunk pop keeps its out-of-line helper. */
+    if (likely(f->flags & REGVM_FLAG_TRIVIAL_RET)) {
+        JSRegRun *c = f->caller;
+        int dst = f->ret_dst;
+        uint8_t *rip = f->ret_ip;
+        size_t top = (size_t)((uint8_t *)f - (uint8_t *)ctx->rt->regvm_frames);
+
+        ctx->rt->regvm_frames_top = top;
+        if (unlikely(top == 0 && ctx->rt->regvm_chunk->prev)) {
+            f->ret = JS_UNDEFINED;
+            __attribute__((musttail))
+                return regvm_t_return_trivial_chunk(REGVM_PASS);
+        }
+        ctx->rt->current_stack_frame = c->sf;
+        *(JSValue *)((uint8_t *)c->fr + dst) = JS_UNDEFINED;
+        ctx->rt->regvm_tail_chain = 0;
+        f = c;
+        __attribute__((musttail))
+            return regvm_t_dispatch(rip, c->fr, c, c->b->realm);
+    }
 #endif
+    f->ret = JS_UNDEFINED;
     __attribute__((musttail)) return regvm_t_return_common(REGVM_PASS);
 }
 
