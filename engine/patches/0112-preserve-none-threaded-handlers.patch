Subject: Uses Clang `preserve_none` for threaded handlers when available

What this does
  

Why we need it
  The platform ABI can make each hot handler save registers that the dispatch chain does not need preserved.

What it adds
  Applies one matching ABI to every handler declaration, definition, and indirect handler pointer; older and sanitizer builds keep their existing ABI.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -22440,6 +22440,21 @@ extern void regvm_asm_add_imm_self_branch_s(void);
 #error "QJS_REGVM_THREAD and QJS_REGVM_ASM are two designs for the same loop"
 #endif
 
+/* Clang 19+ preserve_none makes every register-VM argument register
+   caller-saved; the handlers, their declarations and the dispatch type must
+   agree. Other compilers and sanitizer builds keep the platform ABI. */
+#if defined(__has_attribute) && __has_attribute(preserve_none)
+#define REGVM_CC __attribute__((preserve_none))
+#else
+#define REGVM_CC
+#endif
+#if defined(__has_feature)
+#if __has_feature(address_sanitizer) || __has_feature(undefined_behavior_sanitizer)
+#undef REGVM_CC
+#define REGVM_CC
+#endif
+#endif
+
