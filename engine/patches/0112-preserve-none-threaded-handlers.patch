 #define REGVM_PASS  ip, fr, f, ctx
@@ -22552,8 +22567,8 @@ typedef uint8_t *(*regvm_handler)(uint8_t *ip, JSValue *fr, JSRegRun *f,
 #if QJS_REGVM_RECORD
