Subject: Backtrace from the callee's `ret_ip`

What this does
  Backtrace from the callee's `ret_ip`.

Why we need it
  Every light call stored the caller's `cap_ip` so a backtrace could name the call site.

What it adds
  Derive an outer frame's pc from its callee's `ret_ip` (one byte back); capture only where control leaves the VM.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index fe30b22..bb143ac 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -11312,6 +11312,14 @@ static int regvm_ip_pc(JSFunctionBytecode *b, const uint8_t *ip)
         return -1;
     return (int)(ip - b->regvm_code);
 }
+
+/* A callee's `ret_ip` is one instruction past its caller's call, and pc2line
+   is keyed by instruction start, so step back one byte to resolve the
+   caller's position. */
+static int regvm_ret_pc(JSFunctionBytecode *b, const uint8_t *ret_ip)
+{
+    return ret_ip ? regvm_ip_pc(b, ret_ip - 1) : -1;
+}
 #else
 #define regvm_frame_pc(rt, sf, b) (-1)
 #define regvm_ip_pc(b, ip) (-1)
@@ -24525,47 +24533,62 @@ static void regvm_light_walk(struct JSRegRun *lf, JSRegRootFn fn, void *opaque)
 }
 #endif
 
