         bt[nb].sf = sf;
         nb++;
+        callee_ret = rec ? rec->ret_ip : NULL;
         for (lf = regvm_light_head(sf->rv_light);
              lf != NULL && nb < max;
              lf = (lf->caller && lf->caller->sf == NULL) ? lf->caller : NULL) {
