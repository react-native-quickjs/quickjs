Subject: Inlines the register frame release into the return path

What this does
  Inlines the register frame release into the return path.

Why we need it
  The return path is the tail of every call and paid a call/ret pair for a function that is otherwise a short walk over about ten registers.

What it adds
  `regvm_record_release` is marked `always_inline`, so `regvm_t_return_nested` and the other release site carry the walk directly and the symbol disappears; the closure `var_ref` arm only runs when the frame actually closed a closure and is inlined with the rest into the return handler's cold tail.

Needs a bytecode version bump
  No.
--- a/quickjs.c
+++ b/quickjs.c
@@ -23343,7 +23343,8 @@ static uint8_t *REGVM_CC regvm_t_call_slow(REGVM_ARGS);
 static uint8_t *REGVM_CC regvm_t_call_method_slow(REGVM_ARGS);
 static uint8_t *REGVM_CC regvm_t_call_record(REGVM_ARGS);
 static uint8_t *REGVM_CC regvm_t_call_method_record(REGVM_ARGS);
-static void regvm_record_release(JSRuntime *rt, JSRegRun *rec);
+static __attribute__((always_inline)) inline void
+regvm_record_release(JSRuntime *rt, JSRegRun *rec);
 #endif
 
 /*
@@ -25186,7 +25187,8 @@ static int regvm_record_alloc(JSRuntime *rt, JSFunctionBytecode *b, int arg_slot
  * The last handshake slot holds the control-stack depth as an integer, so it
  * is excluded.
  */
-static void regvm_record_release(JSRuntime *rt, JSRegRun *rec)
+static __attribute__((always_inline)) inline void
+regvm_record_release(JSRuntime *rt, JSRegRun *rec)
 {
     JSStackFrame *sf = rec->sf;
     JSValue *pval;
