+        /* A counted loop's bound is a constant load at the header. Grow its
+           interval to the latch so the allocator keeps its register live across
+           the body; otherwise the hoist pass (after allocation) would compare
+           against a clobbered register. Only a constant defined and used in a
+           back edge's target block is grown. */
+        for (b = 0; b < n_blocks && is_const_push; b++) {
+            int k2;
+            if (in_depth[b] < 0)
+                continue;
+            for (k2 = 0; k2 < 2; k2++) {
+                int h = succ[b * 2 + k2];
+                uint64_t *dh, *uh;
+                if (h < 0 || h >= b || in_depth[h] < 0)
+                    continue;               /* the header is the earlier block */
+                dh = def_bits + (size_t)h * words;
+                uh = alluse_bits + (size_t)h * words;
+                for (w = 0; w < words; w++) {
+                    uint64_t bits = dh[w] & uh[w];
+                    while (bits) {
+                        int v = w * 64 + __builtin_ctzll(bits);
+                        bits &= bits - 1;
+                        if (v < n_values && is_const_push[v] &&
+                            iend[v] >= 0 && iend[v] < blk_last[b])
+                            iend[v] = blk_last[b];
+                    }
+                }
+            }
+        }
