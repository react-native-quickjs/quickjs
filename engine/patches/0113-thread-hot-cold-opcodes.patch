+static uint8_t *REGVM_CC regvm_t_put_local_s0(REGVM_ARGS)
+{
+    int s = T_REG(1);
+    set_value(ctx, &f->var_buf[0], js_dup(fr[s]));
+    T_NEXT(T_SZ_R);
+}
+
+static uint8_t *REGVM_CC regvm_t_local_uninit(REGVM_ARGS)
+{
+    int slot = T_U16(1);
+    set_value(ctx, &f->var_buf[slot], JS_UNINITIALIZED);
+    T_NEXT(T_SZ_U);
+}
+
+static uint8_t *REGVM_CC regvm_t_get_local_field_0(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    JSAtom atom = T_U32(3);
+    int site = T_U16(7);
+    JSValue recv = f->var_buf[0];
+    JSValue val;
+
+    if (site != REG_IC_NONE && regvm_own_read_hit(f->b, recv, site, &val))
+        T_SET_NEXT(d, val, 9);
+    if (site == REG_IC_NONE)
+        val = JS_GetProperty(ctx, recv, atom);
+    else
+        val = regvm_get_field_ic(ctx, f->b, recv, atom, site);
+    if (JS_IsException(val))
+        T_FAIL();
+    T_SET_NEXT(d, val, 9);
+}
+
+static uint8_t *REGVM_CC regvm_t_put_element_xfer(REGVM_ARGS)
+{
+    int o = T_REG(1);
+    int key = T_REG(3);
+    int v = T_REG(5);
+    JSValue val = fr[v];
+
+    fr[v] = JS_UNDEFINED;
+    if (JS_SetPropertyValue(ctx, fr[o], js_dup(fr[key]), val,
+                            JS_PROP_THROW_STRICT) < 0)
+        T_FAIL();
+    T_NEXT(T_SZ_RRR);
+}
+
+static uint8_t *REGVM_CC regvm_t_apply_arguments(REGVM_ARGS)
+{
+    int w = T_REG(1);
+    int d = T_REG(3);
+    int idx = T_U16(5);
+    JSValue *sp = &fr[w + 3];
+    JSObject *pa = js_args_apply_is_builtin(sp[-2]);
+    JSValue ret_val;
+
+    if (likely(pa != NULL &&
+               (f->arg_buf == (JSValue *)f->argv || f->argc <= f->b->arg_count))) {
+        if (unlikely(check_function(pa->u.cfunc.realm, sp[-3])))
+            T_FAIL();
+        ret_val = JS_Call(ctx, sp[-3], sp[-1], f->argc, vc(f->arg_buf));
+    } else {
+        ret_val = js_args_apply_reified(ctx, &f->var_buf[idx], sp - 3,
+                                        f->argc, f->argv, f->sf,
+                                        f->b->arg_count);
+    }
+    if (JS_IsException(ret_val))
+        T_FAIL();
+    T_SET_NEXT(d, ret_val, 7);
+}
+
+static uint8_t *REGVM_CC regvm_t_binary_cpool(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    int sub = T_U8(3);
+    int a = T_REG(4);
+    int kind = T_U8(6);
+    uint32_t idx = T_U32(7);
+    JSValue out;
+
+    if (kind == REG_CONST_CPOOL) {
+        if (!regvm_num_fast(sub, fr[a], f->b->cpool[idx], &out) &&
+            js_regvm_binary(ctx, sub, fr[a], f->b->cpool[idx], &out))
+            T_FAIL();
+    } else {
+        JSValue cst = JS_AtomToValue(ctx, idx);
+        if (JS_IsException(cst))
+            T_FAIL();
+        if (!regvm_num_fast(sub, fr[a], cst, &out) &&
+            js_regvm_binary(ctx, sub, fr[a], cst, &out)) {
+            JS_FreeValue(ctx, cst);
+            T_FAIL();
+        }
+        JS_FreeValue(ctx, cst);
+    }
+    T_SET_NEXT(d, out, 11);
+}
+
+static uint8_t *REGVM_CC regvm_t_construct(REGVM_ARGS)
+{
+    int d = T_REG(1);
+    int c = T_REG(3);
+    int nt = T_REG(5);
+    int ab = T_REG(7);
+    int na = T_U8(9);
+    JSValue *argv = &fr[ab];
+    JSValue ret_val = JS_CallConstructorInternal(ctx, fr[c], fr[nt],
+                                                 na, vc(argv), 0);
+    if (JS_IsException(ret_val))
+        T_FAIL();
+    T_SET_NEXT(d, ret_val, 10);
+}
 
