@@ -13814,7 +13843,9 @@
             pr->u.value = v;
         }
     }
-    js_free(ctx, p->u.array.u.values);
+    if (!p->values_inline)
+        js_free(ctx, p->u.array.u.values);
+    p->values_inline = 0;
     p->u.array.count = 0;
     p->u.array.hole_count = 0;
     p->u.array.u.values = NULL; /* fail safe */
@@ -14061,9 +14092,18 @@
         return -1;
