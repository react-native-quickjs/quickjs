@@ -8704,12 +8719,14 @@
             inline_cap = req_cap;
         }
         p = js_malloc(ctx, sizeof(JSObject) +
-                           inline_cap * sizeof(JSProperty));
+                           inline_cap * sizeof(JSProperty) +
+                           extra_values * sizeof(JSValue));
         if (unlikely(!p))
