         p->prop_inline_cap = inline_cap;
     }
     p->class_id = class_id;
+    p->values_inline = 0;
     p->extensible = true;
     p->free_mark = 0;
     p->is_exotic = 0;
@@ -8754,6 +8771,12 @@
             p->u.array.count = 0;
