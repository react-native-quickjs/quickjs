Subject: Store an adopted result as one 16-byte word

What this does
  `qjs_aot_set_reg_p` writes the adopted value with a single 16-byte store (under deferred
  counting on x86-64 with SSE2) instead of two 8-byte stores.

Why we need it
  A compiled caller copies a result slot with one 16-byte load right after the call. That
  load cannot be forwarded from two 8-byte stores and waits for them to retire, which cost
  about 2 ns per call in the generic body.

--- a/quickjs.c
+++ b/quickjs.c
@@ -62443,11 +62443,28 @@
 }
 #endif
 
+#if QJS_DRC && defined(__SSE2__) && !defined(JS_NAN_BOXING)
+#include <emmintrin.h>
+static inline void JSValue_store16(JSValue *d, JSValue v)
+{
+    __m128i x;
+    memcpy(&x, &v, sizeof x);
+    _mm_storeu_si128((__m128i *)d, x);
+}
+#else
+static inline void JSValue_store16(JSValue *d, JSValue v)
+{
+    *d = v;
+}
+#endif
+
 __attribute__((always_inline)) void qjs_aot_set_reg_p(JSContext *ctx, JSValue *fr, int off, JSValue v)
 {
     JSValue *slot = (JSValue *)((uint8_t *)fr + off);
 #if QJS_DRC
-    *slot = v;
+    /* One 16-byte store: the next copy of this slot loads all 16 bytes at once,
+       which two 8-byte stores cannot forward to. */
+    JSValue_store16(slot, v);
     REG_ADOPT(ctx->rt, v);
 #else
     {
