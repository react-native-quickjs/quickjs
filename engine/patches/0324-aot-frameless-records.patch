+
+/* Whether `a` lies in the C stack the runtime is running on (the stack top was
+   recorded at the runtime's creation; the arena and the heap are elsewhere). */
+static inline int regvm_on_c_stack(JSRuntime *rt, uintptr_t a)
+{
+    return a < rt->stack_top && rt->stack_top - a < ((uintptr_t)1 << 28);
+}
+
+#if QJS_AOT || QJS_AOT_GEN || QJS_AOT_PROFILE
+/* Put the activation records of frameless functions (JSAotFlRec) into a backtrace.
+   Light frames, entry frames and the records all sit on the C stack, so their
+   addresses order them; a frame in the arena takes the address of the next outer
+   frame on the C stack, which is its run's entry frame. The order assumes one C
+   stack, growing down, per runtime: a runtime is used on one thread at a time. */
+static int regvm_merge_fl_records(JSRuntime *rt, JSRegBtFrame *bt, uintptr_t *anc,
+                                  int nb, int max)
+{
+    JSRegBtFrame tmp[130];
+    JSAotFlRec *r = rt->aot_fl_top;
+    uintptr_t next = UINTPTR_MAX;
+    int i, n = 0;
+
+    for (i = nb - 1; i >= 0; i--) {
+        if (anc[i])
+            next = anc[i];
+        else
+            anc[i] = next;
+    }
+    i = 0;
+    while (n < max && n < 128) {
+        if (r != NULL && (i >= nb || (uintptr_t)r < anc[i])) {
+            tmp[n].func = JS_MKPTR(JS_TAG_OBJECT, r->func);
+            tmp[n].cur_pc = NULL;
+            tmp[n].rpc = (int)r->pc;
+            tmp[n].sf = NULL;
+            n++;
+            assert(regvm_on_c_stack(rt, (uintptr_t)r));
+            r = r->prev;
+        } else if (i < nb) {
+            tmp[n++] = bt[i++];
+        } else {
+            break;
+        }
+    }
+    memcpy(bt, tmp, sizeof(*bt) * (size_t)n);
+    return n;
+}
+#endif
