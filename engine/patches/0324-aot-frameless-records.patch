+/* The argument windows frameless functions publish through their activation records. */
+static void regvm_fl_roots(JSRuntime *rt, JSRegRootFn fn, void *opaque)
+{
+    JSAotFlRec *r;
+
+    for (r = rt->aot_fl_top; r != NULL; r = r->prev)
+        if (r->nroots)
