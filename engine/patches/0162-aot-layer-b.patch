+/* --- AOT typed-region helpers ----------------------------------------------
+ *
+ * A value in flight inside a region is a double plus an is-int flag, boxed
+ * at every exit and deopt by the one box helper so the tags match the
+ * interpreter's. `fitsi`: the double is integral, in int32 range, and not -0.
+ */
+
+int qjs_aot_fitsi(double d)
+{
+    return d >= -2147483648.0 && d <= 2147483647.0 &&
+           (double)(int32_t)d == d && !(d == 0.0 && signbit(d));
+}
+
+JSValue qjs_aot_box_num(double d, int isint)
+{
+    if (isint)
+        return JS_MKVAL(JS_TAG_INT, (int32_t)d);
+    return js_float64(d);
+}
+
+/* Unbox an int or a float into (double, isint); 0 for anything else. */
+int qjs_aot_to_num(JSValue v, double *out, int *isint)
+{
+    int tag = JS_VALUE_GET_TAG(v);
+
+    if (tag == JS_TAG_INT) {
+        *out = (double)JS_VALUE_GET_INT(v);
+        *isint = 1;
+        return 1;
+    }
+    if (tag == JS_TAG_FLOAT64) {
+        *out = JS_VALUE_GET_FLOAT64(v);
+        *isint = 0;
+        return 1;
+    }
+    return 0;
+}
+
+/* The element storage of a plain fast array; 0 for any other receiver. */
+int qjs_aot_dense(JSValue v, JSValue **data, uint32_t *len)
+{
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(v);
+    if (p->class_id != JS_CLASS_ARRAY || !p->fast_array)
+        return 0;
+    *data = p->u.array.u.values;
+    *len = p->u.array.count;
+    return 1;
+}
+
+/* Read a dense element as an unboxed number. A hole, a lazy marker or a
+   non-numeric value returns 0 (the caller deopts). */
+int qjs_aot_elem_num(JSValue *data, uint32_t i, double *out, int *isint)
+{
+    JSValue v = data[i];
+
+    if (js_array_slot_is_hole(v) || js_lazy_marker_is(v))
+        return 0;
+    return qjs_aot_to_num(v, out, isint);
+}
+
+/* Hoisted field guard: check `recv`'s shape against the PIC entry at `site`
+   as an own data property and return the slot offset. The receiver is
+   loop-invariant and the region call-free, so one check covers the loop. */
+int qjs_aot_field_guard(const void *pic, JSValue recv, int site, int *slot_off)
+{
+    JSObject *p;
+    JSRegPIC *e;
+
+    if (JS_VALUE_GET_TAG(recv) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(recv);
+    e = &((JSRegPIC *)pic)[site];
+    if (e->shape != p->shape || e->kind != REG_PIC_OWN)
+        return 0;
+    *slot_off = (int)e->slot_off;
+    return 1;
+}
+
+/* Borrowed read of an own data property at a slot offset (registers borrow). */
+JSValue qjs_aot_field_read(JSValue recv, int slot_off)
+{
+    JSObject *p = JS_VALUE_GET_OBJ(recv);
+    return *(JSValue *)((char *)p->prop + slot_off);
+}
+
+/* array `length` as an unboxed int for a plain fast array; 0 otherwise */
+int qjs_aot_get_length_num(JSValue v, double *out, int *isint)
+{
+    JSObject *p;
+
+    if (JS_VALUE_GET_TAG(v) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(v);
+    if (p->class_id != JS_CLASS_ARRAY || !p->fast_array)
+        return 0;
+    *out = (double)p->u.array.count;
+    *isint = 1;
+    return 1;
+}
+
+/* A captured variable's cell; loop-invariant once guarded, since the region
+   is call-free. */
+JSValue *qjs_aot_var_ref_ptr(JSRegRun *f, int slot)
+{
+    return f->var_refs[slot]->pvalue;
+}
+
 uint8_t *qjs_aot_code(JSRegRun *f)
 {
     return f->b->regvm_code;
