+static void qjs_alloc_stats_dump(void)
+{
+    int i;
+    printf("alloc-stats: obj=%llu inline=%llu propmalloc=%llu shape=%llu "
+           "gc_runs=%llu gc_walked=%llu\n",
+           (unsigned long long)qjs_st_obj_alloc,
+           (unsigned long long)qjs_st_obj_inline,
+           (unsigned long long)qjs_st_obj_propmalloc,
+           (unsigned long long)qjs_st_shape_alloc,
+           (unsigned long long)qjs_st_gc_runs,
+           (unsigned long long)qjs_st_gc_walked);
+    printf("alloc-stats grow: move_out_of_inline=%llu realloc=%llu\n",
+           (unsigned long long)qjs_st_grow_move,
+           (unsigned long long)qjs_st_grow_realloc);
+    printf("alloc-stats forin: start=%llu next=%llu hasprop=%llu\n",
+           (unsigned long long)qjs_st_forin_start,
+           (unsigned long long)qjs_st_forin_next,
+           (unsigned long long)qjs_st_forin_hasprop);
+    printf("alloc-stats grow class(move):");
+    for (i = 0; i < 32; i++)
+        if (qjs_st_grow_move_class[i])
+            printf(" %d:%llu", i, (unsigned long long)qjs_st_grow_move_class[i]);
+    printf("\n");
+    printf("alloc-stats prop_size(malloc path):");
+    for (i = 0; i < 64; i++)
+        if (qjs_st_prop_size[i])
+            printf(" %d:%llu", i, (unsigned long long)qjs_st_prop_size[i]);
+    printf("\nalloc-stats class(alloc/inline):");
+    for (i = 0; i < 32; i++)
+        if (qjs_st_obj_class[i])
+            printf(" %d:%llu/%llu", i,
+                   (unsigned long long)qjs_st_obj_class[i],
+                   (unsigned long long)qjs_st_obj_class_inline[i]);
+    printf("\nalloc-stats JS_CLASS_OBJECT prop_size(all/inline):");
+    for (i = 0; i < 64; i++)
+        if (qjs_st_obj_ps_obj[i])
+            printf(" %d:%llu/%llu", i,
+                   (unsigned long long)qjs_st_obj_ps_obj[i],
+                   (unsigned long long)qjs_st_obj_ps_obj_inl[i]);
+    printf("\n");
+}
+#endif
