+/* O3: JSON.parse shape-reuse cache helpers.  The cache records, for each
+   object nesting depth, the key sequence and the shape chain produced by the
+   previous object at that depth, so the next object can adopt the shapes
+   directly instead of hashing every add-transition. */
+
+static void json_shape_cache_free(JSContext *ctx, JSParseState *s)
+{
+    int i, k;
+    if (!s->json_shapes)
+        return;
+    for (i = 0; i < s->json_shapes_len; i++) {
+        JSONShapeCache *c = &s->json_shapes[i];
+        if (c->shapes) {
+            for (k = 0; k <= c->n; k++)
+                js_free_shape(ctx->rt, c->shapes[k]);
+            js_free(ctx, c->shapes);
+        }
+        js_free(ctx, c->atoms);
+    }
+    js_free(ctx, s->json_shapes);
+    s->json_shapes = NULL;
+    s->json_shapes_len = 0;
+    s->json_shapes_cap = 0;
+}
+
+static JSONShapeCache *json_shape_cache_at(JSContext *ctx, JSParseState *s, int depth)
+{
+    JSONShapeCache *c;
+    if (depth >= s->json_shapes_cap) {
+        int newcap = s->json_shapes_cap ? s->json_shapes_cap * 2 : 8;
+        JSONShapeCache *na;
+        if (newcap <= depth)
+            newcap = depth + 1;
+        na = js_realloc(ctx, s->json_shapes, sizeof(*na) * newcap);
+        if (!na)
+            return NULL;
+        s->json_shapes = na;
+        memset(&s->json_shapes[s->json_shapes_cap], 0,
+               sizeof(*na) * (newcap - s->json_shapes_cap));
+        s->json_shapes_cap = newcap;
+    }
+    if (!s->json_shapes)
+        return NULL;
+    if (depth >= s->json_shapes_len)
+        s->json_shapes_len = depth + 1;
+    c = &s->json_shapes[depth];
+    return c;
+}
+
+/* ensure atoms[0..n-1] and shapes[0..n] are allocated */
+static int json_shape_cache_reserve(JSContext *ctx, JSONShapeCache *c, int n)
+{
+    int newcap;
+    JSAtom *na;
+    JSShape **ns;
+    if (n <= c->cap)
+        return 0;
+    newcap = c->cap ? c->cap * 2 : 8;
+    if (newcap < n)
+        newcap = n;
+    na = js_realloc(ctx, c->atoms, sizeof(JSAtom) * newcap);
+    if (!na)
+        return -1;
+    c->atoms = na;
+    ns = js_realloc(ctx, c->shapes, sizeof(JSShape *) * (newcap + 1));
+    if (!ns)
+        return -1;
+    c->shapes = ns;
+    c->cap = newcap;
+    return 0;
+}
+
+/* adopt an already-built shape (same effect as add_property's "matching shape
+   found" branch, without the hash lookup).  The value is stored before the
+   shape is swapped in so the GC never sees an uninitialised slot. */
+static int json_obj_adopt_shape(JSContext *ctx, JSObject *p, JSShape *new_sh,
+                                JSValue v)
+{
+    JSShape *sh = p->shape;
+    if (new_sh->prop_size != sh->prop_size) {
+        JSProperty *new_prop;
+        new_prop = js_prop_grow(ctx, p, sizeof(p->prop[0]) * new_sh->prop_size);
+        if (!new_prop)
+            return -1;
+        p->prop = new_prop;
+    }
+    p->prop[new_sh->prop_count - 1].u.value = v;
+    p->shape = js_dup_shape(new_sh);
+    js_free_shape(ctx->rt, sh);
+    return 0;
+}
