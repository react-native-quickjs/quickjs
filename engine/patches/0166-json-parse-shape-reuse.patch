+/* O3: expected-transition cache for JSON.parse. JSON objects almost always
+   repeat the same key sequence, so the shape built for the previous object at
+   the same nesting depth is reused instead of hashing every add-transition. */
+typedef struct JSONShapeCache {
+    int n;              /* number of valid transitions (keys) */
+    int cap;
+    JSAtom *atoms;      /* atoms[k] = the k-th key */
+    JSShape **shapes;   /* shapes[k] = shape after k keys; shapes[n] is valid */
+} JSONShapeCache;
