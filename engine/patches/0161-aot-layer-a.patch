+        if (likely(e->shape == p->shape) && e->kind == REG_PIC_OWN_W) {
+            JSValue *slot = (JSValue *)((char *)p->prop + e->slot_off);
+            JSValue old = *slot;
+
+            *slot = js_dup(v);
+            JS_FreeValue(ctx, old);
+            return 1;
+        }
+    }
+    return 0;
+}
