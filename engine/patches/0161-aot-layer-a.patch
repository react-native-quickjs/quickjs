+/*
+ * Decode one instruction's operands for the AOT template registry. The widths
+ * come from the same `regvm_fmt_size`/`regvm_rop_narrow` pair the interpreter
+ * uses, so a template reads exactly the operand the handler would.
+ */
+int js_aot_gen_decode_insn(const uint8_t *code, int len, int off, JSAotGenInsn *out)
+{
+    int op, sz, narrow;
+    const char *fmt;
+    const uint8_t *p;
+
+    if (off < 0 || off >= len)
+        return -1;
+    op = code[off];
+    if (op <= 0 || op >= ROP_COUNT)
+        return -1;
+    fmt = regvm_rop_fmt[op];
+    if (!fmt)
+        return -1;
+    sz = regvm_fmt_size(fmt, 1 /* wide register operands */, (uint16_t)op);
+    if (sz < 0 || off + 1 + sz > len)
+        return -1;
+    narrow = regvm_rop_narrow((uint16_t)op);
+
+    out->op = op;
+    out->size = 1 + sz;
+    out->nargs = 0;
+    p = code + off + 1;
+    for (; *fmt; fmt++) {
+        int64_t v;
+        int aoff = (int)(p - code);
+        switch (*fmt) {
+        case 'r':
+            if (narrow) { v = *p; p += 1; }
+            else { v = regvm_ld_u16(p); p += 2; }
+            break;
+        case 'i': v = (int8_t)*p; p += 1; break;
+        case 'I': v = (int32_t)regvm_ld_u32(p); p += 4; break;
+        case 'b': v = *p; p += 1; break;
+        case 'u': v = regvm_ld_u16(p); p += 2; break;
+        case 's': v = regvm_ld_u16(p); p += 2; break;
+        case 'c': v = regvm_ld_u32(p); p += 4; break;
+        case 'a': v = regvm_ld_u32(p); p += 4; break;
+        case 't':
+            if (narrow) { v = (int8_t)*p; p += 1; }
+            else { v = (int32_t)regvm_ld_u32(p); p += 4; }
+            break;
+        default:
+            return -1;
+        }
+        if (out->nargs < 8) {
+            out->arg[out->nargs].kind = *fmt;
+            out->arg[out->nargs].val = v;
+            out->arg[out->nargs].off = aoff;
+        }
+        out->nargs++;
+    }
+    return 0;
+}
 #endif /* QJS_AOT_GEN */
 
 
diff --git a/quickjs-aot-gen.h b/quickjs-aot-gen.h
index 861e541..58fe7c5 100644
--- a/quickjs-aot-gen.h
+++ b/quickjs-aot-gen.h
@@ -65,4 +65,26 @@ void js_aot_gen_free(JSRuntime *rt, JSAotGenFunc *arr);
  */
 int js_aot_gen_insn_size(const uint8_t *code, int len, int off, int *p_op);
 
+/*
+ * One decoded register instruction, for the P4 template registry. `arg[i].kind`
+ * is the format character ('r','i','I','b','u','s','c','a','t'), `val` the
+ * raw operand and `off` the byte offset of the operand inside the instruction
+ * (so a runtime-remapped operand such as an atom can be re-read from the live
+ * code). A register operand's `val` is the byte offset into the register
+ * file (so `*(JSValue *)((uint8_t *)fr + val)`); a branch target's `val` is the
+ * signed offset from the END of the instruction.
+ */
+typedef struct JSAotGenInsn {
+    int op;                 /* the ROP_* opcode */
+    int size;               /* total size in bytes, opcode included */
+    int nargs;              /* operands (<= 8 in the current ISA) */
+    struct { char kind; int64_t val; int off; } arg[8];
+} JSAotGenInsn;
+
+/*
+ * Decode one instruction into *out. Returns 0 on success, -1 past the end or
+ * on a malformed program (the same conditions js_aot_gen_insn_size refuses).
+ */
+int js_aot_gen_decode_insn(const uint8_t *code, int len, int off, JSAotGenInsn *out);
+
 #endif /* QUICKJS_AOT_GEN_H */
