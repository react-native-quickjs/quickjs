@@ -29056,8 +29134,38 @@
 T_DEF_CMP_BRANCH_INT(branch_ngt_s,  REG_BIN_GT | REG_CMP_INVERT, _a <= _b)
 T_DEF_CMP_BRANCH_INT(branch_gte_s,  REG_BIN_GTE, _a >= _b)
