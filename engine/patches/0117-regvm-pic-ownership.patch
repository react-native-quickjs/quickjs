+#if QJS_REGVM
+/* ---- register-VM property cache ownership (A2) ------------------------- */
+
+/* The register VM's per-function property cache: one entry per site, indexed
+   by the dense site operand A1 assigns. The cached shapes are COUNTED
+   references. js_shape_prepare_update mutates a hashed shape in place while
+   its refcount is 1, so an uncounted cache pointer could observe a layout
+   change underneath it and read a slot that has moved. Holding a reference
+   forces copy-on-write and keeps the cached layout immutable. */
+struct JSRegPIC {
+    JSShape  *shape;         /* receiver shape; a counted reference */
+    JSShape  *holder_shape;  /* NULL for own-slot entries; counted reference */
+    uint32_t  slot;          /* property index in the receiver or holder */
+    uint16_t  misses;        /* stop refilling at a limit: megamorphic */
+    uint16_t  kind;          /* REG_PIC_EMPTY / OWN / PROTO */
+};
+
+#define REG_PIC_EMPTY 0
+#define REG_PIC_OWN   1
+#define REG_PIC_PROTO 2
+
+/* Release the shape references held by one entry and clear it. Used by the
+   finalizer and by a refill, which must drop the entry it replaces before
+   storing the new shapes. */
+static void regvm_pic_entry_reset(JSRuntime *rt, JSRegPIC *e)
+{
+    if (e->shape)
+        js_free_shape(rt, e->shape);
+    if (e->holder_shape)
+        js_free_shape(rt, e->holder_shape);
+    e->shape = NULL;
+    e->holder_shape = NULL;
+    e->slot = 0;
+    e->misses = 0;
+    e->kind = REG_PIC_EMPTY;
+}
+
+/* Free the whole register PIC of a function bytecode (finalizer path; RT-only).
+   Mirrors js_free_ic_table and is called from the same place. */
+static void js_free_regvm_pic(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    uint32_t i;
+    if (!b->regvm_pic)
+        return;
+    for (i = 0; i < b->regvm_pic_count; i++)
+        regvm_pic_entry_reset(rt, &b->regvm_pic[i]);
+    js_free_rt(rt, b->regvm_pic);
+    b->regvm_pic = NULL;
+}
+
+/* Lazy allocation of the register PIC, mirroring ic_table_ensure: allocated on
+   the first fill, so a function that never caches pays nothing -- 97% of the
+   functions in an RN bundle never fill an IC. Allocation failure is not an
+   error; the site simply does not cache. The bytecode is force-traced BEFORE
+   the caller stores a shape, because fnbc_is_acyclic() must not let an
+   untraced bytecode stop marking references it now holds. */
+static JSRegPIC *regvm_pic_ensure(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSRegPIC *t = b->regvm_pic;
+    if (likely(t != NULL))
+        return t;
+    if (b->regvm_pic_count == 0)
+        return NULL;
+    t = js_mallocz_rt(rt, sizeof(*t) * (size_t)b->regvm_pic_count);
+    b->regvm_pic = t;   /* NULL on OOM: retried on the next fill, never throws */
+    if (t)
+        js_fnbc_gc_force_trace(rt, b); /* before the caller stores a JSShape */
+    return t;
+}
+#endif /* QJS_REGVM */
