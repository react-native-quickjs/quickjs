+#if QJS_REGVM
+/* ---- register-VM property cache ownership ------------------------------ */
+
+/* The register VM's per-function property cache, one entry per dense site.
+   The cached shapes are counted references: js_shape_prepare_update mutates a
+   hashed shape in place at refcount 1, so holding a reference forces
+   copy-on-write and keeps the cached layout immutable. */
+struct JSRegPIC {
+    JSShape  *shape;         /* receiver shape; a counted reference */
+    JSShape  *holder_shape;  /* NULL for own-slot entries; counted reference */
+    uint32_t  slot;          /* property index in the receiver or holder */
+    uint16_t  misses;        /* stop refilling at a limit: megamorphic */
+    uint16_t  kind;          /* REG_PIC_EMPTY / OWN / PROTO */
+};
+
+#define REG_PIC_EMPTY 0
+#define REG_PIC_OWN   1
+#define REG_PIC_PROTO 2
+
+/* Release one entry's shape references and clear it. Also used by a refill
+   before storing the new shapes. */
+static void regvm_pic_entry_reset(JSRuntime *rt, JSRegPIC *e)
+{
+    if (e->shape)
+        js_free_shape(rt, e->shape);
+    if (e->holder_shape)
+        js_free_shape(rt, e->holder_shape);
+    e->shape = NULL;
+    e->holder_shape = NULL;
+    e->slot = 0;
+    e->misses = 0;
+    e->kind = REG_PIC_EMPTY;
+}
+
+/* Free the whole register PIC of a function bytecode (finalizer path; RT-only).
+   Mirrors js_free_ic_table and is called from the same place. */
+static void js_free_regvm_pic(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    uint32_t i;
+    if (!b->regvm_pic)
+        return;
+    for (i = 0; i < b->regvm_pic_count; i++)
+        regvm_pic_entry_reset(rt, &b->regvm_pic[i]);
+    js_free_rt(rt, b->regvm_pic);
+    b->regvm_pic = NULL;
+}
+
+/* Allocate the register PIC on first fill, as ic_table_ensure does.
+   Allocation failure just leaves the site uncached. The bytecode is
+   force-traced before the caller stores a shape, so fnbc_is_acyclic() cannot
+   stop marking references it holds. */
+static JSRegPIC *regvm_pic_ensure(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    JSRegPIC *t = b->regvm_pic;
+    if (likely(t != NULL))
+        return t;
+    if (b->regvm_pic_count == 0)
+        return NULL;
+    t = js_mallocz_rt(rt, sizeof(*t) * (size_t)b->regvm_pic_count);
+    b->regvm_pic = t;   /* NULL on OOM: retried on the next fill, never throws */
+    if (t)
+        js_fnbc_gc_force_trace(rt, b); /* before the caller stores a JSShape */
+    return t;
+}
+#endif /* QJS_REGVM */
+
 #if JS_ENABLE_IC
