-        if (likely(f->flags & REGVM_FLAG_TRIVIAL_RET)) {
+        if (likely((uint16_t)(hp >> 32) & REGVM_FLAG_TRIVIAL_RET)) {
             JSRegRun *c = f->caller;
-            int dst = f->ret_dst;
+            int dst = (uint16_t)hp;
             uint8_t *rip = f->ret_ip;
             size_t top = (size_t)((uint8_t *)f
