@@ -26369,9 +26376,16 @@ regvm_light_enter(JSContext *ctx, JSObject *co, JSFunctionBytecode *cb,
     } else {
         nf->fr = (JSValue *)((uint8_t *)nf + REGVM_LIGHT_PREFIX_BYTES);
     }
-    nf->flags = REGVM_FLAG_LIGHT;
-    if (vc == 0)
-        nf->flags |= REGVM_FLAG_TRIVIAL_RET;
+    /* The four narrow header fields go out as one 64-bit store; `nctl` is 0. */
+    {
+        uint16_t hflags = REGVM_FLAG_LIGHT;
