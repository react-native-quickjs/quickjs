Subject: Pack the light header

What this does
  Pack the light header.

Why we need it
  The four narrow header fields were four stores and the return read them back separately.

What it adds
  Compose `ret_dst.

Needs a bytecode version bump
  No.
diff --git a/quickjs.c b/quickjs.c
index 4da1df3..7a13bf3 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -24491,6 +24491,14 @@ typedef struct JSRegRun {
     uint8_t *resume_marker;
 } JSRegRun;
 
+/* `hdr_pack` is composed by explicit shifts, which assumes the four narrow
+   fields sit in order at these offsets. */
+_Static_assert(offsetof(JSRegRun, ret_dst) == offsetof(JSRegRun, hdr_pack) &&
+               offsetof(JSRegRun, argc) == offsetof(JSRegRun, hdr_pack) + 2 &&
+               offsetof(JSRegRun, flags) == offsetof(JSRegRun, hdr_pack) + 4 &&
+               offsetof(JSRegRun, nctl) == offsetof(JSRegRun, hdr_pack) + 6,
+               "hdr_pack field order");
+
 #if QJS_REGVM && (QJS_DRC || QJS_DRC_VALIDATE)
