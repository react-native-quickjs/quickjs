# Out-of-source CMake build directories (build-rel, build-napi, build-intl).
# Directories only -- the trailing slash is load-bearing, or the pattern also
# swallows build-*.sh and build-*.mjs scripts that are meant to be tracked.
build-*/
build-*.log

# Debug symbol bundles
*.dSYM/
